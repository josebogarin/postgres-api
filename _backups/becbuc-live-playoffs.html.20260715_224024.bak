<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>BECBUC Playoffs v50</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{background:#06080f;color:#fff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:15px;min-height:100vh;overscroll-behavior:none}
button{cursor:pointer;border:none;outline:none;background:none;color:inherit;font-family:inherit;font-size:inherit}

/* ── SCREENS ─────────────────────────────────────────────────── */
.screen{display:none;flex-direction:column;min-height:100vh}
.screen.active{display:flex}

/* ── LOADING ──────────────────────────────────────────────────── */
#scr-loading{align-items:center;justify-content:center;gap:16px;background:#06080f}
.spin{width:36px;height:36px;border:3px solid #1a1f35;border-top-color:#22c55e;border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.load-msg{color:#9ca3af;font-size:14px}

/* ── TOP BAR ──────────────────────────────────────────────────── */
.topbar{background:linear-gradient(180deg,#0d1120 0%,#06080f 100%);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;border-bottom:1px solid #0f1225}
.tb-brand{font-size:16px;font-weight:700;letter-spacing:.5px}
.tb-brand span{color:#22c55e;font-size:13px;font-weight:500}
.tb-right{display:flex;align-items:center;gap:10px}
.tb-live{display:flex;align-items:center;gap:5px;font-size:12px;color:#ef4444;font-weight:600;background:rgba(239,68,68,.1);padding:4px 10px;border-radius:20px}
.live-dot{width:6px;height:6px;border-radius:50%;background:#ef4444;animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.2}}
.tb-sync{font-size:20px;color:#8b9bb4;padding:4px 6px;border-radius:8px}
.tb-sync:active{background:#1a1f35}

/* ── USER PILL (in topbar) ────────────────────────────────────── */
.user-pill{display:flex;align-items:center;gap:7px;background:#0f1530;border:1px solid #1e2d5a;border-radius:20px;padding:5px 10px 5px 6px;cursor:pointer;max-width:140px}
.user-avatar{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#1e3a8a,#3b82f6);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#93c5fd;flex-shrink:0}
.user-name{font-size:12px;font-weight:600;color:#93c5fd;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-chevron{font-size:10px;color:#4466aa;flex-shrink:0}

/* ── SCORE HEADER (live match) ────────────────────────────────── */
.score-hdr{background:linear-gradient(180deg,#0d1a0d 0%,#06080f 100%);padding:16px;border-bottom:1px solid #112211}
.score-phase{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.8px;text-align:center;margin-bottom:12px}
.score-teams{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center}
.score-team{display:flex;flex-direction:column;align-items:center;gap:4px}
.score-flag{font-size:34px;line-height:1}
.score-name{font-size:13px;font-weight:600;text-align:center}
.score-center{text-align:center}
.score-num{font-size:46px;font-weight:700;letter-spacing:6px;line-height:1;color:#fff}
.score-period{display:inline-block;margin-top:6px;font-size:12px;font-weight:600;padding:3px 12px;border-radius:20px}
.sp-live{background:rgba(34,197,94,.15);color:#22c55e}
.sp-done{background:rgba(255,255,255,.06);color:#9ca3af}
.pen-row{margin-top:10px;display:flex;justify-content:center;align-items:center;gap:24px}
.pen-score{font-size:20px;font-weight:700;color:#fbbf24}
.pen-label{font-size:10px;color:#9ca3af;text-transform:uppercase;letter-spacing:.5px;margin-top:2px;text-align:center}

/* ── MAIN TABS (only bottom nav, no top tabs) ──────────────────── */
.tab-pane{display:none;flex:1;padding-bottom:72px}
.tab-pane.active{display:block}

/* ── PHASE PILLS ──────────────────────────────────────────────── */
.phase-pills{display:flex;gap:8px;padding:12px 16px;overflow-x:auto;border-bottom:1px solid #0f1225}
.phase-pills::-webkit-scrollbar{display:none}
.phase-pill{padding:6px 16px;border-radius:20px;font-size:13px;font-weight:500;white-space:nowrap;background:#0f1225;color:#8b9bb4;border:1px solid #1a1f35;transition:all .15s;flex-shrink:0}
.phase-pill.active{background:#1e3a8a;color:#93c5fd;border-color:#2d55cc}
.phase-pill.has-live{border-color:#ef4444;color:#ef4444}
.phase-pill.has-live.active{background:rgba(239,68,68,.15);border-color:#ef4444}
.phase-pts-bar{padding:8px 16px;display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid #0a0c14}
.pts-chip{font-size:11px;color:#22c55e;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.15);padding:3px 8px;border-radius:6px}

/* ── MATCH LIST ───────────────────────────────────────────────── */
.match-list{padding:10px 14px}
.match-card{background:#0f1225;border-radius:14px;margin-bottom:10px;overflow:visible;border:1px solid #1a1f35;position:relative;cursor:pointer;transition:border-color .15s}
.match-card.live{border-color:#ef4444;box-shadow:0 0 0 1px rgba(239,68,68,.15)}
.match-card.done{border-color:#1a2f1a}
.match-card:active{opacity:.85}
.match-card-num{position:absolute;top:8px;left:12px;font-size:10px;color:#2a2f45}
.match-card-live-badge{position:absolute;top:8px;right:10px;font-size:10px;color:#ef4444;font-weight:700;display:flex;align-items:center;gap:4px}
.match-team-row{display:flex;align-items:center;gap:10px;padding:11px 14px;position:relative}
.match-team-row:first-child{padding-bottom:5px}
.match-team-row:last-child{padding-top:5px;border-top:1px solid #0f1225}
.mtr-flag{font-size:22px;width:28px;text-align:center;flex-shrink:0}
.mtr-name{flex:1;font-size:14px;font-weight:500}
.mtr-score{font-size:19px;font-weight:700;min-width:22px;text-align:right}
.mtr-score.winner{color:#22c55e}
.mtr-score.loser{color:#2a2f45}
.match-pen-row{padding:4px 14px 9px;font-size:11px;color:#fbbf24;text-align:center;display:flex;align-items:center;justify-content:center;gap:6px}
.match-tbd{padding:18px 14px;font-size:13px;color:#2a2f45;text-align:center}
.match-py-badge{position:absolute;bottom:9px;right:12px;font-size:10px;color:#22c55e;font-weight:600}

/* ── PRED BADGE on bracket card ───────────────────────────────── */
.pred-badge{position:absolute;top:50%;right:14px;transform:translateY(-50%);display:flex;flex-direction:column;gap:3px;align-items:flex-end}
.pb-item{font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;white-space:nowrap}
.pb-hit{background:rgba(34,197,94,.15);color:#22c55e;border:1px solid rgba(34,197,94,.3)}
.pb-miss{background:rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25)}
.pb-pend{background:rgba(255,255,255,.05);color:#8b9bb4;border:1px solid #1a1f35}

/* ── MI PRONO TAB ────────────────────────────────────────────── */
.mpr-header{padding:10px 14px;border-bottom:1px solid #0f1225;display:flex;align-items:center;justify-content:space-between}
.mpr-match-info{display:flex;flex-direction:column;gap:3px}
.mpr-status{font-size:11px;font-weight:700;color:#22c55e}
.mpr-total-badge{text-align:right}
.mpr-total-val{font-size:28px;font-weight:800}
.mpr-total-max{display:block;font-size:10px;color:#374151}
.mpr-cols-hdr{display:flex;padding:4px 14px;background:#060810;border-bottom:1px solid #0a0c14;align-items:center;gap:4px}
.mpr-row{display:flex;align-items:center;padding:9px 12px;border-bottom:1px solid #0a0c14;gap:8px;transition:background .15s}
.mpr-row.mpr-hit{background:rgba(34,197,94,.05)}
.mpr-row.mpr-miss{background:rgba(239,68,68,.04)}
.mpr-ico-lbl{width:140px;display:flex;align-items:center;gap:5px;flex-shrink:0}
.mpr-ico{font-size:15px;width:20px;text-align:center}
.mpr-lbl-key{font-size:11px;color:#9ca3af}
.mpr-row.mpr-hit .mpr-lbl-key{color:#6ee7b7}
.mpr-row.mpr-miss .mpr-lbl-key{color:#9ca3af}
.mpr-vals{flex:1;display:flex;align-items:center;gap:6px;min-width:0}
.mpr-real{font-size:13px;font-weight:600;color:#e5e7eb;min-width:28px;text-align:center}
.mpr-vs{font-size:10px;color:#374151}
.mpr-pred{font-size:13px;font-weight:600}
.mpr-pred.mpr-pred-pend{color:#374151}
.mpr-pred.mpr-pred-hit{color:#22c55e}
.mpr-pred.mpr-pred-miss{color:#ef4444}
.mpr-pts{margin-left:auto;flex-shrink:0}
.mpr-badge{display:inline-block;padding:2px 9px;border-radius:10px;font-size:12px;font-weight:700}
.mpr-badge.mpr-hit-b{background:rgba(34,197,94,.12);color:#22c55e;border:1px solid rgba(34,197,94,.2)}
.mpr-badge.mpr-miss-b{color:#374151;font-size:14px}
.mpr-badge.mpr-pend{color:#374151}
.mpr-section-lbl{font-size:10px;font-weight:700;color:#60a5fa;text-transform:uppercase;letter-spacing:.8px;padding:8px 14px 4px;background:#060c18;border-top:1px solid #0f1225;border-bottom:1px solid #0f1225}
.mpr-footer{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-top:2px solid #111827;background:#070910;font-size:12px;color:#6b7280;font-weight:600;margin-top:4px}

/* ── EN VIVO TAB — BETTING STYLE ─────────────────────────────── */
.lv-bet-card{background:#07090f;border-bottom:1px solid #111827}
.lv-bc-top{display:flex;align-items:center;justify-content:space-between;padding:10px 14px 0}
.lv-bc-label{font-size:10px;color:#6b7280;text-transform:uppercase;letter-spacing:.6px;font-weight:600}
.lv-bc-pts-badge{font-size:17px;font-weight:800;padding:3px 14px;border-radius:20px;border:1px solid #1f2937;color:#6b7280;background:transparent;transition:all .3s}
.lv-pred-row{display:flex;align-items:center;justify-content:space-between;padding:10px 12px 4px;gap:6px}
.lv-pred-team{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1}
.lv-pred-flag{font-size:28px;line-height:1}
.lv-pred-name{font-size:11px;color:#9ca3af;font-weight:500;text-align:center;max-width:70px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lv-pred-scores{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:90px}
.lv-pred-num{font-size:22px;font-weight:700;letter-spacing:4px;color:#60a5fa}
.lv-pred-sep{font-size:9px;color:#374151;letter-spacing:.5px;text-transform:uppercase}
.lv-real-num{font-size:22px;font-weight:700;letter-spacing:4px;color:#e5e7eb}
.lv-pred-hit .lv-real-num{color:#22c55e}
.lv-pred-pending{text-align:center;padding:12px 14px;font-size:13px;color:#6b7280}
/* Items table H-O */
.lv-items-tbl{width:100%;border-collapse:collapse;font-size:12px;margin-top:4px}
.lv-itr{border-top:1px solid #0d1020}
.lv-itr td{padding:7px 6px;vertical-align:middle}
.lv-it-lbl{width:36px;white-space:nowrap}
.lv-it-ico{font-size:13px;margin-right:1px}
.lv-it-key{font-size:8px;font-weight:700;background:#0f1225;color:#6b7280;border-radius:3px;padding:1px 3px;vertical-align:middle}
.lv-it-desc{color:#6b7280;font-size:11px}
.lv-it-pred{color:#60a5fa;font-weight:600;text-align:center;min-width:32px}
.lv-it-real{color:#e5e7eb;font-weight:600;text-align:center;min-width:32px}
.lv-it-pts{text-align:right;padding-right:10px;min-width:44px}
.lv-pts-chip{display:inline-block;padding:2px 8px;border-radius:8px;font-size:11px;font-weight:700}
.lv-pts-hit{background:rgba(34,197,94,.12);color:#22c55e;border:1px solid rgba(34,197,94,.2)}
.lv-pts-miss{color:#374151;font-size:12px}
.lv-pts-pend{color:#374151;font-size:12px}
.lv-itr-hit .lv-it-desc{color:#9ca3af}
.lv-itr-miss .lv-it-desc{color:#4b5563}
.lv-itr-pend .lv-it-desc,.lv-itr-pend .lv-it-pred,.lv-itr-pend .lv-it-real{color:#374151}
/* Stat row */
.lv-stat-row{display:flex;background:#060810;border-bottom:1px solid #0d1020}
.lv-stat-item{flex:1;text-align:center;padding:9px 0;border-right:1px solid #0d1020}
.lv-stat-item:last-child{border-right:none}
.lv-stat-val{font-size:17px;font-weight:700;color:#e5e7eb}
.lv-stat-lbl{font-size:9px;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin-top:1px}
/* Timeline */
.ev-timeline{padding:0 0 16px}
.ev-separator{padding:8px 16px;text-align:center}
.ev-sep-inner{display:inline-block;background:#0f1225;border-radius:20px;padding:5px 18px;font-size:11px;color:#8b9bb4;font-weight:600}
.ev-row{display:grid;grid-template-columns:1fr 54px 1fr;gap:4px;padding:7px 10px;align-items:center;border-bottom:1px solid #0a0c14}
.ev-home{text-align:right}
.ev-away{text-align:left}
.ev-min{text-align:center;font-size:11px;color:#8b9bb4;font-weight:600}
.ev-chip{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:500}
.ev-goal{background:rgba(34,197,94,.12);color:#22c55e}
.ev-yellow{background:rgba(251,191,36,.1);color:#fbbf24}
.ev-red{background:rgba(239,68,68,.12);color:#ef4444}
.ev-var{background:rgba(96,165,250,.1);color:#60a5fa}
.ev-pen{background:rgba(167,139,250,.1);color:#a78bfa}
.ev-cur-min{text-align:center;padding:10px;font-size:12px;color:#22c55e;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px}
/* Legacy compat (refs from other tabs) */
.lt-total-pts{display:none}.lt-total-sub{display:none}

/* ── SCORES / PUNTAJES TAB ────────────────────────────────────── */
/* user selector section */
.sel-section{padding:12px 14px 8px}
.sel-label{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
.sel-combo{display:flex;align-items:center;gap:0;background:#0f1225;border:1px solid #1e2d5a;border-radius:14px;overflow:hidden}
.sel-avatar{width:42px;height:42px;background:linear-gradient(135deg,#1e3a8a,#3b82f6);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#93c5fd;flex-shrink:0}
.sel-name-wrap{flex:1;padding:0 12px}
.sel-name-big{font-size:15px;font-weight:700;color:#93c5fd}
.sel-name-sub{font-size:11px;color:#3b5294;margin-top:1px}
.sel-btn{padding:0 14px;height:42px;font-size:20px;color:#2a3d70;border-left:1px solid #1a2550;transition:background .15s}
.sel-btn:active{background:#141e3a}

/* user dropdown */
.sel-dropdown{background:#0f1225;border:1px solid #1a2550;border-radius:12px;margin:0 14px 8px;overflow:hidden;display:none}
.sel-dropdown.open{display:block}
.sel-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #0a0c14;cursor:pointer;transition:background .1s}
.sel-item:last-child{border-bottom:none}
.sel-item:active{background:#141e3a}
.sel-item-av{width:32px;height:32px;border-radius:50%;background:#1a2550;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#60a5fa;flex-shrink:0}
.sel-item-name{flex:1;font-size:14px;font-weight:500}
.sel-item-pts{font-size:13px;font-weight:700;color:#9ca3af}
.sel-item.active-sel{background:#0d1a35}
.sel-item.active-sel .sel-item-name{color:#93c5fd}
.sel-item.active-sel .sel-item-pts{color:#3b82f6}

/* vs top 3 */
.vs-section{padding:0 14px 10px}
.vs-title{font-size:12px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between}
.vs-cards{display:flex;flex-direction:column;gap:6px}
.vs-card{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;border:1px solid #1a1f35;background:#0f1225}
.vs-card.me{background:linear-gradient(135deg,#0a1630,#0d1a40);border-color:#1e3a8a}
.vs-card.gold{background:linear-gradient(135deg,#1c150a,#201800);border-color:#7a5c00}
.vs-card.sep{background:none;border:none;padding:2px 14px}
.vs-medal{font-size:22px;min-width:28px}
.vs-info{flex:1}
.vs-nm{font-size:14px;font-weight:600}
.vs-diff{font-size:11px;margin-top:2px}
.vs-pts{font-size:16px;font-weight:700}
.vs-bar-wrap{width:60px;height:6px;background:#1a1f35;border-radius:3px;overflow:hidden;margin-top:4px}
.vs-bar-fill{height:6px;border-radius:3px;background:#3b82f6}

/* phase chips */
.phase-chips-section{padding:0 14px 10px}
.phase-chips-title{font-size:12px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
.phase-chips-row{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
.phase-chips-row::-webkit-scrollbar{display:none}
.phase-chip{flex-shrink:0;width:72px;border-radius:12px;border:1px solid #1a1f35;background:#0f1225;padding:10px 6px;text-align:center;cursor:pointer;transition:border-color .15s}
.phase-chip.done{background:linear-gradient(180deg,#0d200d,#091509);border-color:#1a4d1a}
.phase-chip.active-phase{border-color:#3b82f6;background:#0d1a3a}
.phase-chip.live-phase{border-color:#ef4444}
.phase-chip-label{font-size:12px;font-weight:700;color:#9ca3af}
.phase-chip.done .phase-chip-label{color:#22c55e}
.phase-chip.active-phase .phase-chip-label{color:#93c5fd}
.phase-chip.live-phase .phase-chip-label{color:#ef4444}
.phase-chip-sub{font-size:10px;color:#2a3045;margin-top:2px}
.phase-chip.done .phase-chip-sub{color:#1a5c1a}
.phase-chip-pts{font-size:16px;font-weight:800;margin-top:6px;color:#1a1f35}
.phase-chip.done .phase-chip-pts{color:#22c55e}
.phase-chip.active-phase .phase-chip-pts{color:#60a5fa}
.phase-chip.live-phase .phase-chip-pts{color:#fbbf24}
.phase-chip-of{font-size:10px;color:#2a3045;margin-top:1px}

/* match detail panel */
.match-detail{padding:10px 14px}
.md-title{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.md-scoreboard{border-radius:16px;overflow:hidden;margin-bottom:10px;border:1px solid #1a2d1a;background:linear-gradient(180deg,#0d1a0d,#06080f)}
.md-sb-phase{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.7px;text-align:center;padding:10px 0 0}
.md-sb-live-bar{display:flex;align-items:center;justify-content:center;gap:6px;padding:6px;font-size:11px;color:#ef4444;font-weight:600}
.md-sb-teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:12px 16px;gap:6px}
.md-team{text-align:center}
.md-flag{font-size:32px;margin-bottom:4px}
.md-tname{font-size:14px;font-weight:700}
.md-score-box{text-align:center}
.md-score{font-size:44px;font-weight:800;letter-spacing:6px;line-height:1}
.md-period{font-size:11px;color:#8b9bb4;margin-top:4px}
.md-pred-row{background:#060c06;padding:8px 16px;text-align:center;font-size:12px;color:#2a4a2a}
.md-pred-row span{color:#3d7a3d}

/* items breakdown */
.items-list{display:flex;flex-direction:column;gap:6px;margin-bottom:10px}
.item-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:1px solid #1a1f35}
.item-row.hit{background:linear-gradient(135deg,#091509,#0c1e0c);border-color:#166316}
.item-row.miss{background:#0c0e18;border-color:#1a1f35;border-left:3px solid rgba(239,68,68,.35)}
.item-row.pend{background:#0c0e18;border-color:#1a1f35}
.item-letter{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex-shrink:0}
.item-row.hit .item-letter{background:rgba(34,197,94,.15);color:#22c55e}
.item-row.miss .item-letter{background:rgba(239,68,68,.15);color:#ef4444}
.item-row.pend .item-letter{background:#1a1f35;color:#8b9bb4}
.item-name{font-size:12px;font-weight:600;flex:0 0 80px}
.item-row.hit .item-name{color:#4ade80}
.item-row.miss .item-name{color:#f87171}
.item-row.pend .item-name{color:#8b9bb4}
.item-vals{flex:1;display:flex;gap:10px;align-items:center;font-size:12px}
.item-real{color:#9ca3af}
.item-real span{font-weight:600;color:#888}
.item-pred{color:#8b9bb4}
.item-pred span{font-weight:600}
.item-row.hit .item-pred span{color:#22c55e}
.item-row.miss .item-pred span{color:#ef4444}
.item-row.pend .item-pred span{color:#8b9bb4}
.item-pts{font-size:14px;font-weight:800;min-width:30px;text-align:right}
.item-row.hit .item-pts{color:#22c55e}
.item-row.miss .item-pts{color:#8b9bb4}
.item-row.pend .item-pts{color:#8b9bb4}

/* total bar */
.match-total-bar{background:linear-gradient(135deg,#091509,#0c1e0c);border:1px solid #22c55e;border-radius:14px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between}
.match-total-label{font-size:13px;font-weight:700;color:#22c55e}
.match-total-pts{font-size:28px;font-weight:800;color:#22c55e}
.match-total-of{font-size:12px;color:#166316;margin-top:2px}

/* empty state */
.empty-state{padding:40px 20px;text-align:center;color:#2a2f45;font-size:14px}
.empty-icon{font-size:40px;margin-bottom:12px}

/* ── PRED LIST (sub-tab Predicciones) ─────────────────────────── */
.pred-real-bar{display:grid;grid-template-columns:repeat(4,1fr);padding:10px 12px;border-bottom:1px solid #0f1225;gap:6px}
.pred-real-item{text-align:center}
.pred-real-lbl{font-size:9px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.5px}
.pred-real-val{font-size:15px;font-weight:700;margin-top:3px}
.pred-list{padding:8px 12px}
.pred-row{background:#0f1225;border-radius:12px;margin-bottom:8px;padding:10px 12px;border:1px solid #1a1f35}
.pred-row.pred-me{border-color:#1e3a8a;background:#0a1428}
.pred-row-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.pred-name{font-size:14px;font-weight:600}
.pred-total{font-size:15px;font-weight:700;color:#22c55e}
.pred-items{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.pred-item{text-align:center;padding:5px 2px;border-radius:6px}
.pred-item-lbl{font-size:9px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.4px}
.pred-item-val{font-size:12px;font-weight:600;margin-top:2px;color:#2a2f45}
.pred-item.hit{background:rgba(34,197,94,.1)}
.pred-item.hit .pred-item-val{color:#22c55e}
.pred-item.miss .pred-item-val{color:#2a2f45}
.pred-item.pending .pred-item-val{color:#3a3f55}

/* ── RANK LIST ────────────────────────────────────────────────── */
.rank-list{padding:8px 12px}
.rank-row{display:flex;align-items:center;gap:12px;padding:10px 12px;background:#0f1225;border-radius:12px;margin-bottom:8px;border:1px solid #1a1f35}
.rank-row.rank-me{border-color:#1e3a8a;background:#0a1428}
.rank-pos{font-size:18px;font-weight:700;color:#2a2f45;min-width:24px}
.rank-me .rank-pos{color:#3b82f6}
.rank-name{flex:1;font-size:14px;font-weight:600}
.rank-delta{font-size:12px;color:#22c55e;font-weight:500;margin-top:2px}
.rank-total{font-size:16px;font-weight:700}


/* ── MI PRONO sub-tab ────────────────────────────────────────── */
.mp-header{padding:10px 14px 6px;border-bottom:1px solid #0f1225}
.mp-match-lbl{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px}
.mp-match-name{font-size:14px;font-weight:700;margin-top:2px}
.mp-score-row{display:flex;align-items:center;justify-content:space-around;padding:12px 14px;border-bottom:1px solid #0f1225}
.mp-team{text-align:center;flex:1}
.mp-team-flag{font-size:22px}
.mp-team-name{font-size:12px;color:#6b7280;margin-top:3px;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mp-vs{text-align:center;padding:0 10px}
.mp-real-score{font-size:28px;font-weight:800;color:#e5e7eb}
.mp-pred-score{font-size:13px;color:#6b7280;margin-top:4px}
.mp-items-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:10px 12px}
.mp-item{background:#0f1225;border-radius:10px;padding:8px 10px;border:1px solid #1a1f35}
.mp-item.mp-hit{background:rgba(34,197,94,.08);border-color:rgba(34,197,94,.3)}
.mp-item.mp-miss{opacity:.55}
.mp-item.mp-pend{opacity:.4}
.mp-item-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
.mp-item-lbl{font-size:10px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.4px}
.mp-item-pts{font-size:12px;font-weight:700;color:#22c55e}
.mp-item.mp-miss .mp-item-pts{color:#374151}
.mp-item.mp-pend .mp-item-pts{color:#2a2f45}
.mp-item-vals{display:flex;gap:8px;font-size:13px}
.mp-real{font-weight:700;color:#e5e7eb}
.mp-item.mp-miss .mp-real{color:#6b7280}
.mp-pred{color:#6b7280}
.mp-item.mp-hit .mp-pred{color:#22c55e}
.mp-total-row{margin:6px 12px 12px;background:#111827;border-radius:12px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;border:1px solid #1a2040}
.mp-total-lbl{font-size:13px;color:#6b7280}
.mp-total-pts{font-size:22px;font-weight:800;color:#22c55e}
.mp-empty{padding:30px 14px;text-align:center;color:#8b9bb4;font-size:13px}
.mp-no-live{padding:20px 14px;text-align:center;color:#8b9bb4;font-size:13px}

/* ── SCORES BREAKDOWN ────────────────────────────────────────── */
.sb-breakdown{padding:10px 14px;border-bottom:1px solid #0f1225}
.sb-breakdown-title{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
.sb-bk-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #0d1020}
.sb-bk-row:last-child{border-bottom:none;padding-top:8px;margin-top:2px}
.sb-bk-lbl{font-size:13px;color:#9ca3af}
.sb-bk-pts{font-size:14px;font-weight:700;color:#e5e7eb}
.sb-bk-total{font-size:15px;font-weight:800;color:#fbbf24}
.sb-bk-total-lbl{font-size:13px;color:#fbbf24;font-weight:600}

/* ── BOTTOM NAV ───────────────────────────────────────────────── */
/* ── TAB GLOBALES ────────────────────────────────────────────────── */
.gb-wrap{padding:12px 8px 80px}
.gb-header{font-size:13px;color:#9ca3af;text-align:center;padding:8px 0 12px;border-bottom:1px solid #1f2937;margin-bottom:10px}
.gb-table{width:100%;border-collapse:collapse;font-size:12px}
.gb-table th{background:#0f1225;color:#6b7280;font-weight:600;font-size:10px;text-transform:uppercase;letter-spacing:.5px;padding:8px 6px;text-align:left;border-bottom:1px solid #1f2937}
.gb-table th.gb-col-pts{text-align:center}
.gb-table td{padding:10px 6px;border-bottom:1px solid #111827;vertical-align:top;color:#e5e7eb;line-height:1.4}
.gb-table tr:last-child td{border-bottom:none}
.gb-item-lbl{display:flex;align-items:center;gap:5px;white-space:nowrap}
.gb-item-ico{font-size:15px}
.gb-item-letter{font-size:10px;font-weight:700;color:#6b7280;background:#1f2937;border-radius:3px;padding:1px 4px}
.gb-item-desc{font-size:11px;color:#9ca3af;margin-top:2px}
.gb-val-result{color:#e5e7eb;font-weight:500}
.gb-val-result.gb-pending{color:#374151;font-style:italic}
.gb-val-pred{color:#93c5fd}
.gb-val-pred.gb-pending{color:#374151;font-style:italic}
.gb-pts-cell{text-align:center}
.gb-pts-badge{display:inline-block;min-width:32px;padding:3px 6px;border-radius:12px;font-size:11px;font-weight:700;text-align:center}
.gb-pts-badge.gb-pts-pos{background:#064e3b;color:#6ee7b7}
.gb-pts-badge.gb-pts-zero{background:#1c1917;color:#78716c}
.gb-pts-badge.gb-pts-none{background:transparent;color:#374151;font-weight:400}
.gb-total-row td{background:#0f1225;border-top:2px solid #1f2937;font-weight:700;font-size:13px;padding:10px 6px}
.gb-total-pts{color:#fbbf24;font-size:15px;text-align:center}
.gb-max-pts{color:#6b7280;font-size:9px;display:block}
.gb-status-ok{font-size:10px;color:#34d399;font-weight:600;white-space:nowrap}
.gb-status-pend{font-size:10px;color:#374151;font-style:italic;white-space:nowrap}
.gb-val-result.gb-res-win{color:#22c55e;font-weight:700}
.gb-winners{display:flex;flex-wrap:wrap;gap:3px;margin-top:4px}
.gb-winner-chip{display:inline-block;background:rgba(34,197,94,.1);color:#22c55e;border:1px solid rgba(34,197,94,.2);border-radius:10px;font-size:10px;font-weight:600;padding:1px 7px}
.gb-winner-chip.gb-winner-me{background:rgba(96,165,250,.15);color:#60a5fa;border-color:rgba(96,165,250,.3)}
.gb-no-winners{font-size:10px;color:#374151;font-style:italic}
.gb-val-result.gb-res-known{color:#e5e7eb}
.gb-val-pred.gb-pred-hit{color:#22c55e;font-weight:600}
.gb-val-pred.gb-pred-miss{color:#ef4444;text-decoration:line-through;opacity:.7}
.gb-note-box{margin:10px 4px 4px;padding:8px 10px;background:#0c1a14;border:1px solid #064e3b;border-radius:6px;font-size:11px;color:#6ee7b7;line-height:1.5}
.gb-note-box span{display:block;margin-top:3px;color:#9ca3af}
.gb-loading{text-align:center;color:#6b7280;padding:24px;font-size:13px}

.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#0a0c14;border-top:1px solid #0f1225;display:flex;z-index:200;padding-bottom:env(safe-area-inset-bottom)}
.hide-tabs .bottom-nav{display:none!important}
.hide-tabs .tab-pane.active{padding-bottom:0!important}
.hide-tabs #score-hdr{padding-bottom:0}
.bn-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px 0;gap:3px;color:#8b9bb4;font-size:10px;font-weight:500;transition:color .15s;position:relative}
.bn-btn.active{color:#3b82f6}
.bn-icon{font-size:22px;line-height:1}
.bn-dot{width:5px;height:5px;border-radius:50%;background:#ef4444;position:absolute;top:7px;right:calc(50% - 20px)}

/* ── MISC ─────────────────────────────────────────────────────── */
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#1a2040;color:#fff;padding:8px 20px;border-radius:24px;font-size:13px;z-index:999;opacity:0;transition:opacity .2s;pointer-events:none;border:1px solid #2a3060;white-space:nowrap}
.toast.show{opacity:1}
.section-divider{height:1px;background:#0c0f1e;margin:6px 0}

/* ── BRACKET TREE ──────────────────────────────────────────────── */
.bt-toolbar{display:flex;align-items:center;justify-content:space-between;padding:8px 12px 6px;border-bottom:1px solid #0a0c14}
.bt-scroll-hint{font-size:11px;color:#2a2f45;display:flex;align-items:center;gap:4px}
.bt-toggle{display:flex;background:#0a0c14;border:1px solid #1a1f35;border-radius:10px;overflow:hidden}
.bt-toggle-btn{padding:5px 14px;font-size:12px;font-weight:600;color:#8b9bb4;transition:all .15s}
.bt-toggle-btn.active{background:#1e2d5a;color:#93c5fd}
.bracket-tree-wrap{overflow-x:auto;overflow-y:visible;padding:0 0 16px;-webkit-overflow-scrolling:touch;cursor:grab}
.bracket-tree-wrap:active{cursor:grabbing}
.bracket-tree-wrap::-webkit-scrollbar{height:3px}
.bracket-tree-wrap::-webkit-scrollbar-track{background:#0a0c14}
.bracket-tree-wrap::-webkit-scrollbar-thumb{background:#1a2050;border-radius:3px}
.btc{position:absolute;border-radius:8px;overflow:hidden;cursor:pointer;transition:border-color .15s,box-shadow .15s;z-index:2}
.btc-inner{width:100%;height:100%;background:#0f1225;border:1px solid #1a2550;border-radius:8px;overflow:hidden}
.btc.live .btc-inner{border-color:#ef4444;box-shadow:0 0 0 1px rgba(239,68,68,.15)}
.btc.done .btc-inner{border-color:#1a2d1a}
.btc.selected .btc-inner{border-color:#3b82f6;box-shadow:0 0 0 1px rgba(59,130,246,.2)}
.btc:active{opacity:.8}
.btc-row{display:flex;align-items:center;padding:3px 6px;height:26px;gap:4px;border-bottom:1px solid #080a12}
.btc-row:last-child{border-bottom:none}
.btc-flag{font-size:14px;width:18px;text-align:center;flex-shrink:0;line-height:1}
.btc-name{font-size:11px;font-weight:500;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#6a7090}
.btc-score{font-size:12px;font-weight:700;min-width:14px;text-align:right;flex-shrink:0;color:#8b9bb4}
.btc-row.winner .btc-name{color:#e8ecff;font-weight:600}
.btc-row.winner .btc-score{color:#22c55e}
.btc-row.loser .btc-name{color:#2a2f45}
.btc-row.loser .btc-score{color:#1a1f35}
.btc-tbd{display:flex;align-items:center;justify-content:center;height:100%;font-size:10px;color:#1e2340;font-style:italic}
.btc-pred{position:absolute;bottom:2px;right:3px;font-size:9px;font-weight:800;padding:1px 4px;border-radius:3px;line-height:1.2}
.btc-pred.hit{background:rgba(34,197,94,.2);color:#22c55e}
.btc-pred.approx{background:rgba(251,191,36,.18);color:#fbbf24}
.btc-pred.miss{background:rgba(239,68,68,.15);color:#ef4444}
.btc-pred.pend{background:rgba(255,255,255,.04);color:#2a2f45}
.btl{position:absolute;font-size:9px;font-weight:700;color:#1e2545;text-transform:uppercase;letter-spacing:.7px;text-align:center;pointer-events:none;z-index:1}
.bt-center-trophy{position:absolute;display:flex;flex-direction:column;align-items:center;pointer-events:none;z-index:1}
.bt-trophy-icon{font-size:22px;filter:drop-shadow(0 0 6px rgba(251,191,36,.5))}
.bt-3p-lbl{position:absolute;font-size:9px;font-weight:700;color:#2a3050;text-transform:uppercase;letter-spacing:.5px;text-align:center;pointer-events:none;z-index:1}
.btc-status-badge{position:absolute;padding:2px 5px;border-radius:4px;font-size:8px;font-weight:700;white-space:nowrap;pointer-events:none;z-index:10;transform:translateX(-50%)}
.btc-status-badge.live{background:#ef4444;color:#fff}
.btc-status-badge.next{background:#3b82f6;color:#fff}
img.emoji{height:1em;width:1em;vertical-align:-0.1em;display:inline-block}
.btc-status-badge img.emoji{width:1em;height:1em;vertical-align:middle}
.btc-fecha{font-size:7.5px;color:#6ee7b7;text-align:center;border-top:1px solid #1e2850;padding:1px 2px 0;white-space:nowrap;overflow:hidden;line-height:1.4}
.match-fecha-lbl{font-size:10px;color:#6ee7b7;font-weight:700;margin-top:2px}
.match-card-next-badge{position:absolute;top:6px;right:6px;background:#3b82f6;color:#fff;font-size:9px;font-weight:700;padding:2px 5px;border-radius:4px}
.match-venue-row{display:flex;justify-content:space-between;align-items:center;padding:3px 8px 5px;border-top:1px solid #1a1e33;gap:8px}
.match-venue{font-size:9px;color:#4b5563;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ── TAB APUESTAS ──────────────────────────────────────────────── */
.ap-filter{display:flex;gap:6px;overflow-x:auto;padding:4px 10px 4px;scrollbar-width:none}
.ap-filter::-webkit-scrollbar{display:none}
.ap-pill{padding:5px 14px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap;color:#9ca3af;background:#0f1225;border:1px solid #1a1f35;cursor:pointer;transition:all .15s}
.ap-pill.active{background:#1e3a8a;color:#93c5fd;border-color:#2563eb}
.ap-match-list{padding:4px 10px 16px}
.ap-match-card{background:#0c0e1a;border:1px solid #1a1f35;border-radius:12px;margin-bottom:10px;overflow:hidden}
.ap-match-hdr{display:flex;align-items:center;gap:8px;padding:8px 12px;background:#0f1225;border-bottom:1px solid #1a1f35}
.ap-match-num{font-size:10px;color:#334;font-weight:700;min-width:30px}
.ap-match-teams{flex:1;font-size:13px;font-weight:600;color:#cbd5e1;display:flex;align-items:center;gap:6px}
.ap-match-score{font-size:15px;font-weight:800;color:#f1f5f9;letter-spacing:.5px}
.ap-match-score.done{color:#86efac}
.ap-match-score.live{color:#f87171}
.ap-match-date{font-size:9px;color:#334;margin-left:auto}
.ap-match-pen{font-size:9px;color:#60a5fa;margin-left:4px}
.ap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#0f1225}
.ap-cell{padding:5px 6px;background:#0a0c18;display:flex;flex-direction:column;align-items:center;gap:1px;cursor:default;min-height:44px;justify-content:center}
.ap-cell:hover{background:#0f1830}
.ap-cell-alias{font-size:9px;color:#475569;font-weight:600;text-align:center;line-height:1.2;max-width:60px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ap-cell-pred{font-size:13px;font-weight:800;color:#94a3b8}
.ap-cell.ap-pleno .ap-cell-pred{color:#22c55e}
.ap-cell.ap-pleno .ap-cell-alias{color:#166534}
.ap-cell.ap-res   .ap-cell-pred{color:#eab308}
.ap-cell.ap-res   .ap-cell-alias{color:#713f12}
.ap-cell.ap-miss  .ap-cell-pred{color:#ef4444;text-decoration:line-through;opacity:.7}
.ap-cell.ap-miss  .ap-cell-alias{color:#7f1d1d}
.ap-cell.ap-pend  .ap-cell-pred{color:#475569}
.ap-cell-pts{font-size:8px;color:#374151}
.ap-cell.ap-pleno .ap-cell-pts{color:#14532d}
.ap-cell.ap-res   .ap-cell-pts{color:#78350f}
.ap-empty{text-align:center;padding:32px 16px;color:#334;font-size:13px}
.ap-count{font-size:10px;color:#334;padding:4px 12px 8px;text-align:right}

/* ── APUESTAS TAB - ITEM DETAIL ROWS ─────────────────────────────── */
.ap-match-fase{font-size:10px;color:#64748b;margin-left:auto}
.ap-match-fecha{padding:4px 12px 8px;font-size:10px;color:#475569}
.ap-live-badge{font-size:9px;background:#dc2626;color:#fff;border-radius:4px;padding:1px 5px;font-weight:700}
.ai-score-row{display:flex;align-items:center;justify-content:center;gap:16px;padding:10px 12px 8px;background:#0a0f1e}
.ai-score-col{text-align:center;min-width:80px}
.ai-score-lbl{font-size:9px;color:#64748b;margin-bottom:2px}
.ai-score-val{font-size:20px;font-weight:800}
.ai-items-wrap{padding:4px 0 6px}
.ai-hdr{display:grid;grid-template-columns:22px 22px 1fr 50px 50px 42px;gap:0;padding:3px 10px 2px;font-size:8px;font-weight:700;color:#334;border-bottom:1px solid #0f1225;text-transform:uppercase;letter-spacing:.5px}
.ai-row{display:grid;grid-template-columns:22px 22px 1fr 50px 50px 42px;gap:0;padding:5px 10px;border-bottom:1px solid #080a12;align-items:center}
.ai-row.ai-hit{background:#0d1a0d}
.ai-row.ai-pend{opacity:.55}
.ai-section-lbl{font-size:10px;font-weight:700;color:#60a5fa;text-transform:uppercase;letter-spacing:.8px;padding:5px 10px 3px;background:#060c18;border-top:1px solid #0f1225;border-bottom:1px solid #0f1225}
.ai-letter{font-size:9px;font-weight:800;color:#334}
.ai-icon{font-size:13px}
.ai-label{font-size:10px;color:#475569}
.ai-pred{font-size:11px;font-weight:700;color:#60a5fa;text-align:right}
.ai-real{font-size:11px;font-weight:700;color:#94a3b8;text-align:right}
.ai-pts{font-size:12px;font-weight:800;text-align:right}
.ai-total{padding:5px 10px 3px;font-size:11px;color:#94a3b8;border-top:1px solid #1a1f35;text-align:right}

/* ── Scores Matrix ──────────────────────────────────────────── */
.sc-subtabs { display:flex; gap:6px; padding:10px 8px 0; border-bottom:1px solid #1e3a5f; margin-bottom:0; }
.sc-subtab { flex:1; background:none; border:none; border-bottom:2px solid transparent; color:#64748b; font-size:13px; font-weight:600; padding:8px 4px; cursor:pointer; transition:all .2s; }
.sc-subtab.active { color:#3b82f6; border-bottom-color:#3b82f6; }
.sc-mode-bar { display:flex; gap:6px; padding:6px 8px 4px; }
.sc-mode-btn { background:#0f1c2e; border:1px solid #1e3a5f; color:#94a3b8; font-size:12px; font-weight:600; padding:4px 12px; border-radius:6px; cursor:pointer; transition:all .15s; }
.sc-mode-btn.active { background:#1e3a5f; border-color:#3b82f6; color:#93c5fd; }
.sc-th-sm { font-size:10px !important; padding:4px 2px !important; min-width:22px; }
.sc-td-sm { font-size:11px !important; padding:4px 2px !important; text-align:center; }
.sc-th-sep { border-right:2px solid #1e3a5f; }
/* Goleadores */
.gl-wrap { padding:10px 8px; }
.gl-hdr { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.gl-title { font-size:15px; font-weight:700; color:#e2e8f0; }
.gl-my-pred { font-size:12px; color:#94a3b8; margin-bottom:10px; padding:6px 10px; background:#0d1b2e; border-radius:8px; border-left:3px solid #3b82f6; }
.gl-my-pred.no-pred { border-left-color:#374151; color:#4b5563; }
.gl-tbl { width:100%; border-collapse:collapse; font-size:12px; }
.gl-th { background:#0d1b2e; color:#64748b; font-size:10px; font-weight:600; padding:6px 4px; text-align:center; border-bottom:1px solid #1e3a5f; }
.gl-th:first-child { text-align:left; padding-left:6px; }
.gl-td { padding:7px 4px; border-bottom:1px solid #0f172a; color:#94a3b8; text-align:center; }
.gl-td-player { text-align:left; padding-left:6px; }
.gl-tr-me { background:#0b1e0b; }
.gl-tr-me .gl-td-player { color:#4ade80; font-weight:700; }
.gl-tr-winner { background:#1a1a0a; }
.gl-tr-winner .gl-td-player { color:#fbbf24; font-weight:700; }
.gl-pred-badge { font-size:9px; background:#1e3a5f; color:#60a5fa; border-radius:4px; padding:1px 4px; margin-left:4px; }
.gl-pred-badge.me { background:#1a2e1a; color:#4ade80; }
.gl-rank { color:#374151; font-size:11px; }
.gl-goals { color:#fbbf24; font-weight:700; font-size:13px; }
.gl-assists { color:#60a5fa; }
.gl-team { font-size:10px; color:#4b5563; }
.gl-foto { width:24px; height:24px; border-radius:50%; object-fit:cover; vertical-align:middle; margin-right:4px; }
.sc-matrix-section { padding: 12px 8px 0; }
.sc-matrix-hdr { display:flex; align-items:center; gap:8px; margin-bottom:2px; }
.sc-matrix-title { font-size:15px; font-weight:700; color:#e2e8f0; }
.sc-matrix-sub { font-size:11px; color:#4b5563; margin-bottom:8px; }
.sc-refresh-btn { background:none; border:1px solid #1e3a5f; color:#60a5fa; font-size:15px; border-radius:6px; padding:2px 8px; cursor:pointer; line-height:1.2; }
.sc-matrix-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
.sc-loading { text-align:center; padding:30px; color:#4b5563; font-size:13px; }
.sc-tbl-wrap { min-width:100%; }
.sc-tbl { width:100%; border-collapse:collapse; font-size:12px; }
.sc-th { background:#0d1b2e; color:#64748b; font-size:10px; font-weight:600; padding:6px 4px; text-align:center; border-bottom:1px solid #1e3a5f; white-space:nowrap; }
.sc-th-apos { text-align:left; padding-left:8px; min-width:80px; }
.sc-th-rank { min-width:24px; }
.sc-th-total { color:#fbbf24; }
.sc-td { padding:6px 4px; text-align:center; border-bottom:1px solid #0f172a; color:#94a3b8; }
.sc-td-rank { color:#374151; font-size:11px; }
.sc-td-apos { text-align:left; padding-left:8px; color:#cbd5e1; font-weight:600; }
.sc-td-pos { color:#86efac; font-weight:600; }
.sc-td-zero { color:#1e293b; }
.sc-td-total { color:#fbbf24; font-weight:700; font-size:13px; }
.sc-tr { cursor:pointer; transition:background .15s; }
.sc-tr:hover { background:#0f1e30; }
.sc-tr-me { background:#0f1e36; }
.sc-tr-me .sc-td-apos { color:#3b82f6; }
.sc-tr-me:hover { background:#132040; }
.sc-th-item { min-width:30px; font-size:14px; }
/* ── Apuestas: compact live/next section ────────────────── */
.apl-section { margin:6px 8px 2px; border-radius:10px; overflow:hidden; }
.apl-live { background:linear-gradient(135deg,#0f1225 0%,#0d1b0d 100%); border:1px solid rgba(34,197,94,.25); }
.apl-next { background:#0d1423; border:1px solid #1e3a5f; }
.apl-badge { display:inline-flex; align-items:center; gap:4px; font-size:9px; font-weight:700; letter-spacing:.8px; text-transform:uppercase; padding:3px 8px; border-radius:4px; margin-bottom:6px; }
.apl-badge-live { background:rgba(239,68,68,.15); color:#ef4444; }
.apl-badge-next { background:rgba(59,130,246,.1); color:#60a5fa; }
.apl-inner { padding:10px 12px; }
.apl-matchrow { display:flex; align-items:center; justify-content:center; gap:10px; }
.apl-team { display:flex; flex-direction:column; align-items:center; gap:2px; min-width:60px; }
.apl-flag { font-size:24px; line-height:1; }
.apl-tname { font-size:10px; color:#94a3b8; text-align:center; max-width:70px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.apl-score { font-size:26px; font-weight:800; color:#e2e8f0; letter-spacing:2px; min-width:50px; text-align:center; }
.apl-score-live { color:#22c55e; }
.apl-vs { font-size:14px; color:#374151; font-weight:700; }
.apl-meta { text-align:center; margin-top:6px; font-size:11px; color:#4b5563; }
.apl-countdown { font-size:16px; font-weight:700; color:#60a5fa; margin-top:3px; }
.apl-fase { font-size:9px; color:#374151; text-transform:uppercase; letter-spacing:.5px; }
.apl-go-btn { display:block; width:100%; text-align:center; font-size:11px; color:#3b82f6; padding:6px; border-top:1px solid #1e2a3a; cursor:pointer; background:none; border-left:none; border-right:none; border-bottom:none; }
.apl-go-btn:hover { color:#60a5fa; background:rgba(59,130,246,.05); }
.sc-td-mismatch { color:#f87171 !important; }

/* ── SCORES ITEM BREAKDOWN ──────────────────────────────────────────────── */
.sc-ig-wrap{padding:10px 14px 16px}.sc-ig-section-hdr{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.8px;margin:10px 0 4px;border-top:1px solid #1e293b;padding-top:8px}
.sc-ig-title{font-size:11px;color:#8b9bb4;text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.sc-ig-alias{color:#93c5fd;font-weight:700;font-size:13px}
.sc-ig-row{display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid #0d1020}
.sc-ig-row:last-child{border-bottom:none}
.sc-ig-left{display:flex;align-items:center;gap:8px}
.sc-ig-icon{font-size:17px;width:24px;text-align:center}
.sc-ig-lbl{font-size:12px;color:#9ca3af}
.sc-ig-key{font-size:11px;color:#374151;margin-left:4px}
.sc-ig-pts{font-size:14px;font-weight:700;color:#e2e8f0;min-width:30px;text-align:right}
.sc-ig-pts.zero{color:#374151}
.sc-ig-total-row{display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding:10px 0 0;border-top:2px solid #1e3a5f}
.sc-ig-total-lbl{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.6px}
.sc-ig-total-pts{font-size:22px;font-weight:900;color:#60a5fa}

/* ── SIM-BAR (partidos del día) ──────────────────────────────────── */
#sim-bar{background:#06080f;border-bottom:1px solid #0f1225;overflow-x:auto;display:none;-webkit-overflow-scrolling:touch;padding:0 12px}
#sim-bar::-webkit-scrollbar{display:none}
#sim-bar-inner{display:inline-flex;gap:8px;align-items:center;padding:7px 0}
.sim-label{font-size:10px;color:#4b5563;font-weight:700;letter-spacing:.5px;margin-right:4px;text-transform:uppercase;white-space:nowrap}
.sim-tab{display:inline-flex;align-items:center;gap:5px;background:#0f1225;border:1px solid #1a1f35;border-radius:20px;padding:5px 10px;font-size:11px;font-weight:600;color:#6b7280;cursor:pointer;transition:all .15s;white-space:nowrap;flex-shrink:0}
.sim-tab:hover{border-color:#6d28d9;color:#c4b5fd}
.sim-tab.active{background:rgba(124,58,237,.18);border-color:#7c3aed;color:#c4b5fd}
.sim-tab .sim-score{font-weight:700;color:#f9fafb;background:#374151;border-radius:6px;padding:1px 5px;font-size:11px}
.sim-tab.active .sim-score{background:#7c3aed}
.sim-tab.sim-live{border-color:#ef4444;color:#ef4444}
.sim-tab.sim-live.active{border-color:#f97316;background:rgba(239,68,68,.12);color:#f97316}
.sim-tab.sim-prox-tab{border-color:#1a1f35;color:#6b7280}
.sim-tab.sim-prox-tab.active{border-color:#3b82f6;color:#93c5fd;background:rgba(59,130,246,.12)}
.sim-min{font-size:10px;color:#ef4444;font-weight:700}
.sim-dot-p{width:6px;height:6px;border-radius:50%;background:#ef4444;animation:pulse 1.2s infinite;flex-shrink:0}
.sim-prox{font-size:10px;color:#60a5fa;font-weight:600}
.sim-vs{font-size:10px;color:#374151}
.ib{display:inline-block;border-radius:4px;padding:0 5px;font-size:.58rem;font-weight:800;line-height:1.55;letter-spacing:.4px;vertical-align:middle}
.ib-32{background:#7c3aed;color:#fff}
.ib-ko{background:#be185d;color:#fff}
</style>
<script src="https://unpkg.com/twemoji@14.0.2/dist/twemoji.min.js" crossorigin="anonymous"></script>
</head>
<body>

<!-- LOADING -->
  <!-- ─── SELECTOR DE APOSTADOR ──────────────────────────────── -->
  <div id="scr-selector" class="screen" style="background:#060810;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;padding:20px">
    <img src="/static/becbuc-logo.jpeg" alt="BECBUC" style="width:90px;height:90px;object-fit:contain;border-radius:14px;margin-bottom:12px">
    <div style="font-size:13px;color:#64748b;margin-bottom:32px">Copa del Mundo 2026</div>
    <div style="background:#0f1225;border:1px solid #1e2d40;border-radius:14px;padding:28px 24px;width:100%;max-width:360px">
      <div style="font-size:15px;font-weight:700;color:#e2e8f0;margin-bottom:6px;text-align:center">¿Quién sos?</div>
      <div style="font-size:12px;color:#475569;margin-bottom:20px;text-align:center">Elegí tu apodo de la lista</div>
      <select id="apos-combo"
        style="width:100%;box-sizing:border-box;background:#060810;color:#e2e8f0;border:1px solid #1e2d40;border-radius:8px;padding:12px;font-size:15px;margin-bottom:20px;outline:none;cursor:pointer"
        onchange="document.getElementById('sel-apos-err').textContent=''">
        <option value="">— elegí tu apodo —</option>
      </select>
      <button onclick="confirmApostadorSelection()"
        style="width:100%;background:#3b82f6;color:#fff;border:none;border-radius:8px;padding:12px;font-size:15px;font-weight:700;cursor:pointer"
        onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'">
        Continuar →
      </button>
      <div id="sel-apos-err" style="margin-top:12px;font-size:12px;color:#ef4444;text-align:center;min-height:16px"></div>
    </div>
  </div>

<div id="scr-loading" class="screen active">
  <div class="spin"></div>
  <div class="load-msg" id="load-msg">Conectando…</div>
</div>

<!-- MAIN -->
<div id="scr-main" class="screen">
  <!-- TOP BAR -->
  <div class="topbar">
    <div class="tb-brand">BECBUC <span>Playoffs</span></div>
    <div class="tb-right">
      <div class="tb-live" id="tb-live-badge" style="display:none"><div class="live-dot"></div>EN VIVO</div>
      <div class="user-pill" id="user-pill-btn" style="cursor:default;pointer-events:none">
        <div class="user-avatar" id="tp-avatar">?</div>
        <div class="user-name" id="tp-name">Cargando…</div>
      </div>
      <button onclick="changeApostador()" title="Cambiar apostador / cerrar sesión" style="background:#1e293b;border:1px solid #334155;color:#94a3b8;font-size:11px;padding:4px 8px;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:3px;">⇄ <span>Salir</span></button>
    </div>
  </div>

  <!-- SIM-BAR: partidos KO del día -->
  <div id="sim-bar"><div id="sim-bar-inner"></div></div>

  <!-- SCORE HEADER (live) -->
  <div id="score-hdr" class="score-hdr" style="display:none">
    <div class="score-phase" id="score-phase"></div>
    <div class="score-teams">
      <div class="score-team">
        <div class="score-flag" id="score-flag-l"></div>
        <div class="score-name" id="score-name-l"></div>
      </div>
      <div class="score-center">
        <div class="score-num" id="score-num"></div>
        <div class="score-period" id="score-period"></div>
      </div>
      <div class="score-team">
        <div class="score-flag" id="score-flag-v"></div>
        <div class="score-name" id="score-name-v"></div>
      </div>
    </div>
    <div id="pen-row" class="pen-row" style="display:none">
      <div><div class="pen-label">Penales</div><div class="pen-score" id="pen-score-l">–</div></div>
      <div style="color:#1a1f35;font-size:24px">|</div>
      <div><div class="pen-score" id="pen-score-v">–</div><div class="pen-label">Penales</div></div>
    </div>
    <div id="score-sync-row" style="display:flex;justify-content:center;margin-top:10px">
      <button onclick="syncNow()" id="score-sync-btn"
        style="background:#0f1a10;border:1px solid #166534;color:#4ade80;font-size:12px;padding:5px 16px;border-radius:20px;cursor:pointer;display:flex;align-items:center;gap:5px;font-weight:600;letter-spacing:.3px">
        ⟳ <span>Sincronizar</span>
      </button>
    </div>
  </div>


  <!-- no top tabs: navigation is bottom-only -->

  <!-- ─── BRACKET TAB ──────────────────────────────────────────── -->
  <div id="tab-bracket" class="tab-pane active">
    <div class="bt-toolbar">
      <div class="bt-scroll-hint">← deslizá el árbol →</div>
      <div class="bt-toggle">
        <button id="btn-tree-view" class="bt-toggle-btn active" onclick="setBracketView('tree')">🌳 Árbol</button>
        <button id="btn-list-view" class="bt-toggle-btn" onclick="setBracketView('list')">≡ Lista</button>
      </div>
    </div>
    <!-- Tree view -->
    <div id="bracket-tree-wrap" class="bracket-tree-wrap">
      <div id="bracket-tree-inner" style="position:relative"></div>
    </div>
    <!-- List view -->
    <div id="bracket-list-view" style="display:none">
      <div class="phase-pills" id="phase-pills"></div>
      <div class="phase-pts-bar" id="phase-pts-bar"></div>
      <div class="match-list" id="match-list"></div>
    </div>
  </div>

  <!-- ─── EN VIVO TAB ──────────────────────────────────────────── -->
  <div id="tab-live" class="tab-pane">
    <div id="no-live" class="empty-state" style="display:none"></div>
    <div id="live-content" style="display:none;padding-bottom:80px">

      <!-- TU APUESTA: predicción vs score en vivo -->
      <div class="lv-bet-card" id="lv-bet-card" style="display:none">
        <div class="lv-bc-top">
          <span class="lv-bc-label">Tu apuesta · <span id="lv-bc-user"></span></span>
          <span class="lv-bc-pts-badge" id="lv-bc-badge">+0</span>
        </div>
        <div class="lv-pred-row" id="lv-pred-row"></div>
        <div id="lv-bc-items"></div>
      </div>

      <!-- STATS ROW: amarillas / rojas / VAR / penales partido -->
      <div class="lv-stat-row" id="lv-stat-row" style="display:none">
        <div class="lv-stat-item"><div class="lv-stat-val" id="ev-amar">—</div><div class="lv-stat-lbl">🟨 Amar.</div></div>
        <div class="lv-stat-item"><div class="lv-stat-val" id="ev-rojas">—</div><div class="lv-stat-lbl">🟥 Rojas</div></div>
        <div class="lv-stat-item"><div class="lv-stat-val" id="ev-var">—</div><div class="lv-stat-lbl">📺 VAR</div></div>
        <div class="lv-stat-item"><div class="lv-stat-val" id="ev-pen-jg">—</div><div class="lv-stat-lbl">🥅 Pen.</div></div>
      </div>

      <!-- TIMELINE de eventos -->
      <div class="ev-timeline" id="ev-timeline"></div>

      <!-- Admin: Finalizar partido stuck -->
      <div id="admin-fp-wrap" style="display:none;margin:10px;padding:10px 12px;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.25);border-radius:8px">
        <div style="font-size:11px;color:#f87171;font-weight:700;margin-bottom:8px">⚡ Admin · Finalizar partido</div>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <input id="fp-gl" type="number" min="0" max="20" placeholder="Goles local" style="width:100px;background:#0f172a;color:#e5e7eb;border:1px solid #374151;border-radius:6px;padding:4px 8px;font-size:13px">
          <input id="fp-gv" type="number" min="0" max="20" placeholder="Goles visit." style="width:110px;background:#0f172a;color:#e5e7eb;border:1px solid #374151;border-radius:6px;padding:4px 8px;font-size:13px">
          <button onclick="adminFinalizar(this)" style="background:#dc2626;color:#fff;border:none;border-radius:6px;padding:5px 12px;font-size:12px;font-weight:700;cursor:pointer">✓ Finalizar</button>
        </div>
        <div id="fp-msg" style="font-size:11px;color:#6b7280;margin-top:5px"></div>
      </div>

      <!-- compat stubs (referencias desde otros contextos) -->
      <div style="display:none">
        <div id="live-items-total">0</div>
        <div id="lt-total-pts">0</div>
        <div id="lt-total-sub"></div>
        <div id="lt-user-lbl"></div>
      </div>
    </div>
  </div>

  <!-- ─── PUNTAJES TAB ─────────────────────────────────────────── -->
  <div id="tab-scores" class="tab-pane">
    <!-- DOM oculto para compatibilidad con updateComboDisplay -->
    <div style="display:none">
      <div id="sel-avatar">?</div>
      <div id="sel-name"></div>
      <div id="sel-sub"></div>
    </div>

    <!-- Sub-tabs Puntajes -->
    <div class="sc-subtabs">
      <button class="sc-subtab active" id="sct-ranking" onclick="setScoresSubTab('ranking')">📊 Ranking</button>
      <button class="sc-subtab" id="sct-goleadores" onclick="setScoresSubTab('goleadores')">⚽ Goleadores</button>
    </div>

    <!-- Sub-tab: Ranking (contenido original) -->
    <div id="scp-ranking">
      <!-- Toggle Por Fase / Por Items -->
      <div class="sc-mode-bar">
        <button class="sc-mode-btn active" id="scmb-fase" onclick="setScoresMode('fase')">&#128203; Por Fase</button>
        <button class="sc-mode-btn" id="scmb-items" onclick="setScoresMode('items')">&#127991; Por Ítems</button>
      </div>
      <!-- Matriz principal -->
      <div class="sc-matrix-section">
        <div class="sc-matrix-hdr">
          <span class="sc-matrix-title">&#128202; Tabla de Puntajes</span>
          <button class="sc-refresh-btn" onclick="refreshScoresMatrix()" title="Actualizar">&#10227;</button>
        </div>
        <div class="sc-matrix-sub">Toc&#225; un nombre para ver su desglose</div>
        <div id="scores-matrix-wrap" class="sc-matrix-wrap">
          <div class="sc-loading">Cargando...</div>
        </div>
      </div>
      <!-- Detalle del apostador seleccionado: desglose por ítem -->
      <div id="scores-apostador-detail" style="display:none">
        <div id="sc-items-grid"></div>
      </div>
    </div>

    <!-- Sub-tab: Goleadores -->
    <div id="scp-goleadores" style="display:none">
      <div class="gl-wrap">
        <div class="gl-hdr">
          <span class="gl-title">⚽ Tabla de Goleadores</span>
          <button class="sc-refresh-btn" onclick="loadGoleadores(true)" title="Actualizar">&#10227;</button>
        </div>
        <div id="gl-my-pred" class="gl-my-pred"></div>
        <div id="gl-content">
          <div class="sc-loading">Tocá ⚽ Goleadores para cargar</div>
        </div>
      </div>
    </div>

    <!-- Detalle de partido (al tocar en el bracket) -->
    <div class="match-detail" id="match-detail-section" style="display:none">
      <div class="md-title">
        <span id="md-phase-lbl">Detalle del partido</span>
        <span id="md-live-chip" style="display:none;font-size:10px;background:rgba(239,68,68,.15);color:#ef4444;padding:3px 8px;border-radius:8px;font-weight:700">&#9679; LIVE</span>
      </div>
      <div class="md-scoreboard" id="md-scoreboard"></div>
      <div class="items-list" id="md-items"></div>
      <div class="match-total-bar" id="md-total" style="display:none">
        <div>
          <div class="match-total-label">Puntos partido</div>
          <div class="match-total-of" id="md-total-of">de ? posibles</div>
        </div>
        <div class="match-total-pts" id="md-total-pts">0</div>
      </div>
    </div>
  </div>

  <!-- ─── APUESTAS TAB ────────────────────────────────────────── -->
  <div id="tab-apuestas" class="tab-pane">
    <div class="ap-filter" id="ap-filter-row"></div>
    <div id="ap-match-list" class="ap-match-list"></div>
  </div>

  <!-- ─── GLOBALES TAB ───────────────────────────────────────────── -->
  <div id="tab-globales" class="tab-pane">
    <div class="gb-wrap">
      <div class="gb-header">🌐 Pronósticos Globales</div>
      <div id="gb-content"><div class="gb-loading">Cargando…</div></div>
    </div>
  </div>

  <!-- ─── MI PRONO TAB ─────────────────────────────────────────── -->
  <div id="tab-miprono" class="tab-pane">
    <div id="mp-content" style="padding-bottom:80px"></div>
  </div>

  <!-- BOTTOM NAV -->
  <div class="bottom-nav">
    <button class="bn-btn active" id="bn-bracket" onclick="setTab('bracket')">
      <span class="bn-icon">🏆</span>Bracket
    </button>
    <button class="bn-btn" id="bn-live" onclick="setTab('live')" style="position:relative">
      <span class="bn-icon">⚽</span>En Vivo
      <div class="bn-dot" id="live-dot-nav" style="display:none"></div>
    </button>
    <button class="bn-btn" id="bn-miprono" onclick="setTab('miprono')">
      <span style="font-size:20px">📋</span>
      <span>Mi Prono</span>
    </button>
    <button class="bn-btn" id="bn-scores" onclick="setTab('scores')">
      <span class="bn-icon">📊</span>Puntajes
    </button>
    <button class="bn-btn" id="bn-apuestas" onclick="setTab('apuestas')">
      <span class="bn-icon">📋</span>Apuestas
    </button>
    <button class="bn-btn" id="bn-globales" onclick="setTab('globales')">
      <span class="bn-icon">🌐</span>Globales
    </button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ── CONFIG ──────────────────────────────────────────────────────
const BASE  = '';
const NH    = {'ngrok-skip-browser-warning':'true'};

const FASE_PTS = {
  ronda32:      {h:6,  i:12, label:'R32 (16avos)', short:'R32'},
  ronda16:      {h:8,  i:16, label:'8vos de Final', short:'8vos'},
  cuartos:      {h:10, i:20, label:'Cuartos de Final', short:'4tos'},
  semis:        {h:12, i:24, label:'Semifinales', short:'Semis'},
  tercer_puesto:{h:14, i:28, label:'3er Puesto', short:'3P'},
  final:        {h:20, i:40, label:'Final', short:'Final'},
};
const FASE_ORDER = ['ronda32','ronda16','cuartos','semis','tercer_puesto','final'];

// ── STATE ────────────────────────────────────────────────────────
let _token   = localStorage.getItem('bec_playoffs_token') || null;
let _tokenTs = parseInt(localStorage.getItem('bec_playoffs_token_ts')||'0');
let _torneoId = null;
let _bracket  = [];
let _liveData = null;
let _myId     = null;
let _myName   = null;
let _isAdmin  = false;
let _activeTab    = 'bracket';
let _activePhase  = 'cuartos';
let _activeSubTab = 'partido';
let _autoTimer    = null;
let _selectedMatchNum = null;

// User selector state
let _viewAsId   = null;
let _viewAsName = null;
let _apostadores = [];     // full apostador list from ranking
let _userPreds   = {};     // partido_id → prediction object (from mis-partidos)
let _phaseTotals = {};     // fase → pts for viewAs user
let _selOpen    = false;
let _bracketView = 'tree';
let _topbarSelOpen = false;
let _partHoy    = [];          // partidos KO de hoy (en_juego + programados)
let _allBets    = null;        // cache for apuestas-ko endpoint
let _apuestasFase = 'all';     // filter for Apuestas tab

// ── API ──────────────────────────────────────────────────────────
async function api(url, opts={}) {
  await ensureToken();
  const headers = {'Content-Type':'application/json',...NH,...(opts.headers||{})};
  if (_token) headers['Authorization'] = 'Bearer '+_token;
  let r = await fetch(BASE+url, {...opts, headers});
  if (r.status===401) {
    // Token expirado — forzar re-login y reintentar
    _token=null; _tokenTs=0;
    localStorage.removeItem('bec_playoffs_token');
    localStorage.removeItem('bec_playoffs_token_ts');
    try {
      await ensureToken();
      const h2 = {'Content-Type':'application/json',...NH,...(opts.headers||{})};
      if (_token) h2['Authorization'] = 'Bearer '+_token;
      r = await fetch(BASE+url, {...opts, headers:h2});
    } catch(e2) { throw new Error('UNAUTH'); }
  }
  return r;
}

const _AUTO_USER = 'jose';
const _AUTO_PASS = 'catalina';

async function ensureToken() {
  const now = Date.now();
  if (_token && _tokenTs > 0 && (now-_tokenTs) < 23*3600*1000) return;
  const r = await fetch(BASE+'/api/v1/auth/login',{
    method:'POST',
    headers:{'Content-Type':'application/json',...NH},
    body:JSON.stringify({username:_AUTO_USER, password:_AUTO_PASS})
  });
  const d = await r.json();
  if (!d.access_token) throw new Error('Error de autenticacion del sistema');
  _token=d.access_token; _tokenTs=now;
  localStorage.setItem('bec_playoffs_token',_token);
  localStorage.setItem('bec_playoffs_token_ts',_tokenTs.toString());
}



// ── INIT ─────────────────────────────────────────────────────────

/* ══════════════════════════════════════════════════════════════
   TAB APUESTAS — predicciones de todos los apostadores por partido KO
   ══════════════════════════════════════════════════════════════ */
async function loadAllBets() {
  if (_allBets) return _allBets;
  if (!_torneoId) return null;
  try {
    const r = await api(`/api/v1/bets/apuestas-ko/${_torneoId}`);
    const d = await r.json();
    _allBets = d.partidos || [];
  } catch(e) {
    _allBets = [];
    console.warn('loadAllBets error:', e);
  }
  return _allBets;
}

function _apuestasFaseLabel(tipo) {
  const MAP = {
    ronda32:'R32', ronda16:'8vos', cuartos:'4tos',
    semis:'Semis', tercer_puesto:'3P', final:'Final'
  };
  return MAP[tipo] || tipo;
}

function _apuestasCls(pred_l, pred_v, real_l, real_v) {
  if (real_l === null || real_l === undefined) return 'ap-pend';
  if (pred_l === null || pred_l === undefined) return 'ap-pend';
  if (pred_l === real_l && pred_v === real_v) return 'ap-pleno';
  const rRes = real_l > real_v ? 'L' : real_v > real_l ? 'V' : 'E';
  const pRes = pred_l > pred_v ? 'L' : pred_v > pred_l ? 'V' : 'E';
  if (rRes === pRes) return 'ap-res';
  return 'ap-miss';
}

function _apPts(apuesta) {
  return (apuesta.h || 0) + (apuesta.i || 0) > 0
    ? `+${(apuesta.h||0)+(apuesta.i||0)}` : '';
}

function renderApLiveSection() {
  const el = document.getElementById('ap-live-section');
  if (!el) return;

  const p = _liveData?.partido;

  // Si hay partido en vivo
  if (p && (p.estado === 'en_juego' || p.en_vivo)) {
    const lN = p.equipo_local || p.local || '?';
    const vN = p.equipo_visitante || p.visitante || '?';
    const lIso = p.bandera_local || '';
    const vIso = p.bandera_visitante || '';
    const lF = teamFlag(lN, lIso);
    const vF = teamFlag(vN, vIso);
    const gl = p.goles_local ?? '?';
    const gv = p.goles_visitante ?? '?';
    const min = p.minuto_actual ? `${p.minuto_actual}\'` : 'En Vivo';
    const faseLabel = (FASE_PTS[p.fase_tipo]||{}).label || p.fase_tipo || 'Playoff';
    el.innerHTML = `
      <div class="apl-section apl-live">
        <div class="apl-inner">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
            <span class="apl-badge apl-badge-live">&#9679; En Vivo ${min}</span>
            <span class="apl-fase">P${p.numero_fifa||''} · ${faseLabel}</span>
          </div>
          <div class="apl-matchrow">
            <div class="apl-team"><div class="apl-flag">${lF}</div><div class="apl-tname">${lN}</div></div>
            <div class="apl-score apl-score-live">${gl} &#8211; ${gv}</div>
            <div class="apl-team"><div class="apl-flag">${vF}</div><div class="apl-tname">${vN}</div></div>
          </div>
        </div>
        <button class="apl-go-btn" onclick="setTab('live')">Ver partido completo &#8250;</button>
      </div>`;
    return;
  }

  // Próximo partido
  let nextMatch = null, bestTime = Infinity;
  const now = Date.now();
  for (const m of (_bracket||[])) {
    if (m.finalizado) continue;
    if (!m.fecha) continue;
    const t = new Date(_isoToUTC(m.fecha)).getTime();
    if (t > now - 30*60*1000 && t < bestTime) { bestTime=t; nextMatch=m; }
  }
  if (!nextMatch) { el.innerHTML=''; return; }

  const lN  = nextMatch.local?.nombre  || nextMatch.local  || 'TBD';
  const vN  = nextMatch.visitante?.nombre || nextMatch.visitante || 'TBD';
  const lF  = flagFor(lN);
  const vF  = flagFor(vN);
  const faseLabel = (FASE_PTS[nextMatch.tipo]||{}).label || nextMatch.tipo || 'Playoff';
  const fechaStr  = nextMatch.fecha ? fmtFechaCorta(nextMatch.fecha) : '';
  const cdTxt     = nextMatch.fecha ? countdownText(nextMatch.fecha) : '';

  el.innerHTML = `
    <div class="apl-section apl-next">
      <div class="apl-inner">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span class="apl-badge apl-badge-next">&#9197; Pr&#243;ximo</span>
          <span class="apl-fase">P${nextMatch.num||''} · ${faseLabel}</span>
        </div>
        <div class="apl-matchrow">
          <div class="apl-team"><div class="apl-flag">${lF}</div><div class="apl-tname">${lN}</div></div>
          <div class="apl-vs">VS</div>
          <div class="apl-team"><div class="apl-flag">${vF}</div><div class="apl-tname">${vN}</div></div>
        </div>
        <div class="apl-meta">&#128197; ${fechaStr}</div>
        <div class="apl-countdown" id="apl-countdown" data-fecha="${nextMatch.fecha||''}">${cdTxt}</div>
      </div>
    </div>`;
  if (nextMatch.fecha) startCountdown(nextMatch.fecha);
}

function renderApuestasTab() {
  const listEl   = document.getElementById('ap-match-list');
  const filterEl = document.getElementById('ap-filter-row');
  if (!listEl) return;

  if (!_viewAsId) {
    if (filterEl) filterEl.innerHTML = '';
    listEl.innerHTML = '<div class="ap-empty">Seleccioná un apostador en el top bar para ver sus apuestas</div>';
    return;
  }

  const koMatches = (_bracket||[])
    .filter(m => m.num >= 73)
    .sort((a,b) => a.num - b.num);

  if (!koMatches.length) {
    listEl.innerHTML = '<div class="ap-empty">Sin partidos KO disponibles</div>';
    return;
  }

  const FASE_ORDER = ['ronda32','ronda16','cuartos','semis','tercer_puesto','final'];
  const fasesDisp  = [...new Set(koMatches.map(m=>m.tipo||''))].filter(Boolean);

  if (filterEl) {
    const pills = [];
    pills.push(`<button class="ap-pill ${_apuestasFase==='all'?'active':''}" onclick="setApFase('all')">Todos</button>`);
    FASE_ORDER.filter(f=>fasesDisp.includes(f)).forEach(f => {
      pills.push(`<button class="ap-pill ${_apuestasFase===f?'active':''}" onclick="setApFase('${f}')">${_apuestasFaseLabel(f)}</button>`);
    });
    filterEl.innerHTML = pills.join('');
  }

  const filtered = _apuestasFase === 'all'
    ? koMatches
    : koMatches.filter(m => (m.tipo||'') === _apuestasFase);

  if (!filtered.length) {
    listEl.innerHTML = '<div class="ap-empty">Sin partidos en esta fase</div>';
    return;
  }

  const FASE_PTS_LOCAL = {
    ronda32:{h:6,i:12}, ronda16:{h:8,i:16}, cuartos:{h:10,i:20},
    semis:{h:12,i:24}, tercer_puesto:{h:14,i:28}, final:{h:20,i:40}
  };

  function _itemRow(letter, icon, label, realVal, predVal, ptsVal, isPend) {
    const realStr = (realVal !== null && realVal !== undefined) ? String(realVal) : '–';
    const predStr = (predVal !== null && predVal !== undefined) ? String(predVal) : '–';
    const rowCls  = (ptsVal > 0) ? 'ai-row ai-hit' : (isPend ? 'ai-row ai-pend' : 'ai-row');
    let ptsFrag;
    if (isPend || ptsVal === null) {
      ptsFrag = '<span style="color:#334">–</span>';
    } else if (ptsVal > 0) {
      ptsFrag = `<span style="color:#22c55e;font-weight:800">+${ptsVal}</span>`;
    } else {
      ptsFrag = '<span style="color:#475569">0</span>';
    }
    return `<div class="${rowCls}"><span class="ai-letter">${letter}</span><span class="ai-icon">${icon}</span><span class="ai-label">${label}</span><span class="ai-pred">${predStr}</span><span class="ai-real">${realStr}</span><span class="ai-pts">${ptsFrag}</span></div>`;
  }

  let out = '';
  filtered.forEach(m => {
    const pred    = _userPreds[m.num] || null;
    const done    = m.finalizado;
    const live    = m.en_vivo;
    const pend    = !done && !live;
    const hasPred = pred !== null && (pred.pred_local !== null && pred.pred_local !== undefined);

    const localN = m.local?.nombre || 'TBD';
    const visitN = m.visitante?.nombre || 'TBD';
    const flagL  = teamFlag(localN, m.local?.iso||'');
    const flagV  = teamFlag(visitN, m.visitante?.iso||'');
    const faseLabel = _apuestasFaseLabel(m.tipo||'');
    const fechaStr  = m.fecha ? fmtFechaCorta(m.fecha) : '';
    const cfg       = FASE_PTS_LOCAL[m.tipo] || {h:4,i:8};
    const mult      = isPyMatch(localN, visitN) ? 2 : 1;
    const pyLabel   = mult > 1 ? ' ×2🇵🇾' : '';

    const gl   = m.gl    ?? null;
    const gv   = m.gv    ?? null;
    const penL = m.pen_l ?? null;
    const penV = m.pen_v ?? null;

    const pl   = pred?.pred_local     ?? null;
    const pv   = pred?.pred_visitante  ?? null;

    const cls     = _apuestasCls(pl, pv, gl, gv);
    const clsIcon = cls==='ap-pleno'?'✅':cls==='ap-res'?'🟡':cls==='ap-miss'?'❌':'⏳';
    const clsColor = cls==='ap-pleno'?'#22c55e':cls==='ap-res'?'#eab308':cls==='ap-miss'?'#ef4444':'#475569';

    const scoreReal = (done||live) ? `${gl??'?'}–${gv??'?'}` : '–';
    const scorePred = hasPred ? `${pl}–${pv}` : 'Sin prono';

    // ─── Item rows H–O ──────────────────────────────────────────
    let items = '';

    // H – Resultado
    const rH = (done||live) && gl !== null ? (gl>gv?'L':gl<gv?'V':'E') : null;
    const pH = hasPred ? (pl>pv?'L':pl<pv?'V':'E') : null;
    items += _itemRow('H','⚽','Resultado', rH, pH, done?(pred?.pts_resultado??null):null, pend);

    // I – Marcador exacto
    const rI = (done||live) && gl !== null ? `${gl}-${gv}` : null;
    const pI = hasPred ? `${pl}-${pv}` : null;
    items += _itemRow('I','🎯','Marcador exacto', rI, pI, done?(pred?.pts_marcador??null):null, pend);

    // J – Amarillas
    const pJ = pred?.pred_amarillas ?? null;
    const rJ = (done||live) ? (pred?.amarillas ?? null) : null;
    if (pJ !== null || rJ !== null || (pred?.pts_amarillas||0) > 0)
      items += _itemRow('J','🟨','Amarillas', rJ, pJ, done?(pred?.pts_amarillas??null):null, pend);

    // K – Rojas
    const pK = pred?.pred_rojas ?? null;
    const rK = (done||live) ? (pred?.rojas ?? null) : null;
    if (pK !== null || rK !== null || (pred?.pts_rojas||0) > 0)
      items += _itemRow('K','🟥','Rojas', rK, pK, done?(pred?.pts_rojas??null):null, pend);

    // L – VAR
    const pL = pred?.pred_var ?? null;
    const rL = (done||live) ? (pred?.decisiones_var ?? null) : null;
    if (pL !== null || rL !== null || (pred?.pts_var||0) > 0)
      items += _itemRow('L','📺','VAR', rL, pL, done?(pred?.pts_var??null):null, pend);

    // M – Penales (juego)
    const pM = pred?.pred_penales_partido ?? null;
    const rM = (done||live) ? (pred?.penales_partido ?? null) : null;
    if (pM !== null || rM !== null || (pred?.pts_penales_partido||0) > 0)
      items += _itemRow('M','🥅','Penales (juego)', rM, pM, done?(pred?.pts_penales_partido??null):null, pend);

    // N – Minuto gol
    const pN = pred?.pred_minuto_gol ?? null;
    const rN = (done||live) ? (pred?.minuto_primer_gol ?? null) : null;
    if (pN !== null || rN !== null || (pred?.pts_minuto||0) > 0)
      items += _itemRow('N','⏱','Minuto gol', rN, pN, done?(pred?.pts_minuto??null):null, pend);

    // N – mostrar ganador (más cercano al minuto del gol)
    if (done && rN !== null && m.apuestas) {
      const allPmg = Object.entries(m.apuestas)
        .filter(([,b]) => b.pmg != null)
        .map(([aid,b]) => ({aid: +aid, pmg: b.pmg, diff: Math.abs(b.pmg - rN)}));
      if (allPmg.length > 0) {
        const minDiff = Math.min(...allPmg.map(x => x.diff));
        const wins = allPmg.filter(x => x.diff === minDiff);
        const aliasOf = aid => {
          const r = (_rankingData||[]).find(x => +x.apostador_id === +aid);
          return r ? (r.apostador || r.username || `#${aid}`) : `#${aid}`;
        };
        const names = wins.map(x => aliasOf(x.aid)).join(', ');
        const myDiff = pN != null ? Math.abs(pN - rN) : null;
        const isW = myDiff === minDiff;
        const diffStr = minDiff === 0 ? 'exacto' : `${minDiff} min off`;
        items += `<div style="font-size:10px;padding:2px 10px 5px;color:#9ca3af;border-bottom:1px solid #0f1225">⏱ Más cercano al gol (min ${rN}'): <strong style="color:${isW?'#22c55e':'#60a5fa'}">${names}</strong> · pronosticó ${wins[0].pmg}' (${diffStr})${myDiff!=null&&!isW?` · tu diff: ${myDiff} min`:''}`;
      }
    }
    // Ol / Ov – Penales tanda (siempre juntos con separador)
    const pOl = pred?.pred_penales_local_tanda     ?? null;
    const pOv = pred?.pred_penales_visitante_tanda  ?? null;
    const hasTanda = penL !== null || pOl !== null || pOv !== null || (pred?.pts_penales_tanda||0) > 0;
    if (hasTanda) {
      const hitOl  = done && pOl !== null && penL !== null && pOl === penL;
      const hitOv  = done && pOv !== null && penV !== null && pOv === penV;
      const ptsOl  = done && penL !== null ? (hitOl ? 2*mult : 0) : null;
      const ptsOv  = done && penV !== null ? (hitOv ? 2*mult : 0) : null;
      const locS   = localN.split(' ')[0];
      const visS   = visitN.split(' ')[0];
      items += `<div class="ai-section-lbl">⚽ Definición por penales</div>`;
      items += _itemRow('Ol','⚡','Tanda '+locS, penL, pOl, ptsOl, pend);
      items += _itemRow('Ov','⚡','Tanda '+visS, penV, pOv, ptsOv, pend);
    }

    // P – Equipo clasifica
    const predPId  = pred?.pred_equipo_clasifica ?? null;
    const realEcId = pred?.equipo_clasificado_id  ?? null;
    const locId    = m.local?.id    ?? null;
    const visId    = m.visitante?.id ?? null;
    const realEcNom = realEcId ? (realEcId===locId ? localN.split(' ')[0] : (realEcId===visId ? visitN.split(' ')[0] : '?')) : null;
    const predEcNom = predPId  ? (predPId===locId  ? localN.split(' ')[0] : (predPId===visId  ? visitN.split(' ')[0] : '?')) : null;
    const ptsP = done ? (pred?.pts_equipo ?? null) : null;
    if (predPId !== null || realEcId !== null || (pred?.pts_equipo||0) > 0)
      items += _itemRow('P','🏅','Clasifica', realEcNom, predEcNom, ptsP, pend);

    const totalPts  = done ? (pred?.pts_total ?? 0) : null;
    const totalRow  = (done && hasPred)
      ? `<div class="ai-total">Total partido: <strong style="color:#f59e0b">${totalPts??0} pts${pyLabel}</strong></div>`
      : '';

    const itemsBlock = items
      ? `<div class="ai-items-wrap"><div class="ai-hdr"><span></span><span></span><span></span><span style="text-align:right">Prono</span><span style="text-align:right">Real</span><span style="text-align:right">Pts</span></div>${items}${totalRow}</div>`
      : '';

    out += `
<div class="ap-match-card">
  <div class="ap-match-hdr">
    <span class="ap-match-num">P${m.num}</span>
    <span class="ap-match-teams">${flagL} ${localN} <small style="color:#475569;font-size:10px">vs</small> ${visitN} ${flagV}</span>
    <span class="ap-match-fase">${faseLabel}</span>
    ${live?'<span class="ap-live-badge">EN VIVO</span>':''}
  </div>
  <div class="ai-score-row">
    <div class="ai-score-col"><div class="ai-score-lbl">REAL</div><div class="ai-score-val" style="color:${done?'#e2e8f0':'#475569'}">${scoreReal}</div></div>
    <div style="font-size:24px">${clsIcon}</div>
    <div class="ai-score-col"><div class="ai-score-lbl">TU PRONO</div><div class="ai-score-val" style="color:${hasPred?clsColor:'#475569'}">${scorePred}</div></div>
  </div>
  ${itemsBlock}
  ${fechaStr?`<div class="ap-match-fecha">📅 ${fechaStr}</div>`:''}
</div>`;
  });

  listEl.innerHTML = out || '<div class="ap-empty">Sin datos disponibles</div>';
}


function setApFase(fase) {
  _apuestasFase = fase;
  renderApuestasTab();
}

async function init() {
  setMsg('Autenticando…');
  try {
    await ensureToken();
    setMsg('Cargando torneo…');
    const r = await api('/api/v1/torneo/activas');
    const d = await r.json();
    const activas = Array.isArray(d) ? d : (d.torneos||d.data||[]);
    const t = activas.find(x=>x.datos_cargados)||activas[0];
    if (!t) throw new Error('Sin torneo activo');
    _torneoId = t.id;

    try {
      const me = await api('/api/v1/auth/me');
      const md = await me.json();
      _myId   = md.id;
      _myName = md.nombre||md.username;
      _isAdmin = ['admin','superadmin'].includes(md.role);
    } catch(e) {}

    setMsg('Cargando datos…');
    await Promise.all([loadBracket(), loadLive(), loadApostadores()]);

    // Restaurar apostador desde memoria (localStorage) si ya eligió antes
    const savedId   = parseInt(localStorage.getItem('bec_apos_id') || '0');
    const savedName = localStorage.getItem('bec_apos_name') || '';
    const savedPts  = parseInt(localStorage.getItem('bec_apos_pts') || '0');
    if (savedId && savedName) {
      await setViewAs(savedId, savedName, savedPts);
      showScreen('main');
      // Respetar ?tab= de la URL (ej: portal lo carga con ?tab=live)
      const _urlTab = new URLSearchParams(location.search).get('tab');
      if (_urlTab) setTab(_urlTab);
      // ?hidetabs=1 → ocultar nav y fijar tab (usado cuando se embebe en el portal)
      if (new URLSearchParams(location.search).get('hidetabs') === '1') {
        document.body.classList.add('hide-tabs');
        // Sobreescribir setTab para que no cambie de tab
        const _fixedTab = _urlTab || 'live';
        window._origSetTab = setTab;
        window.setTab = function(t) { window._origSetTab(_fixedTab); };
        setTab(_fixedTab);
      }
      startAutoRefresh();
      _startHeartbeat();
    } else {
      // Primera vez: mostrar selector de apostador (por abecedario, sin contraseña)
      await populateApostadorSelector();
      showScreen('selector');
      // startAutoRefresh() se llama después de que el apostador confirme su selección
    }
  } catch(e) {
    setMsg('Error: '+e.message);
  }
}

async function populateApostadorSelector() {
  const combo = document.getElementById('apos-combo');
  if (!combo) return;

  // Fallback: si _apostadores aún vacío intentar cargar
  if (!_apostadores.length && _torneoId) {
    await loadApostadores();
  }

  // Excluir el usuario del sistema (_myId = jose admin)
  const list = _apostadores.filter(a => {
    const id = a.apostador_id || a.id;
    // /apostadores ya filtra por rol 'apostador'; excluir _myId como doble guarda
    return (a.alias || a.apostador || a.username || a.nombre) && id !== _myId;
  });

  if (!list.length) {
    combo.innerHTML = '<option value="">Sin datos — ¿el servidor está activo?</option>';
    return;
  }

  const sorted = [...list].sort((a,b) =>
    (a.apostador||a.username||a.nombre||'').localeCompare(b.apostador||b.username||b.nombre||'')
  );

  combo.innerHTML = '<option value="">— elegí tu apodo —</option>' +
    sorted.map(a => {
      const id   = a.apostador_id || a.id;
      const name = a.alias || a.apostador || a.username || a.nombre || '?';
      const pts  = a.puntos_total || 0;
      return `<option value="${id}" data-name="${name}" data-pts="${pts}">${name}</option>`;
    }).join('');
}

async function confirmApostadorSelection() {
  const combo = document.getElementById('apos-combo');
  const errEl = document.getElementById('sel-apos-err');
  if (!combo || !combo.value) {
    if (errEl) errEl.textContent = 'Seleccioná tu nombre para continuar';
    return;
  }
  const opt  = combo.options[combo.selectedIndex];
  const id   = parseInt(combo.value);
  const name = opt.dataset.name || opt.textContent;
  const pts  = parseInt(opt.dataset.pts || '0');
  // Guardar apostador en memoria para no tener que elegir de nuevo
  localStorage.setItem('bec_apos_id',   id.toString());
  localStorage.setItem('bec_apos_name', name);
  localStorage.setItem('bec_apos_pts',  pts.toString());
  // Detener refresh anterior, resetear tab, inicializar con nuevo apostador
  clearInterval(_autoTimer);
  _activeTab = 'bracket';
  showScreen('main');
  await setViewAs(id, name, pts);
  const _urlTabApos = new URLSearchParams(location.search).get('tab');
  setTab(_urlTabApos || 'bracket');
  startAutoRefresh();
  _startHeartbeat();
  // Registrar presencia inmediatamente al hacer login
  _registrarPresencia();
}

function setMsg(m) { document.getElementById('load-msg').textContent = m; }
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('scr-'+id).classList.add('active');
}

function changeApostador() {
  // Limpiar memoria y volver al selector
  localStorage.removeItem('bec_apos_id');
  localStorage.removeItem('bec_apos_name');
  localStorage.removeItem('bec_apos_pts');
  _viewAsId = null; _viewAsName = null;
  // Resetear UI del topbar
  const tpName = document.getElementById('tp-name');
  const tpAvatar = document.getElementById('tp-avatar');
  if (tpName) tpName.textContent = 'Elegí tu nombre';
  if (tpAvatar) tpAvatar.textContent = '?';
  // Volver al selector
  populateApostadorSelector().then(function(){ showScreen('selector'); });
}

// ── LOAD DATA ─────────────────────────────────────────────────────
async function loadBracket() {
  const r = await api('/api/v1/bets/bracket-real/'+_torneoId);
  const d = await r.json();
  _bracket = d.partidos||[];
  renderBracket();
}

async function loadLive() {
  try {
    const r = await api('/api/v1/bets/live-panel/'+_torneoId);
    const d = await r.json();
    _liveData = d;
    if (d.partidos_hoy) _partHoy = d.partidos_hoy;
    renderSimBar();
    renderLiveHeader();
    renderLiveContent();
    // Registrar presencia en BD (sin auth, usa apostador seleccionado)
    if (_viewAsId) {
      const _alias = _viewAsName || '';
      fetch(`/api/v1/bets/live-presencia?apostador_id=${_viewAsId}&torneo_id=${_torneoId}&alias=${encodeURIComponent(_alias)}`,
        {method:'POST', headers:{'ngrok-skip-browser-warning':'true'}}).catch(()=>{});
    }
  } catch(e) {}
}

async function loadApostadores() {
  try {
    // /apostadores filtra por rol 'apostador' — excluye jose, andresboga y otros admins
    const r = await api('/api/v1/bets/apostadores');
    const d = await r.json();
    _apostadores = d||[];
  } catch(e) {}
}

async function loadUserPredictions(apostadorId) {
  if (!apostadorId) return;
  try {
    // Always pass for_apostador_id — backend enforces access control server-side
    const url = '/api/v1/bets/mis-partidos/'+_torneoId+'?for_apostador_id='+apostadorId;
    const r = await api(url);
    const d = await r.json();
    const partidos = d.partidos||d||[];
    _userPreds = {};
    for (const p of partidos) {
      // Key by numero_fifa when available (matches m.num in bracket) fallback to partido_id
      const key = (p.numero_fifa != null) ? p.numero_fifa : p.partido_id;
      _userPreds[key] = p;
    }
    calcPhaseTotals();
    if (_activeTab === 'apuestas') renderApuestasTab();
  } catch(e) { console.warn('loadUserPredictions:', e); }
}

function calcPhaseTotals() {
  _phaseTotals = {};
  const byTipo = {};
  for (const m of _bracket) {
    if (!byTipo[m.tipo]) byTipo[m.tipo] = [];
    byTipo[m.tipo].push(m);
  }
  for (const [fase, matches] of Object.entries(byTipo)) {
    const cfg = FASE_PTS[fase]||{h:4,i:8};
    let total = 0;
    for (const m of matches) {
      if (!m.finalizado && m.estado !== 'en_juego') continue;
      const pred = _userPreds[m.num];
      if (!pred) continue;
      total += calcMatchPts(m, pred, cfg);
    }
    _phaseTotals[fase] = total;
  }
}

function calcMatchPts(m, pred, cfg) {
  const gl=m.gl??null, gv=m.gv??null;
  const pl=pred.pred_local??null, pv=pred.pred_visitante??null;
  const hitH = gl!==null && gv!==null && pl!==null && pv!==null && sign(gl-gv)===sign(pl-pv);
  const hitI = gl!==null && gv!==null && pl===gl && pv===gv;
  const hitJ = m.amarillas!==undefined && m.amarillas!==null && pred.pred_amarillas!==null && m.amarillas===pred.pred_amarillas;
  const hitK = m.rojas!==undefined && m.rojas!==null && pred.pred_rojas!==null && m.rojas===pred.pred_rojas;
  const hitL = m.decisiones_var!==undefined && m.decisiones_var!==null && pred.pred_var!==null && m.decisiones_var===pred.pred_var;
  const hitM = m.penales_partido!==undefined && m.penales_partido!==null && pred.pred_penales_partido!==null && m.penales_partido===pred.pred_penales_partido;
  const hitOl = m.pen_l!==null && m.pen_l!==undefined && pred.pred_penales_local_tanda!==null && m.pen_l===pred.pred_penales_local_tanda;
  const hitOv = m.pen_v!==null && m.pen_v!==undefined && pred.pred_penales_visitante_tanda!==null && m.pen_v===pred.pred_penales_visitante_tanda;
  const mult = isPyMatch(m.local?.nombre, m.visitante?.nombre) ? 2 : 1;
  return ((hitH?cfg.h:0)+(hitI?cfg.i:0)+(hitJ?1:0)+(hitK?1:0)+(hitL?1:0)+(hitM?1:0)+(hitOl?2:0)+(hitOv?2:0))*mult;
}

async function syncNow() {
  showToast('Actualizando…');
  // Registrar presencia al sincronizar (evento explícito del apostador)
  _registrarPresencia();
  try {
    await api('/api/v1/bets/sync-resultados/'+_torneoId,{method:'POST'});
    // ESPN verify para partido en vivo: detecta VAR desde comentarios ESPN
    // (API-Football free plan no devuelve eventos individuales en tiempo real)
    const lp = _liveData?.partido;
    if (lp?.id && lp?.estado === 'en_juego') {
      try { await api('/api/v1/bets/espn-verify/'+lp.id); } catch(_) {}
    }
    await Promise.all([loadBracket(), loadLive()]);
    if (_viewAsId) { await loadUserPredictions(_viewAsId); renderScoresTab(); }
    showToast('Actualizado ✓');
  } catch(e) {
    await Promise.all([loadBracket(), loadLive()]);
    showToast('Datos refrescados');
  }
}

// ── Presencia: registra apostador en vivo (login + sync) ────────────────
function _registrarPresencia() {
  if (!_viewAsId) return;
  const alias = _viewAsName || '';
  fetch(`/api/v1/bets/live-presencia?apostador_id=${_viewAsId}&torneo_id=${_torneoId}&alias=${encodeURIComponent(alias)}`,
    {method:'POST', headers:{'ngrok-skip-browser-warning':'true'}}).catch(()=>{});
}

// ── Heartbeat: registra presencia en playoff live ────────────────────────
let _hbTimer = null;
function _startHeartbeat() {
  clearInterval(_hbTimer);
  const ping = () => fetch(`/api/v1/bets/heartbeat?source=playoffs${_viewAsId ? '&viewas_id='+_viewAsId : ''}`, {
    method: 'POST',
    headers: {'Authorization': 'Bearer ' + (_token||''), 'ngrok-skip-browser-warning':'true'},
  }).catch(()=>{});
  ping();  // inmediato
  _hbTimer = setInterval(ping, 30000);
}

function startAutoRefresh() {
  clearInterval(_autoTimer);
  _autoTimer = setInterval(async () => {
    const prevEstado = _liveData?.partido?.estado;
    await Promise.all([loadBracket(), loadLive()]);
    if (_viewAsId) { calcPhaseTotals(); if(_activeTab==='scores') renderScoresTab(); }
    // Si el partido acaba de finalizar, recargar predicciones para actualizar Mi Prono
    const newEstado = _liveData?.partido?.estado;
    if (prevEstado==='en_juego' && newEstado==='finalizado' && _viewAsId) {
      await loadUserPredictions(_viewAsId);
      if (_activeTab==='live' && _activeSubTab==='miprono') renderMiProno(_liveData?.partido);
    }
    if (_activeTab==='live') {
      renderLiveContent();
    }
  }, 30000);
}

// ── USER SELECTOR ─────────────────────────────────────────────────
async function setViewAs(id, name, pts) {
  // Reset estado anterior para garantizar reinicializacion limpia
  _userPreds   = {};
  _rankingData = null;
  _globalesData = null;
  _phaseTotals  = {};
  _viewAsId   = id;
  _viewAsName = name;
  updateComboDisplay(name, pts);
  updateTopbarUser();
  await loadUserPredictions(id);
  renderBracket();
  renderScoresTab();
  // Re-renderizar tab activo con nuevas predicciones
  if (_activeTab === 'live') renderLiveContent();
  if (_activeTab === 'miprono') renderMiProno(_liveData?.partido);
  if (_activeTab === 'apuestas') renderApuestasTab();
  // Invalidar cache globales y recargar si tab activo
  _globalesData = null;
  if (_activeTab === 'globales') loadGlobalesTab();
}

function updateComboDisplay(name, pts) {
  const initials = getInitials(name);
  document.getElementById('sel-avatar').textContent = initials;
  document.getElementById('sel-name').textContent = name||'—';
  document.getElementById('sel-sub').textContent = pts ? pts+' pts totales' : 'Cargando puntos…';
}

function updateTopbarUser() {
  const name = _viewAsName||_myName||'?';
  document.getElementById('tp-avatar').textContent = getInitials(name);
  document.getElementById('tp-name').textContent = name.split(' ')[0];
}

function getInitials(name) {
  if (!name) return '?';
  return name.split(' ').slice(0,2).map(w=>w[0]||'').join('').toUpperCase()||'?';
}

function toggleSelDropdown() {
  _selOpen = !_selOpen;
  document.getElementById('sel-dropdown').classList.toggle('open', _selOpen);
  if (_selOpen) renderSelList('sel-dropdown-list', false);
}

function toggleUserDropdownTopbar() {
  _topbarSelOpen = !_topbarSelOpen;
  document.getElementById('topbar-dropdown').classList.toggle('open', _topbarSelOpen);
  if (_topbarSelOpen) renderSelList('topbar-dropdown-list', true);
}

function renderSelList(containerId, isTopbar) {
  const el = document.getElementById(containerId);
  el.innerHTML = '';
  const sorted = [..._apostadores].sort((a,b)=>(b.puntos_total||0)-(a.puntos_total||0));
  sorted.forEach((ap,i) => {
    const id   = ap.apostador_id||ap.id;
    const name = ap.apostador||ap.alias||ap.nombre||ap.username||'?';
    const pts  = ap.puntos_total||0;
    const active = id===_viewAsId;
    const div = document.createElement('div');
    div.className = 'sel-item'+(active?' active-sel':'');
    div.innerHTML = `
      <div class="sel-item-av">${getInitials(name)}</div>
      <div class="sel-item-name">${name}</div>
      <div class="sel-item-pts">${pts} pts</div>`;
    div.onclick = () => {
      _selOpen = false; _topbarSelOpen = false;
      document.getElementById('sel-dropdown').classList.remove('open');
      document.getElementById('topbar-dropdown').classList.remove('open');
      setViewAs(id, name, pts);
    };
    el.appendChild(div);
  });
}


// ── BRACKET VIEW TOGGLE ───────────────────────────────────────────
let _bracketViewInitScrolled = false;
function setBracketView(v) {
  _bracketView = v;
  document.getElementById('btn-tree-view').classList.toggle('active', v==='tree');
  document.getElementById('btn-list-view').classList.toggle('active', v==='list');
  document.getElementById('bracket-tree-wrap').style.display = v==='tree' ? 'block' : 'none';
  document.getElementById('bracket-list-view').style.display = v==='list' ? 'block' : 'none';
  if (v==='tree') renderBracketTree();
  else renderBracketList();
}

// ── RENDER BRACKET (dispatcher) ───────────────────────────────────
function renderBracket() {
  if (_bracketView === 'tree') renderBracketTree();
  else renderBracketList();
}

// ── RENDER BRACKET TREE (FIFA style) ──────────────────────────────
// Timezone Paraguay: UTC-4 (hora estandar, mantuvieron UTC-4 al abolir DST en sep 2024). Sin Intl.
function _isoToUTC(iso) {
  if (!iso) return iso;
  if (/Z$|[+\-]\d{2}:\d{2}$/.test(iso)) return iso;
  return iso + 'Z';
}
// Formatea fecha ISO usando la zona horaria LOCAL del dispositivo
function fmtFechaCorta(iso) {
  if (!iso) return '';
  const d = new Date(_isoToUTC(iso));
  if (isNaN(d)) return '';
  const dias = ['dom','lun','mar','mié','jue','vie','sáb'];
  const mes  = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  const hh = String(d.getHours()).padStart(2,'0');
  const mm = String(d.getMinutes()).padStart(2,'0');
  return `${dias[d.getDay()]} ${d.getDate()} ${mes[d.getMonth()]} · ${hh}:${mm}`;
}
// "YYYY-MM-DD" en hora local del dispositivo
function _pyDate(d) {
  const dt = typeof d === 'number' ? new Date(d) : d;
  return dt.toLocaleDateString('sv');
}

function getNextMatchNum() {
  const now = Date.now();
  let best = null, bestTime = Infinity;
  for (const m of _bracket) {
    if (m.finalizado) continue;
    if (!m.fecha) continue;
    const t = new Date(_isoToUTC(m.fecha)).getTime();
    if (t > now && t < bestTime) { bestTime = t; best = m.num; }
  }
  return best;
}

function renderBracketTree() {
  // Layout constants
  const S = 136, CW = 128, CH = 68, GAP = 28, PAD_L = 14, PAD_T = 30;
  const CP = CW + GAP;           // column pitch = 156px
  const totalH = 8*S + PAD_T + 30; // bracket height + labels + bottom
  const totalW = 9*CP + PAD_L*2;   // 9 columns

  // Column X left edge
  const colX = (c) => PAD_L + c*CP;

  // Y center of a match by bracket level (0=R32..3=SF) and position n
  const yCenter = (L, n) => PAD_T + Math.pow(2,L)*(n+0.5)*S;
  const yTop    = (L, n) => yCenter(L, n) - CH/2;

  // Bracket positions: {num → {col, yCenter, yTop}}
  const pos = {};
  // Agrupacion correcta segun KO_FEEDERS (izq→P101, der→P102)
  const LEFT  = [[74,77,73,75,83,84,81,82],[89,90,93,94],[97,98],[101]];
  const RIGHT = [[76,78,79,80,86,88,85,87],[91,92,95,96],[99,100],[102]];
  LEFT.forEach((nums, L) => nums.forEach((n,i) => pos[n]={col:L, yc:yCenter(L,i), yt:yTop(L,i)}));
  RIGHT.forEach((nums, L) => nums.forEach((n,i) => pos[n]={col:8-L, yc:yCenter(L,i), yt:yTop(L,i)}));
  pos[104] = {col:4, yc:yCenter(3,0), yt:yTop(3,0)};  // Final (same Y as SF)
  pos[103] = {col:4, yc:yCenter(3,0)+S*2.5, yt:yTop(3,0)+S*2.5};  // 3rd place

  const matchByNum = {};
  for (const m of _bracket) matchByNum[m.num] = m;
  const liveNum = (_liveData?.partido?.estado === 'en_juego') ? _liveData.partido.numero_fifa : null;

  // SVG lines
  const C = '#1e2850';   // connector line color
  let svg = `<svg style="position:absolute;top:0;left:0;width:${totalW}px;height:${totalH}px;pointer-events:none;z-index:0" xmlns="http://www.w3.org/2000/svg">`;

  const rx = (n) => colX(pos[n].col) + CW;   // right edge x of match n
  const lx = (n) => colX(pos[n].col);          // left edge x of match n
  const cy = (n) => pos[n].yc;                // center y of match n

  // Draw pair connector (s1 + s2 → dst), fromRight = true if from right edge
  const pairR = (s1, s2, dst) => {
    if (!pos[s1]||!pos[s2]||!pos[dst]) return;
    const x1=rx(s1), y1=cy(s1), x2=rx(s2), y2=cy(s2), xd=lx(dst), yd=cy(dst);
    const mx = (x1+xd)/2;
    svg += `<line x1="${x1}" y1="${y1}" x2="${mx}" y2="${y1}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
    svg += `<line x1="${x2}" y1="${y2}" x2="${mx}" y2="${y2}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
    svg += `<line x1="${mx}" y1="${y1}" x2="${mx}" y2="${y2}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
    svg += `<line x1="${mx}" y1="${yd}" x2="${xd}" y2="${yd}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
  };
  const pairL = (s1, s2, dst) => {
    if (!pos[s1]||!pos[s2]||!pos[dst]) return;
    const x1=lx(s1), y1=cy(s1), x2=lx(s2), y2=cy(s2), xd=rx(dst), yd=cy(dst);
    const mx = (x1+xd)/2;
    svg += `<line x1="${x1}" y1="${y1}" x2="${mx}" y2="${y1}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
    svg += `<line x1="${x2}" y1="${y2}" x2="${mx}" y2="${y2}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
    svg += `<line x1="${mx}" y1="${y1}" x2="${mx}" y2="${y2}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
    svg += `<line x1="${mx}" y1="${yd}" x2="${xd}" y2="${yd}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
  };
  const single = (src, dst, fromRight) => {
    if (!pos[src]||!pos[dst]) return;
    const x1=fromRight?rx(src):lx(src), y1=cy(src), x2=fromRight?lx(dst):rx(dst), y2=cy(dst);
    svg += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${C}" stroke-width="1.5" stroke-linecap="round"/>`;
  };

  // Left bracket connectors (→ center) — segun KO_FEEDERS
  pairR(74,77,89); pairR(73,75,90);   // R32→R16: Germany/France→P89, Canada/Netherlands→P90
  pairR(83,84,93); pairR(81,82,94);   // R32→R16: Portugal/Spain→P93, USA/Belgium→P94
  pairR(89,90,97); pairR(93,94,98);   // R16→QF
  pairR(97,98,101);                    // QF→SF izq
  single(101,104,true);

  // Right bracket connectors (← center) — segun KO_FEEDERS
  pairL(76,78,91); pairL(79,80,92);   // R32→R16: Brazil/IvoryCoast→P91, Mexico/England→P92
  pairL(86,88,95); pairL(85,87,96);   // R32→R16: Argentina/Australia→P95, Swiss/Colombia→P96
  pairL(91,92,99); pairL(95,96,100);  // R16→QF
  pairL(99,100,102);                   // QF→SF der
  single(102,104,false);

  svg += '</svg>';

  // Column labels
  const LABELS = [{c:0,t:'R32'},{c:1,t:'R16'},{c:2,t:'4tos'},{c:3,t:'Semis'},{c:4,t:'FINAL'},{c:5,t:'Semis'},{c:6,t:'4tos'},{c:7,t:'R16'},{c:8,t:'R32'}];
  let labels = LABELS.map(l=>`<div class="btl" style="left:${colX(l.c)}px;width:${CW}px;top:10px">${l.t}</div>`).join('');

  // Trophy above Final
  const fp = pos[104];
  const trophy = `<div class="bt-center-trophy" style="left:${colX(4)+CW/2-18}px;top:${fp.yt-26}px;width:36px">
    <div class="bt-trophy-icon">🏆</div>
  </div>`;

  // 3rd place label
  const p3 = pos[103];
  const lbl3 = p3 ? `<div class="bt-3p-lbl" style="left:${colX(4)}px;width:${CW}px;top:${p3.yt-13}px">3er Puesto</div>` : '';

  // Build match cards
  let cards = '';
  const allNums = [...Object.keys(pos)].map(Number);
  for (const num of allNums) {
    const p = pos[num];
    if (!p) continue;
    const m = matchByNum[num];
    const x = colX(p.col), y = p.yt;
    const isLive = num === liveNum;
    const tbd = !m || (!m.local && !m.visitante);

    let inner = '';
    if (tbd) {
      inner = `<div class="btc-tbd">Por definir</div>`;
    } else {
      const lWin = m.ganador==='local', vWin = m.ganador==='visitante';
      const done = m.finalizado;
      const lFlag = m.local?.nombre ? flagFor(m.local.nombre) : '', vFlag = m.visitante?.nombre ? flagFor(m.visitante.nombre) : '';
      const sl = (done||m?.en_vivo||isLive) ? (m.gl??'') : '';
      const sv = (done||m?.en_vivo||isLive) ? (m.gv??'') : '';
      const lRow = 'btc-row'+(lWin?' winner':(done&&!lWin?' loser':''));
      const vRow = 'btc-row'+(vWin?' winner':(done&&!vWin?' loser':''));
      const tn = (n, mx=11) => n&&n.length>mx ? n.slice(0,mx-1)+'.' : (n||'?');
      const hasPen = m.pen_l!=null && m.pen_v!=null;

      // Badge: siempre muestra el GANADOR real con color según precisión de la apuesta
      // ✓ Verde = marcador exacto | ✓ Amarillo = ganador correcto | ✗ Rojo = predicción errónea
      let predHtml = '';
      const pred = _userPreds[num];
      if (!done) {
        // Partido pendiente: mostrar score predicho si hay apuesta
        if (pred && _viewAsId) {
          const pl = pred.pred_local ?? null, pv = pred.pred_visitante ?? null;
          if (pl !== null || pv !== null) {
            predHtml = `<div class="btc-pred pend">${pl??'?'}-${pv??'?'}</div>`;
          }
        }
      } else if (lWin || vWin) {
        // Finalizado: mostrar nombre del GANADOR real
        const winnerNm = lWin ? tn(m.local?.nombre) : tn(m.visitante?.nombre);
        if (pred && _viewAsId && (pred.pred_local !== null || pred.pred_visitante !== null)) {
          const pl = pred.pred_local ?? 0, pv = pred.pred_visitante ?? 0;
          const gl = m.gl ?? 0, gv = m.gv ?? 0;
          const hitI = pl === gl && pv === gv;           // marcador exacto
          const hitH = sign(gl - gv) === sign(pl - pv);  // ganador correcto
          if (hitI)      predHtml = `<div class="btc-pred hit">✓ ${winnerNm}</div>`;
          else if (hitH) predHtml = `<div class="btc-pred approx">✓ ${winnerNm}</div>`;
          else           predHtml = `<div class="btc-pred miss">✗ ${winnerNm}</div>`;
        } else {
          predHtml = `<div class="btc-pred pend">→ ${winnerNm}</div>`;
        }
      }

      const penExtra = hasPen ? `<span style="font-size:9px;color:#fbbf24;margin-left:2px">(${m.pen_l}-${m.pen_v})</span>` : '';
      inner = `<div class="${lRow}">
          <span class="btc-flag">${lFlag}</span>
          <span class="btc-name">${tn(m.local?.nombre)}</span>
          <span class="btc-score">${sl}</span>
        </div>
        <div class="${vRow}">
          <span class="btc-flag">${vFlag}</span>
          <span class="btc-name">${tn(m.visitante?.nombre)}</span>
          <span class="btc-score">${sv}</span>
        </div>
        ${hasPen?`<div style="font-size:9px;color:#fbbf24;text-align:center;padding:1px 0">${m.pen_l}–${m.pen_v}</div>`:''}
        ${predHtml}`;
    }
    const isPy = m ? isPyMatch(m.local?.nombre, m.visitante?.nombre) : false;
    const cardCls = 'btc'+(m?.en_vivo===true||isLive?' live':(m?.finalizado?' done':''));
    const fecha = m?.fecha ? fmtFechaCorta(m.fecha) : '';
    const hasFecha = !!fecha && !m?.finalizado;
    const cardH = CH + (m?.pen_l!=null?12:0) + (hasFecha?12:0);

    // Status badge (LIVE or NEXT)
    const hasLive = !!liveNum;
    const nextNum = hasLive ? null : getNextMatchNum();
    let statusBadge = '';
    if (isLive) {
      statusBadge = `<div class="btc-status-badge live" style="left:${x+CW/2}px;top:${y-11}px">🔴 EN VIVO</div>`;
    } else if (!hasLive && num===nextNum) {
      statusBadge = `<div class="btc-status-badge next" style="left:${x+CW/2}px;top:${y-11}px">⏭ PRÓXIMO</div>`;
    }

    // Date in card
    const fechaDiv = hasFecha ? `<div class="btc-fecha">📅 ${fecha}</div>` : '';

    cards += statusBadge;
    cards += `<div class="${cardCls}" style="left:${x}px;top:${y}px;width:${CW}px;height:${cardH}px;position:absolute" onclick="selectMatch(${num},null)">
      <div class="btc-inner">${inner}${fechaDiv}</div>
    </div>`;
  }

  const inner = document.getElementById('bracket-tree-inner');
  inner.style.cssText = `position:relative;width:${totalW}px;height:${totalH}px`;
  inner.innerHTML = svg + labels + trophy + lbl3 + cards;
  if(typeof twemoji!=='undefined'){twemoji.parse(inner,{folder:'svg',ext:'.svg',base:'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/'});}

  // Scroll to center (Final column) on first load
  if (!_bracketViewInitScrolled) {
    _bracketViewInitScrolled = true;
    const wrap = document.getElementById('bracket-tree-wrap');
    const centerX = colX(4) + CW/2;
    const screenW = wrap.clientWidth || 390;
    setTimeout(() => { wrap.scrollLeft = centerX - screenW/2; }, 50);
  }
}

// ── RENDER BRACKET LIST (PHASE VIEW) ────────────────────────────────
function renderBracketList() {
  const byTipo = {};
  for (const m of _bracket) { if (!byTipo[m.tipo]) byTipo[m.tipo]=[]; byTipo[m.tipo].push(m); }

  const liveNum = (_liveData?.partido?.estado === 'en_juego') ? _liveData.partido.numero_fifa : null;
  const hasByPhase = {};
  for (const m of _bracket) if (m.num===liveNum) hasByPhase[m.tipo]=true;

  const pills = document.getElementById('phase-pills');
  pills.innerHTML = '';
  const avail = FASE_ORDER.filter(f=>byTipo[f]?.length);
  if (!avail.length) {
    document.getElementById('match-list').innerHTML='<div class="empty-state"><div class="empty-icon">🏆</div>Sin partidos KO cargados aún</div>';
    return;
  }
  if (!avail.includes(_activePhase)) {
    _activePhase = avail.find(f=>hasByPhase[f])
      || avail.slice().reverse().find(f=>byTipo[f]?.some(m=>m.finalizado))
      || avail[0];
  }

  for (const f of avail) {
    const btn = document.createElement('button');
    btn.className = 'phase-pill'+(f===_activePhase?' active':'')+(hasByPhase[f]?' has-live':'');
    btn.textContent = FASE_PTS[f]?.short||f;
    btn.onclick = ()=>{ _activePhase=f; renderBracketList(); };
    pills.appendChild(btn);
  }

  const cfg = FASE_PTS[_activePhase]||{};
  const ptsBar = document.getElementById('phase-pts-bar');
  ptsBar.innerHTML = `
    <span class="pts-chip">H: ${cfg.h||'?'} pts</span>
    <span class="pts-chip">I: ${cfg.i||'?'} pts</span>
    <span class="pts-chip">J/K/L/M/N: 1 pt</span>
    <span class="pts-chip">O: 2 pts/eq</span>`;

  const matches = (byTipo[_activePhase]||[]).sort((a,b)=>a.num-b.num);
  const list = document.getElementById('match-list');
  list.innerHTML = '';
  if (!matches.length) { list.innerHTML='<div class="empty-state">Sin partidos en esta fase</div>'; return; }

  const hasLiveMatch = !!liveNum;
  const nextNumL = hasLiveMatch ? null : getNextMatchNum();

  for (const m of matches) {
    const isLive = m.num===liveNum;
    const isNext = !hasLiveMatch && m.num===nextNumL;
    const tbd = !m.local && !m.visitante;
    const hasPen = m.pen_l!=null && m.pen_v!=null;
    const isEmpate = m.finalizado && m.gl!=null && m.gv!=null && m.gl===m.gv;
    const lWin = m.ganador==='local', vWin = m.ganador==='visitante';
    const lFlag = m.local?.nombre ? flagFor(m.local.nombre) : '', vFlag = m.visitante?.nombre ? flagFor(m.visitante.nombre) : '';
    const isPy = isPyMatch(m.local?.nombre, m.visitante?.nombre);
    const fecha = m.fecha ? fmtFechaCorta(m.fecha) : '';

    // User prediction for this match
    const pred = _userPreds[m.num];
    const predBadge = buildPredBadge(m, pred, cfg);

    const card = document.createElement('div');
    card.className = 'match-card'+(isLive?' live':'')+(m.finalizado?' done':'');
    card.style.position = 'relative';
    card.dataset.num = m.num;
    card.onclick = ()=>selectMatch(m.num, m);

    const sl = (m.finalizado||m?.en_vivo||isLive) ? (m.gl??'–') : '–';
    const sv = (m.finalizado||m?.en_vivo||isLive) ? (m.gv??'–') : '–';

    card.innerHTML = `
      <div class="match-card-num">P${m.num}</div>
      ${isLive?'<div class="match-card-live-badge"><div class="live-dot"></div> LIVE</div>':''}
      ${isNext?'<div class="match-card-next-badge">⏭ Próximo</div>':''}
      ${isPy?'<div class="match-py-badge">🇵🇾 ×2</div>':''}
      ${tbd?`<div class="match-tbd">Por definir</div>`:`
        <div class="match-team-row">
          <div class="mtr-flag">${lFlag}</div>
          <div class="mtr-name">${m.local?.nombre||'?'}</div>
          <div class="mtr-score ${lWin?'winner':(m.finalizado&&!lWin?'loser':'')}">${sl}</div>
        </div>
        <div class="match-team-row">
          <div class="mtr-flag">${vFlag}</div>
          <div class="mtr-name">${m.visitante?.nombre||'?'}</div>
          <div class="mtr-score ${vWin?'winner':(m.finalizado&&!vWin?'loser':'')}">${sv}</div>
        </div>
        ${hasPen?`<div class="match-pen-row">🥅 Pen. ${m.local?.nombre||''} ${m.pen_l}–${m.pen_v} ${m.visitante?.nombre||''}</div>`:''}
        ${isEmpate&&!hasPen?`<div class="match-pen-row" style="color:#9ca3af">Empate — tanda pendiente</div>`:''}
      `}
      ${predBadge ? `<div class="pred-badge">${predBadge}</div>` : ''}
      <div class="match-venue-row">
        ${m.ciudad ? `<span class="match-venue">📍 ${m.ciudad}${m.sede ? ` · ${m.sede}` : ''}</span>` : ''}
        ${fecha && !m.finalizado ? `<span class="match-fecha-lbl" style="font-size:9px;color:#4b5563">📅 ${fecha}</span>` : ''}
      </div>
    `;
    list.appendChild(card);
  }
  const _blv=document.getElementById('bracket-list-view');if(_blv&&typeof twemoji!=='undefined'){twemoji.parse(_blv,{folder:'svg',ext:'.svg',base:'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/'});}
}

function buildPredBadge(m, pred, cfg) {
  if (!pred || !_viewAsId) return '';
  const gl=m.gl??null, gv=m.gv??null;
  const pl=pred.pred_local??null, pv=pred.pred_visitante??null;
  if (pl===null && pv===null) return '';
  const hitH = gl!==null&&gv!==null&&pl!==null&&pv!==null&&sign(gl-gv)===sign(pl-pv);
  const hitI = gl!==null&&gv!==null&&pl===gl&&pv===gv;
  const pending = gl===null;
  if (pending) return `<span class="pb-item pb-pend">${pl}–${pv}</span>`;
  if (hitI) return `<span class="pb-item pb-hit">✓ Pleno</span>`;
  if (hitH) return `<span class="pb-item pb-hit">✓ Res.</span><span class="pb-item pb-pend">${pl}–${pv}</span>`;
  return `<span class="pb-item pb-miss">✗ ${pl}–${pv}</span>`;
}

function selectMatch(num, matchObj) {
  _selectedMatchNum = num;
  setTab('miprono');
  setTimeout(function(){ _scrollToMpCard(num); }, 90);
}

// ── RENDER SCORES TAB ─────────────────────────────────────────────
let _rankingData   = null;
let _aliasMap      = {};
let _matrixLoading = false;

function renderScoresTab() {
  if (!_rankingData && !_matrixLoading) loadRankingMatrix();
  else if (_rankingData) renderScoresMatrix();

  if (_viewAsId && _rankingData) {
    const detail = document.getElementById('scores-apostador-detail');
    if (detail) detail.style.display = 'block';
    renderScoresItemBreakdown();
  }
}

async function loadRankingMatrix() {
  _matrixLoading = true;
  const wrap = document.getElementById('scores-matrix-wrap');
  if (wrap) wrap.innerHTML = '<div class="sc-loading">Cargando ranking...</div>';
  try {
    const [rResp, aResp] = await Promise.all([
      api('/api/v1/bets/ranking/' + _torneoId),
      api('/api/v1/bets/apostadores')
    ]);
    const rData = await rResp.json();
    const aData = await aResp.json();
    _aliasMap = {};
    for (const ap of aData) _aliasMap[ap.id] = ap.alias || ap.username || '?';
    _rankingData = rData.ranking || rData || [];
    _matrixLoading = false;
    renderScoresMatrix();
  } catch(e) {
    _matrixLoading = false;
    if (wrap) wrap.innerHTML = '<div class="sc-loading" style="color:#f87171">Error: ' + e.message + '</div>';
  }
}

async function refreshScoresMatrix() {
  _rankingData = null;
  await loadRankingMatrix();
}

function renderScoresMatrix() {
  if (_scoresMode === 'items') { renderScoresMatrixItems(); return; }
  renderScoresMatrixFase();
}

function renderScoresMatrixFase() {
  const wrap = document.getElementById('scores-matrix-wrap');
  if (!wrap || !_rankingData) return;

  // Helper: suma pts de las fases cuyo tipo contiene alguna de las claves dadas
  function phasePts(r, keys) {
    if (!r.fases || !r.fases.length) return 0;
    return r.fases.filter(f => keys.some(k => (f.tipo||'').includes(k)))
                  .reduce((s, f) => s + (f.pts || 0), 0);
  }

  // Columnas: fase de grupos + cada fase KO + globales
  const COLS = [
    { lbl:'Grupos',  ttl:'Grupos (H-N \xb7 todas las fases de grupo)',
      fn: r => phasePts(r, ['grupo']) + (r.pts_grupos_p || 0) },
    { lbl:'R32',     ttl:'Ronda de 32',    fn: r => phasePts(r, ['ronda32']) },
    { lbl:'8vos',    ttl:'Octavos de Final',fn: r => phasePts(r, ['ronda16']) },
    { lbl:'4tos',    ttl:'Cuartos de Final',fn: r => phasePts(r, ['cuartos']) },
    { lbl:'Semis',   ttl:'Semifinales',     fn: r => phasePts(r, ['semis']) },
    { lbl:'Final',   ttl:'3er Puesto + Final',
      fn: r => phasePts(r, ['tercer_puesto','final']) },
    { lbl:'🌐', ttl:'Globales A-G', fn: r => r.pts_globales || 0 },
  ];

  const sorted = [..._rankingData].sort((a,b)=>(b.puntos_total||0)-(a.puntos_total||0));

  let ths = COLS.map(c=>'<th class="sc-th sc-th-item" title="'+c.ttl+'">'+c.lbl+'</th>').join('');
  let html = '<div class="sc-tbl-wrap"><table class="sc-tbl"><thead>'
    + '<tr><th class="sc-th sc-th-rank">#</th><th class="sc-th sc-th-apos">Apostador</th>'
    + ths
    + '<th class="sc-th sc-th-total">Total</th></tr>'
    + '</thead><tbody>';

  sorted.forEach(function(r, i) {
    const alias = _aliasMap[r.apostador_id] || '?';
    const isMe  = r.apostador_id === _viewAsId;
    let cells = '';
    COLS.forEach(function(c) {
      const v = c.fn(r);
      const cl = v > 0 ? 'sc-td sc-td-pos' : 'sc-td sc-td-zero';
      cells += '<td class="' + cl + '">' + (v > 0 ? v : '') + '</td>';
    });
    const total = r.puntos_total || 0;
    html += '<tr class="sc-tr' + (isMe ? ' sc-tr-me' : '') + '" onclick="selectAposFromMatrix(' + r.apostador_id + ',\'' + alias + '\',' + total + ')">'
      + '<td class="sc-td sc-td-rank">' + (i+1) + '</td>'
      + '<td class="sc-td sc-td-apos">' + alias + '</td>'
      + cells
      + '<td class="sc-td sc-td-total">' + total + '</td>'
      + '</tr>';
  });

  html += '</tbody></table></div>';
  wrap.innerHTML = html;
}

function renderScoresMatrixItems() {
  const wrap = document.getElementById('scores-matrix-wrap');
  if (!wrap || !_rankingData) return;

  const ITEM_COLS = [
    { lbl:'H', ttl:'Resultado',        fn: r => r.cat_resultado       || 0 },
    { lbl:'I', ttl:'Marcador exacto',  fn: r => r.cat_marcador        || 0 },
    { lbl:'J', ttl:'Amarillas',        fn: r => r.cat_amarillas       || 0 },
    { lbl:'K', ttl:'Rojas',            fn: r => r.cat_rojas           || 0 },
    { lbl:'L', ttl:'VAR',              fn: r => r.cat_var             || 0 },
    { lbl:'M', ttl:'Penales en juego', fn: r => r.cat_penales_partido || 0 },
    { lbl:'N', ttl:'Minuto del gol',   fn: r => r.cat_minuto          || 0 },
    { lbl:'O', ttl:'Penales tanda',    fn: r => r.cat_penales_tanda   || 0 },
    { lbl:'<b class="ib ib-32">32</b>', ttl:'P Grupos — Clasificados R32', fn: r => (r.pts_grupos_p||0) },
    { lbl:'<b class="ib ib-ko">KO</b>', ttl:'P KO — Clasifica por fase',     fn: r => (r.cat_equipo||0) },
    { lbl:'A', ttl:'Campeon mundial',  fn: r => (r.globales_detalle?.a) || 0 },
    { lbl:'B', ttl:'Finalistas',       fn: r => (r.globales_detalle?.b) || 0 },
    { lbl:'C', ttl:'Goleador',         fn: r => (r.globales_detalle?.c) || 0 },
    { lbl:'D', ttl:'Peor equipo',      fn: r => (r.globales_detalle?.d) || 0 },
    { lbl:'E', ttl:'Mayor goleada',    fn: r => (r.globales_detalle?.e) || 0 },
    { lbl:'F', ttl:'Etapa Paraguay',   fn: r => (r.globales_detalle?.f) || 0 },
    { lbl:'G', ttl:'Goles Paraguay',   fn: r => (r.globales_detalle?.g) || 0 },
    { lbl:'🌐', ttl:'Total Globales A-G', fn: r => r.pts_globales || 0 },
  ];

  // Split headers: partido items (H-P) vs globales (A-G + Glob)
  const PART_COLS  = ITEM_COLS.slice(0, 9);   // H..P
  const GLOB_COLS  = ITEM_COLS.slice(9);       // A..G + Glob

  const sorted = [..._rankingData].sort((a,b) => (b.puntos_total||0) - (a.puntos_total||0));

  let ths = '';
  ITEM_COLS.forEach(function(c) {
    ths += '<th class="sc-th sc-th-item sc-th-sm" title="' + c.ttl + '">' + c.lbl + '</th>';
  });

  let html = '<div class="sc-tbl-wrap"><table class="sc-tbl"><thead>'
    + '<tr>'
    + '<th class="sc-th sc-th-rank">#</th>'
    + '<th class="sc-th sc-th-apos">Apostador</th>'
    + '<th class="sc-th sc-th-item sc-th-sep" colspan="9" title="Partidos H-P" style="text-align:center;font-size:10px;color:#60a5fa;border-right:2px solid #1e3a5f;">&#8212; Partidos &#8212;</th>'
    + '<th class="sc-th sc-th-item sc-th-sep" colspan="8" title="Globales A-G" style="text-align:center;font-size:10px;color:#a78bfa;">&#8212; Globales &#8212;</th>'
    + '<th class="sc-th sc-th-total">Total</th>'
    + '</tr>'
    + '<tr>'
    + '<th class="sc-th sc-th-rank"></th>'
    + '<th class="sc-th sc-th-apos"></th>'
    + ths
    + '<th class="sc-th sc-th-total"></th>'
    + '</tr>'
    + '</thead><tbody>';

  sorted.forEach(function(r, i) {
    const alias = _aliasMap[r.apostador_id] || '?';
    const isMe  = r.apostador_id === _viewAsId;
    let cells = '';
    ITEM_COLS.forEach(function(c, ci) {
      const v = c.fn(r);
      // Add separator border before A (index 9 = start of globales)
      const sepStyle = ci === 9 ? ' style="border-left:2px solid #1e3a5f;"' : '';
      const cl = v > 0 ? 'sc-td sc-td-pos sc-td-sm' : 'sc-td sc-td-zero sc-td-sm';
      cells += '<td class="' + cl + '"' + sepStyle + '>' + (v > 0 ? v : '') + '</td>';
    });
    const total = r.puntos_total || 0;
    html += '<tr class="sc-tr' + (isMe ? ' sc-tr-me' : '') + '" onclick="selectAposFromMatrix(' + r.apostador_id + ',\'' + alias + '\',' + total + ')">'
      + '<td class="sc-td sc-td-rank">' + (i+1) + '</td>'
      + '<td class="sc-td sc-td-apos">' + alias + '</td>'
      + cells
      + '<td class="sc-td sc-td-total">' + total + '</td>'
      + '</tr>';
  });

  html += '</tbody></table></div>';
  wrap.innerHTML = html;
}

async function selectAposFromMatrix(uid, alias, pts) {
  _viewAsId   = uid;
  _viewAsName = alias;
  updateComboDisplay(alias, pts);
  updateTopbarUser();
  await loadUserPredictions(uid);
  renderBracket();
  const detail = document.getElementById('scores-apostador-detail');
  if (detail) {
    detail.style.display = 'block';
    renderScoresItemBreakdown();
    detail.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
  renderScoresMatrix();
}

function renderScoresItemBreakdown() {
  const grid = document.getElementById('sc-items-grid');
  if (!grid || !_rankingData) return;
  const row = _rankingData.find(r => r.apostador_id === _viewAsId);
  if (!row) { grid.innerHTML = ''; return; }

  const alias = _aliasMap[_viewAsId] || _viewAsName || '?';
  const g = row.globales_detalle || {};
  const ITEMS = [
    { icon:'\u26BD',        lbl:'H \u2014 Resultado',       pts: row.cat_resultado       || 0 },
    { icon:'\uD83C\uDFAF', lbl:'I \u2014 Marcador exacto', pts: row.cat_marcador        || 0 },
    { icon:'\uD83D\uDFE8', lbl:'J \u2014 Amarillas',       pts: row.cat_amarillas       || 0 },
    { icon:'\uD83D\uDFE5', lbl:'K \u2014 Rojas',           pts: row.cat_rojas           || 0 },
    { icon:'\uD83D\uDCFA', lbl:'L \u2014 VAR',             pts: row.cat_var             || 0 },
    { icon:'\uD83E\uDD45', lbl:'M \u2014 Penales en juego',pts: row.cat_penales_partido || 0 },
    { icon:'\u23F1',        lbl:'N \u2014 Minuto del gol',  pts: row.cat_minuto          || 0 },
    { icon:'🥅',  lbl:'O \u2014 Penales tanda',   pts: row.cat_penales_tanda           || 0 },
    { icon:'<b class="ib ib-32">32</b>', lbl:'P R32',     pts: (row.pts_grupos_p||0) },
    { icon:'<b class="ib ib-ko">KO</b>', lbl:'P KO',      pts: (row.cat_equipo||0) },
  ];
  // Globales A-G individuales (solo los que tienen pts > 0 OR todos si hay alguno)
  const GLOB_ITEMS = [
    { lbl:'A \u2014 Campe\xf3n',        pts: g.a||0 },
    { lbl:'B \u2014 Finalistas',          pts: g.b||0 },
    { lbl:'C \u2014 Goleador',            pts: g.c||0 },
    { lbl:'D \u2014 Peor equipo',         pts: g.d||0 },
    { lbl:'E \u2014 Mayor goleada',       pts: g.e||0 },
    { lbl:'F \u2014 Etapa Paraguay',      pts: g.f||0 },
    { lbl:'G \u2014 Goles Paraguay',      pts: g.g||0 },
  ];
  const ptsGlob = row.pts_globales || 0;
  const total = row.puntos_total || 0;

  function itemRow(icon, lbl, pts) {
    const cls = pts === 0 ? ' zero' : '';
    return `<div class="sc-ig-row">
      <div class="sc-ig-left">
        ${icon ? `<span class="sc-ig-icon">${icon}</span>` : '<span class="sc-ig-icon" style="font-size:12px;color:#475569">🌐</span>'}
        <span class="sc-ig-lbl">${lbl}</span>
      </div>
      <span class="sc-ig-pts${cls}">${pts}</span>
    </div>`;
  }

  let partRows = ITEMS.map((it, idx) => {
    // Insert "Definición por penales" separator before O (idx=7) and P is after
    const sep = (idx === 7) ? `<div class="sc-ig-section-hdr" style="font-size:10px;font-weight:700;color:#60a5fa;text-transform:uppercase;letter-spacing:.8px;padding:4px 10px 2px;background:#060c18;border-top:1px solid #0f1225;border-bottom:1px solid #0f1225">⚽ Definición por penales</div>` : '';
    return sep + itemRow(it.icon, it.lbl, it.pts);
  }).join('');

  // Globales section
  let globRows = '';
  if (ptsGlob > 0 || GLOB_ITEMS.some(x => x.pts > 0)) {
    globRows = `<div class="sc-ig-section-hdr">\uD83C\uDF10 Globales A\u2013G</div>`;
    globRows += GLOB_ITEMS.map(it => itemRow('', it.lbl, it.pts)).join('');
  }

  grid.innerHTML = `<div class="sc-ig-wrap">
    <div class="sc-ig-title">Desglose \u2014 <span class="sc-ig-alias">${alias}</span></div>
    ${partRows}
    ${globRows}
    <div class="sc-ig-total-row">
      <span class="sc-ig-total-lbl">Total</span>
      <span class="sc-ig-total-pts">${total}</span>
    </div>
  </div>`;
}

function renderScoresBreakdown() {
  if (!_viewAsId || !_apostadores.length) return;
  const me = _apostadores.find(a=>(a.apostador_id||a.id)===_viewAsId);
  if (!me) return;

  const ptsGlob0 = me.acum?.subtotal_globales || 0;
  const ptsPD    = me.acum?.pts_D || 0;
  const ptsGP    = me.grupos_p?.pts || 0;
  const ptsGlob  = ptsGlob0 - ptsPD;
  const ptsTotal = (me.puntos_total||0) + ptsGP;

  const FASE_LABELS = {
    ronda32:'R32 · 16avos', ronda16:'8vos de Final',
    cuartos:'Cuartos de Final', semis:'Semifinales',
    tercer_puesto:'3er Puesto', final:'Final'
  };

  let bdiv = document.getElementById('sb-breakdown-section');
  if (!bdiv) {
    bdiv = document.createElement('div');
    bdiv.id = 'sb-breakdown-section';
    bdiv.className = 'sb-breakdown';
    const anchor = document.getElementById('sb-breakdown-anchor');
    if (anchor) {
      anchor.innerHTML = '';
      anchor.appendChild(bdiv);
    } else {
      const phSection = document.getElementById('phase-chips-section');
      if (phSection && phSection.parentNode) {
        phSection.parentNode.insertBefore(bdiv, phSection.nextSibling);
      }
    }
  }

  if (ptsTotal === 0 && ptsGP === 0 && ptsGlob0 === 0) { bdiv.style.display='none'; return; }
  bdiv.style.display = 'block';

  let fasesRows = '', totalKO = 0;
  for (const fase of ['ronda32','ronda16','cuartos','semis','tercer_puesto','final']) {
    const pts = _phaseTotals[fase];
    if (pts === undefined) continue;
    totalKO += pts;
    const col = pts > 0 ? 'color:#86efac' : 'color:#374151';
    fasesRows += `<div class="sb-bk-row">
      <span class="sb-bk-lbl" style="padding-left:10px;font-size:11px">${FASE_LABELS[fase]||fase}</span>
      <span class="sb-bk-pts" style="${col}">${pts}</span>
    </div>`;
  }

  bdiv.innerHTML = `
    <div class="sb-breakdown-title">Desglose de puntos</div>
    ${ptsGP>0?`<div class="sb-bk-row">
      <span class="sb-bk-lbl">🏟️ Grupos — P (clasificados R32)</span>
      <span class="sb-bk-pts" style="color:#fbbf24">${ptsGP}</span>
    </div>`:''}
    ${fasesRows?`<div class="sb-bk-row" style="margin-top:6px;border-top:1px solid #1a2240">
      <span class="sb-bk-lbl" style="font-weight:700;color:#64748b">⚽ Playoffs (H–O)</span>
      <span class="sb-bk-pts" style="color:#64748b">${totalKO}</span>
    </div>${fasesRows}`:''}
    ${ptsPD>0?`<div class="sb-bk-row" style="border-top:1px solid #1a2240">
      <span class="sb-bk-lbl">🐢 D — Peor equipo</span>
      <span class="sb-bk-pts" style="color:#f97316">${ptsPD}</span>
    </div>`:''}
    ${ptsGlob>0?`<div class="sb-bk-row">
      <span class="sb-bk-lbl">🌐 Globales A-G</span>
      <span class="sb-bk-pts" style="color:#93c5fd">${ptsGlob}</span>
    </div>`:''}
    <div class="sb-bk-row" style="border-top:2px solid #1e3a5f;margin-top:4px">
      <span class="sb-bk-total-lbl">TOTAL</span>
      <span class="sb-bk-total">${ptsTotal}</span>
    </div>`;
}

function renderVsTop3() {
  const sorted = [..._apostadores].sort((a,b)=>(b.puntos_total||0)-(a.puntos_total||0));
  const meIdx = sorted.findIndex(a=>(a.apostador_id||a.id)===_viewAsId);
  const meEntry = sorted[meIdx];
  const meTotal = meEntry?.puntos_total||0;
  const leader  = sorted[0]?.puntos_total||1;

  document.getElementById('vs-total-lbl').textContent = meTotal+' pts';

  const top3 = sorted.slice(0,3);
  const cards = document.getElementById('vs-cards');
  cards.innerHTML = '';

  const medals = ['🥇','🥈','🥉'];
  const goldStyle = ['gold','',''];

  top3.forEach((ap,i) => {
    const pts = ap.puntos_total||0;
    const nm  = ap.apostador||ap.alias||ap.nombre||ap.username||'?';
    const isMe = (ap.apostador_id||ap.id)===_viewAsId;
    const div = document.createElement('div');
    div.className = 'vs-card '+(i===0?'gold':'');
    const pct = Math.round((pts/leader)*100);
    const c = i===0?'#fbbf24':(i===1?'#888':(i===2?'#a07040':'#60a5fa'));
    div.innerHTML = `
      <div class="vs-medal">${medals[i]}</div>
      <div class="vs-info">
        <div class="vs-nm" style="color:${c}">${nm}${isMe?' <span style="font-size:10px;color:#3b82f6">tú</span>':''}</div>
        <div class="vs-bar-wrap"><div class="vs-bar-fill" style="width:${pct}%;background:${c}"></div></div>
      </div>
      <div class="vs-pts" style="color:${c}">${pts}</div>`;
    cards.appendChild(div);
  });

  // me (if not in top 3)
  if (meIdx >= 3) {
    const sep = document.createElement('div');
    sep.className='vs-card sep';
    sep.innerHTML='<span style="color:#2a2f45">• • •</span>';
    cards.appendChild(sep);

    const meDiv = document.createElement('div');
    meDiv.className='vs-card me';
    const pct=Math.round((meTotal/leader)*100);
    meDiv.innerHTML=`
      <div class="vs-medal" style="font-size:15px;color:#9ca3af">#${meIdx+1}</div>
      <div class="vs-info">
        <div class="vs-nm" style="color:#93c5fd">${_viewAsName} <span style="font-size:10px;color:#3b82f6">tú</span></div>
        <div class="vs-bar-wrap"><div class="vs-bar-fill" style="width:${pct}%;background:#3b82f6"></div></div>
      </div>
      <div class="vs-pts" style="color:#93c5fd">${meTotal}</div>`;
    cards.appendChild(meDiv);
  }
}

function renderPhaseChips() {
  const row = document.getElementById('phase-chips-row');
  row.innerHTML = '';
  const liveNum = (_liveData?.partido?.estado === 'en_juego') ? _liveData.partido.numero_fifa : null;
  const liveTipo = (_liveData?.partido?.estado === 'en_juego') ? _liveData.partido.fase_tipo : null;

  for (const fase of FASE_ORDER) {
    const hasPh = _bracket.some(m=>m.tipo===fase);
    if (!hasPh) continue;
    const cfg = FASE_PTS[fase]||{};
    const isLive = fase===liveTipo;
    const isDone = _bracket.filter(m=>m.tipo===fase).some(m=>m.finalizado);
    const pts = _phaseTotals[fase];
    const hasData = pts!==undefined;

    const chip = document.createElement('div');
    chip.className = 'phase-chip'+(isDone&&!isLive?' done':'')+(isLive?' live-phase':'')+(fase===_activePhase?' active-phase':'');
    chip.innerHTML = `
      <div class="phase-chip-label">${cfg.short||fase}</div>
      <div class="phase-chip-sub">H=${cfg.h||'?'}</div>
      <div class="phase-chip-pts">${hasData?pts:'–'}</div>
      <div class="phase-chip-of">${hasData?'pts':''}</div>`;
    chip.onclick = ()=>{ _activePhase=fase; renderBracket(); setTab('bracket'); };
    row.appendChild(chip);
  }
}

function renderMatchDetail(m) {
  if (!m) return;
  const hint = document.getElementById('scores-hint');
  const section = document.getElementById('match-detail-section');
  if (hint) hint.style.display = 'none';
  if (!section) return;
  section.style.display = 'block';

  const liveNum     = (_liveData?.partido?.estado === 'en_juego') ? _liveData.partido.numero_fifa : null;
  const isLive      = m.num===liveNum || m.en_vivo===true;
  const isNotStarted = !m.finalizado && !isLive;
  const cfg         = FASE_PTS[m.tipo]||{h:4,i:8};
  const lName       = m.local?.nombre||'?';
  const vName       = m.visitante?.nombre||'?';
  const gl          = m.gl??null;
  const gv          = m.gv??null;
  const hasPen      = m.pen_l!=null && m.pen_v!=null;
  const locS        = lName.slice(0,8);
  const visS        = vName.slice(0,8);

  // Phase label
  document.getElementById('md-phase-lbl').textContent = (cfg.label||m.tipo)+' · P'+m.num;
  const liveChip = document.getElementById('md-live-chip');
  liveChip.style.display = isLive?'inline':'none';

  // Scoreboard
  const sb = document.getElementById('md-scoreboard');
  const pred = _userPreds[m.num];
  const noPred = !pred || (pred.pred_local===null && pred.pred_visitante===null);
  const predDisp = noPred ? '?–?' : `${pred.pred_local??'?'} – ${pred.pred_visitante??'?'}`;
  const scoreDisp  = (m.finalizado||isLive||m.en_vivo) ? `${gl??'–'}` : '–';
  const scoreDispV = (m.finalizado||isLive||m.en_vivo) ? `${gv??'–'}` : '–';
  const periodCls  = isLive ? 'sp-live' : (m.finalizado?'sp-done':'');
  const periodTxt  = isLive
    ? (_liveData?.partido?.minuto_actual||'?')+"'"
    : (m.finalizado ? 'Final'
       : (m.fecha ? `📅 ${fmtFechaCorta(m.fecha)}` : 'Próximo'));

  sb.innerHTML = `
    <div class="md-sb-phase">${cfg.short||m.tipo} · ${isLive?'<span style="color:#ef4444">EN VIVO</span>':''}</div>
    ${isLive?`<div class="md-sb-live-bar"><div class="live-dot"></div> Partido en curso</div>`:''}
    <div class="md-sb-teams">
      <div class="md-team">
        <div class="md-flag">${flagFor(lName)}</div>
        <div class="md-tname">${lName}</div>
      </div>
      <div class="md-score-box">
        <div class="md-score">${scoreDisp} – ${scoreDispV}</div>
        <div class="md-period"><span class="score-period ${periodCls}" style="font-size:11px">${periodTxt}</span></div>
        ${hasPen?`<div style="font-size:12px;color:#fbbf24;margin-top:6px">Pen: ${m.pen_l}–${m.pen_v}</div>`:''}
      </div>
      <div class="md-team">
        <div class="md-flag">${flagFor(vName)}</div>
        <div class="md-tname">${vName}</div>
      </div>
    </div>
    <div class="md-pred-row">Tu predicción: <span>${predDisp}</span></div>`;

  // Items breakdown
  const itemsEl = document.getElementById('md-items');
  itemsEl.innerHTML = '';

  // Live data for current match — priority chain: live > pred (has real values) > m
  let livePart = isLive ? _liveData?.partido : null;
  const rAmar = livePart?.amarillas ?? pred?.amarillas ?? m.amarillas ?? null;
  const rRojas = livePart?.rojas ?? pred?.rojas ?? m.rojas ?? null;
  const rVar   = livePart?.decisiones_var ?? pred?.decisiones_var ?? m.decisiones_var ?? null;
  const rPP    = livePart?.penales_partido ?? pred?.penales_partido ?? m.penales_partido ?? null;
  const rMinG  = livePart?.minuto_primer_gol ?? pred?.minuto_primer_gol ?? m.minuto_primer_gol ?? null;

  const mult = isPyMatch(lName,vName) ? 2 : 1;

  // Hits — only meaningful when not isNotStarted
  const hitH  = !isNotStarted && gl!==null&&gv!==null&&pred?.pred_local!=null&&pred?.pred_visitante!=null && sign(gl-gv)===sign(pred.pred_local-pred.pred_visitante);
  const hitI  = !isNotStarted && gl!==null&&gv!==null && pred?.pred_local===gl&&pred?.pred_visitante===gv;
  const hitJ  = !isNotStarted && rAmar!==null&&pred?.pred_amarillas!=null && rAmar===pred.pred_amarillas;
  const hitK  = !isNotStarted && rRojas!==null&&pred?.pred_rojas!=null && rRojas===pred.pred_rojas;
  const hitL  = !isNotStarted && rVar!==null&&pred?.pred_var!=null && rVar===pred.pred_var;
  const hitM  = !isNotStarted && rPP!==null&&pred?.pred_penales_partido!=null && rPP===pred.pred_penales_partido;
  const hitN  = !isNotStarted && rMinG!==null&&pred?.pred_minuto_gol!=null && rMinG===pred.pred_minuto_gol;
  const hitOl = !isNotStarted && m.pen_l!=null && pred?.pred_penales_local_tanda!=null && m.pen_l===pred.pred_penales_local_tanda;
  const hitOv = !isNotStarted && m.pen_v!=null && pred?.pred_penales_visitante_tanda!=null && m.pen_v===pred.pred_penales_visitante_tanda;

  // Items — icons instead of letters, tanda split into Ol/Ov
  const items = [
    {icon:'⚽',nm:'Resultado',
      real: isNotStarted?'–':(gl!==null?resStr(gl,gv):'–'),
      pdv:  noPred?'–':(pred?.pred_local!=null?resStr(pred.pred_local,pred.pred_visitante):'?'),
      hit:hitH, pend:isNotStarted||gl===null, pts:(hitH?cfg.h:0)*mult, max:cfg.h*mult},
    {icon:'🎯',nm:'Marcador',
      real: isNotStarted?'–':(gl!==null?`${gl}–${gv}`:'–'),
      pdv:  noPred?'–':(pred?.pred_local!=null?`${pred.pred_local}–${pred.pred_visitante}`:'?'),
      hit:hitI, pend:isNotStarted||gl===null, pts:(hitI?cfg.i:0)*mult, max:cfg.i*mult},
    {icon:'🟨',nm:'Amarillas',
      real: isNotStarted?'–':(rAmar!==null?rAmar:'–'),
      pdv:  noPred?'–':(pred?.pred_amarillas??'?'),
      hit:hitJ, pend:isNotStarted||rAmar===null, pts:(hitJ?1:0)*mult, max:1*mult},
    {icon:'🟥',nm:'Rojas',
      real: isNotStarted?'–':(rRojas!==null?rRojas:'–'),
      pdv:  noPred?'–':(pred?.pred_rojas??'?'),
      hit:hitK, pend:isNotStarted||rRojas===null, pts:(hitK?1:0)*mult, max:1*mult},
    {icon:'📺',nm:'VAR',
      real: isNotStarted?'–':(rVar!==null?rVar:'–'),
      pdv:  noPred?'–':(pred?.pred_var??'?'),
      hit:hitL, pend:isNotStarted||rVar===null, pts:(hitL?1:0)*mult, max:1*mult},
    {icon:'🥅',nm:'Pen. juego',
      real: isNotStarted?'–':(rPP!==null?rPP:'–'),
      pdv:  noPred?'–':(pred?.pred_penales_partido??'?'),
      hit:hitM, pend:isNotStarted||rPP===null, pts:(hitM?1:0)*mult, max:1*mult},
    {icon:'⏱',nm:'Min. gol',
      real: isNotStarted?'–':(rMinG!==null?rMinG+"'":'–'),
      pdv:  noPred?'–':(pred?.pred_minuto_gol!=null?pred.pred_minuto_gol+"'":'?'),
      hit:hitN, pend:isNotStarted||rMinG===null, pts:(hitN?1:0)*mult, max:1*mult},
    // Ol/Ov: only include when real tanda data exists
    ...(m.pen_l!=null ? [
      {icon:'🥅L',nm:`Tanda ${locS}`,
        real: m.pen_l,
        pdv:  noPred?'–':(pred?.pred_penales_local_tanda??'?'),
        hit:hitOl, pend:false, pts:(hitOl?2:0)*mult, max:2*mult},
      {icon:'🥅V',nm:`Tanda ${visS}`,
        real: m.pen_v,
        pdv:  noPred?'–':(pred?.pred_penales_visitante_tanda??'?'),
        hit:hitOv, pend:false, pts:(hitOv?2:0)*mult, max:2*mult},
    ] : []),
  ];

  let totalPts = 0, totalMax = 0;
  for (const it of items) {
    totalPts += it.pts;
    if (!it.pend) totalMax += it.max;
    const cls = it.pend?'pend':(it.hit?'hit':'miss');
    const div = document.createElement('div');
    div.className = 'item-row '+cls;
    div.innerHTML = `
      <div class="item-letter" style="font-size:18px">${it.icon}</div>
      <div class="item-name">${it.nm}</div>
      <div class="item-vals">
        <div class="item-real">Real: <span>${it.real}</span></div>
        <div class="item-pred">→ <span>${it.pdv}</span></div>
      </div>
      <div class="item-pts">${it.pts>0?'+'+it.pts:(it.pend?'…':'0')}</div>`;
    itemsEl.appendChild(div);
  }

  if (mult>1) {
    const pyNote = document.createElement('div');
    pyNote.style.cssText='text-align:center;font-size:12px;color:#22c55e;padding:4px 0 8px';
    pyNote.textContent='🇵🇾 Paraguay · todos los ítems ×2';
    itemsEl.appendChild(pyNote);
  }

  // Footer note
  const noteDiv = document.createElement('div');
  noteDiv.style.cssText='text-align:center;font-size:11px;color:#9ca3af;padding:6px 0 2px';
  if (isNotStarted) {
    noteDiv.textContent = noPred
      ? 'Sin predicción registrada para este partido'
      : 'Partido pendiente — puntos se calcularán al finalizar';
  }
  if (noteDiv.textContent) itemsEl.appendChild(noteDiv);

  const totalEl = document.getElementById('md-total');
  if (isNotStarted) {
    totalEl.style.display='none';
  } else {
    totalEl.style.display='flex';
    document.getElementById('md-total-pts').textContent='+'+totalPts;
    document.getElementById('md-total-of').textContent = isLive
      ? '~ simulado (parcial)'
      : 'de ~'+totalMax+' posibles este partido';
  }
}

function resStr(gl,gv) {
  if (gl==null||gv==null) return '?';
  if (gl>gv) return 'Local gana';
  if (gv>gl) return 'Visita gana';
  return 'Empate';
}


// ── Utilidad de banderas (global) ────────────────────────────────────
function flagFromIso(iso) {
  if (!iso) return '';
  const isoUp = iso.toUpperCase();
  // GB subdivision flags (ISO 3166-2)
  const GB = {'GB-ENG':'🏴󠁧󠁢󠁥󠁮󠁧󠁿','GB-SCT':'🏴󠁧󠁢󠁳󠁣󠁴󠁿','GB-WLS':'🏴󠁧󠁢󠁷󠁬󠁳󠁿'};
  if (GB[isoUp]) return GB[isoUp];
  // FIFA/IOC 3-letter codes (equipo.codigo_iso) → 2-letter ISO 3166-1
  const F3 = {
    'ENG':'GB-ENG','SCO':'GB-SCT','WAL':'GB-WLS','NIR':'GB',
    'MEX':'MX','ARG':'AR','BRA':'BR','COL':'CO','CHI':'CL','URU':'UY','ECU':'EC',
    'PER':'PE','PAR':'PY','BOL':'BO','VEN':'VE','HON':'HN','CRC':'CR','PAN':'PA',
    'USA':'US','CAN':'CA','FRA':'FR','GER':'DE','DEU':'DE','ESP':'ES','ITA':'IT',
    'NED':'NL','POR':'PT','BEL':'BE','SUI':'CH','AUT':'AT','POL':'PL','DEN':'DK',
    'SWE':'SE','NOR':'NO','CZE':'CZ','SVK':'SK','HUN':'HU','GRE':'GR','TUR':'TR',
    'UKR':'UA','CRO':'HR','SRB':'RS','SER':'RS','GEO':'GE','ALB':'AL','ROU':'RO',
    'SLO':'SI','SVN':'SI','SVK':'SK','HRV':'HR',
    'MAR':'MA','SEN':'SN','CMR':'CM','GHA':'GH','NGA':'NG','EGY':'EG','ALG':'DZ',
    'TUN':'TN','RSA':'ZA','CIV':'CI','COD':'CD','CGO':'CG','BFA':'BF',
    'JPN':'JP','KOR':'KR','AUS':'AU','NZL':'NZ','IRN':'IR','SAU':'SA','QAT':'QA',
    'IRQ':'IQ','IDN':'ID','CPV':'CV','KUW':'KW','UAE':'AE','KSA':'SA',
    'PRT':'PT','CHE':'CH','DNK':'DK','NLD':'NL','GRC':'GR','TUR':'TR','UKR':'UA',
    'DEU':'DE','FRA':'FR','ESP':'ES','ITA':'IT','POL':'PL','CZE':'CZ','SVK':'SK',
  };
  if (F3[isoUp]) return flagFromIso(F3[isoUp]);
  // Standard 2-letter ISO 3166-1
  const code = isoUp.replace(/[^A-Z]/g,'').slice(0,2);
  if (code.length !== 2) return '';
  try { return [...code].map(c=>String.fromCodePoint(0x1F1E6+c.charCodeAt(0)-65)).join(''); }
  catch { return ''; }
}

// ── SIM-BAR: barra de partidos del día ──────────────────────────────
function renderSimBar() {
  const bar   = document.getElementById('sim-bar');
  const inner = document.getElementById('sim-bar-inner');
  if (!bar || !inner) return;

  // Fecha de hoy en Paraguay (UTC-4 fijo, sin Intl)
  const todayLocal = _pyDate(Date.now());

  // Mapa de enriquecimiento desde live-panel (score en vivo, minuto actual)
  const phMap = {};
  (_partHoy || []).forEach(p => { if (p.numero_fifa) phMap[p.numero_fifa] = p; });

  // Derivar fuente desde _bracket filtrado por "hoy local" — independiente de UTC del servidor
  let fuente = [];
  if (_bracket && _bracket.length > 0) {
    fuente = _bracket
      .filter(m => {
        if (!m.fecha || m.tipo === 'grupo') return false;
        const md = _pyDate(new Date(_isoToUTC(m.fecha)));
        return md === todayLocal;
      })
      .map(m => {
        const ph = phMap[m.num] || {};
        return {
          numero_fifa:      m.num,
          equipo_local:     m.local?.nombre     || '?',
          equipo_visitante: m.visitante?.nombre || '?',
          bandera_local:    m.local?.iso        || '',
          bandera_visitante: m.visitante?.iso   || '',
          goles_local:      ph.goles_local      ?? m.gl,
          goles_visitante:  ph.goles_visitante  ?? m.gv,
          minuto_actual:    ph.minuto_actual     ?? null,
          estado: m.en_vivo ? 'en_juego' : (m.finalizado ? 'finalizado' : 'programado'),
          fecha: m.fecha
        };
      })
      .sort((a, b) => new Date(_isoToUTC(a.fecha)) - new Date(_isoToUTC(b.fecha)));
  }
  // Fallback: si bracket vacío o sin partidos hoy, usar partidos_hoy del API
  if (fuente.length === 0) fuente = _partHoy || [];

  if (fuente.length < 1) { bar.style.display = 'none'; return; }
  bar.style.display = 'block';

  const livePart = _liveData && _liveData.partido;
  const curNum   = livePart ? livePart.numero_fifa : null;
  function flagFromIso_unused(iso) {
    if (!iso) return '';
    const GB = {'GB-ENG':'🏴‍󠁧󠁢󠁥󠁮󠁧󠁿','GB-SCT':'🏴‍󠁧󠁢󠁳󠁣󠁴󠁿','GB-WLS':'🏴‍󠁧󠁢󠁷󠁬󠁳󠁿'};
    if (GB[iso.toUpperCase()]) return GB[iso.toUpperCase()];
    const code = (iso||'').toUpperCase().replace(/[^A-Z]/g,'').slice(0,2);
    if (code.length !== 2) return '';
    try { return [...code].map(c=>String.fromCodePoint(0x1F1E6+c.charCodeAt(0)-65)).join(''); }
    catch { return ''; }
  }
  function fmtH(fechaIso) {
    if (!fechaIso) return '';
    const _d = new Date(_isoToUTC(fechaIso));
    if (isNaN(_d)) return '';
    return String(_d.getHours()).padStart(2,'0') + ':' + String(_d.getMinutes()).padStart(2,'0');
  }
  const tabs = fuente.map(p => {
    const isActive   = p.numero_fifa === curNum;
    const enVivo     = p.estado === 'en_juego';
    const finalizado = p.estado === 'finalizado';
    const gl = p.goles_local     != null ? p.goles_local     : '–';
    const gv = p.goles_visitante != null ? p.goles_visitante : '–';
    const lF = flagFromIso(p.bandera_local);
    const vF = flagFromIso(p.bandera_visitante);
    const lS = (p.equipo_local    ||'').split(' ')[0];
    const vS = (p.equipo_visitante||'').split(' ')[0];
    // Bug fix: para finalizado NO repetir la hora en statusEl — ya está en horaRow
    let statusEl = '', horaRow = '';
    if (enVivo) {
      statusEl = p.minuto_actual
        ? `<span class="sim-min">${p.minuto_actual}'</span>`
        : '<span class="sim-dot-p"></span>';
    } else if (finalizado) {
      horaRow = `<div style="font-size:9px;color:#6b7280;text-align:center;margin-bottom:2px">✅ Final · ${fmtH(p.fecha)}</div>`;
    } else {
      horaRow = `<div style="font-size:9px;color:#a78bfa;font-weight:700;text-align:center;margin-bottom:2px">${fmtH(p.fecha)}</div>`;
    }
    const cls = `sim-tab${isActive?' active':''}${enVivo?' sim-live':' sim-prox-tab'}`;
    const scoreOrVs = enVivo
      ? `<span class="sim-score">${gl}–${gv}</span>`
      : finalizado
        ? `<span class="sim-score" style="color:#9ca3af">${gl}–${gv}</span>`
        : `<span class="sim-vs">vs</span>`;
    return `<div class="${cls}" onclick="navToPartidoP(${p.numero_fifa})" title="P${p.numero_fifa}: ${p.equipo_local} vs ${p.equipo_visitante}"
      style="flex-direction:column;padding:5px 10px">
      ${horaRow}<div style="display:flex;align-items:center;gap:5px">${statusEl}<span>${lF} ${lS}</span>${scoreOrVs}<span>${vS} ${vF}</span></div>
    </div>`;
  }).join('');
  inner.innerHTML = `<span class="sim-label">Hoy</span>${tabs}`;
}

function navToPartidoP(numFifa) {
  // Si el partido está en vivo → ir al tab live
  const p = (_partHoy||[]).find(x => x.numero_fifa === numFifa);
  if (p && p.estado === 'en_juego') {
    setTab('live');
  } else {
    // No en vivo → ir al bracket (lista) y filtrar esa fase
    setBracketView('list');
    setTab('bracket');
    // Intentar hacer scroll al partido en la lista
    setTimeout(() => {
      const el = document.querySelector(`[data-num="${numFifa}"]`);
      if (el) el.scrollIntoView({behavior:'smooth', block:'center'});
    }, 150);
  }
}

// ── COUNTDOWN (próximo partido) ───────────────────────────────────
let _cdTimer = null;
function stopCountdown() { if (_cdTimer) { clearInterval(_cdTimer); _cdTimer = null; } }
function startCountdown(fechaIso) {
  stopCountdown();
  if (!fechaIso) return;
  _cdTimer = setInterval(() => {
    const per = document.getElementById('score-period');
    if (per && per.dataset.cdActive === '1') per.textContent = countdownText(fechaIso);
    // También actualizar el card "próximo partido" en no-live
    const nlCd = document.getElementById('nl-countdown');
    if (nlCd && nlCd.dataset.fecha) nlCd.textContent = countdownText(nlCd.dataset.fecha);
  }, 30000);
}
function countdownText(fechaIso) {
  try {
    const diff = new Date(_isoToUTC(fechaIso)) - Date.now();
    if (diff <= 0) return 'EN BREVE';
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    if (h > 0) return `⏰ ${h}h ${m}m`;
    return `⏰ ${m}m`;
  } catch(_) { return '⏰ Próximo'; }
}

// ── LIVE HEADER ──────────────────────────────────────────────────
function renderLiveHeader() {
  const p = _liveData?.partido;
  const badge = document.getElementById('tb-live-badge');
  const hdr   = document.getElementById('score-hdr');
  const dot   = document.getElementById('live-dot-nav');
  if (!p) {
    badge.style.display='none'; hdr.style.display='none'; dot.style.display='none'; stopCountdown(); return;
  }
  hdr.style.display = (_activeTab === 'live') ? 'block' : 'none';
  const tipo = p.fase_tipo||'';
  const cfg  = FASE_PTS[tipo]||{};
  const numStr = p.numero_fifa ? ' · P'+p.numero_fifa : '';
  document.getElementById('score-phase').textContent=(cfg.label||tipo).toUpperCase()+numStr;
  const _sfl=document.getElementById('score-flag-l');_sfl.innerHTML=p.bandera_local?flagFromIso(p.bandera_local):flagFor(p.local_nombre||p.equipo_local);if(typeof twemoji!=='undefined'){twemoji.parse(_sfl,{folder:'svg',ext:'.svg',base:'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/'});}
  const _sfv=document.getElementById('score-flag-v');_sfv.innerHTML=p.bandera_visitante?flagFromIso(p.bandera_visitante):flagFor(p.visita_nombre||p.equipo_visitante);if(typeof twemoji!=='undefined'){twemoji.parse(_sfv,{folder:'svg',ext:'.svg',base:'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/'});}
  document.getElementById('score-name-l').textContent=p.local_nombre||p.equipo_local||'?';
  document.getElementById('score-name-v').textContent=p.visita_nombre||p.equipo_visitante||'?';
  const per = document.getElementById('score-period');
  per.dataset.cdActive = '0';
  per.style.color = '';

  if (p.estado==='en_juego') {
    badge.style.display='flex'; dot.style.display='block';
    // goles null → '?' (desconocido), goles 0 → '0'
    const gl = p.goles_local!=null ? p.goles_local : '?';
    const gv = p.goles_visitante!=null ? p.goles_visitante : '?';
    document.getElementById('score-num').textContent=gl+' – '+gv;
    document.getElementById('score-num').style.fontSize='';
    per.className='score-period sp-live';
    per.textContent=(p.minuto_actual||'?')+"'";
    stopCountdown();
  } else if (p.estado==='finalizado') {
    badge.style.display='none'; dot.style.display='none';
    document.getElementById('score-num').textContent=(p.goles_local??'–')+' – '+(p.goles_visitante??'–');
    document.getElementById('score-num').style.fontSize='';
    per.className='score-period';
    per.textContent='FIN';
    per.style.color='#6ee7b7';
    stopCountdown();
  } else {
    // programado / pendiente → countdown
    badge.style.display='none'; dot.style.display='none';
    document.getElementById('score-num').textContent='vs';
    document.getElementById('score-num').style.fontSize='28px';
    per.className='score-period';
    per.style.color='#60a5fa';
    per.dataset.cdActive = '1';
    per.textContent = p.fecha ? countdownText(p.fecha) : '⏰ Próximo';
    startCountdown(p.fecha);
  }

  const penRow=document.getElementById('pen-row');
  if (p.penales_tanda_local!=null) {
    penRow.style.display='flex';
    document.getElementById('pen-score-l').textContent=p.penales_tanda_local;
    document.getElementById('pen-score-v').textContent=p.penales_tanda_visitante??'–';
  } else { penRow.style.display='none'; }
}

// ── NO LIVE: muestra el próximo partido con countdown ────────────
function renderNoLive() {
  const nc = document.getElementById('no-live');
  if (!nc) return;
  // Buscar el próximo partido en el bracket
  let nextMatch = null, bestTime = Infinity;
  const now = Date.now();
  for (const m of (_bracket||[])) {
    if (m.finalizado) continue;
    if (!m.fecha) continue;
    const t = new Date(_isoToUTC(m.fecha)).getTime();
    if (t > now - 30*60*1000 && t < bestTime) { bestTime = t; nextMatch = m; }
  }
  if (!nextMatch) {
    nc.innerHTML = '<div class="empty-icon">⚽</div><div>No hay partido en curso</div><div style="font-size:12px;color:#8b9bb4;margin-top:6px">Se actualiza automáticamente</div>';
    return;
  }
  const faseLabel = FASE_PTS[nextMatch.fase_tipo||'']?.label || nextMatch.fase_tipo || 'Playoff';
  const lN = nextMatch.local?.nombre || nextMatch.local || '?';
  const vN = nextMatch.visitante?.nombre || nextMatch.visitante || '?';
  const lF = flagFor(lN);
  const vF = flagFor(vN);
  const fechaStr = nextMatch.fecha ? fmtFechaCorta(nextMatch.fecha) : '';
  const cdTxt = nextMatch.fecha ? countdownText(nextMatch.fecha) : '';
  nc.innerHTML = `
    <div style="font-size:11px;color:#9ca3af;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px">${faseLabel} · P${nextMatch.num||''}</div>
    <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:10px">
      <div style="text-align:center">
        <div style="font-size:28px">${lF}</div>
        <div style="font-size:12px;color:#9ca3af;margin-top:3px">${lN}</div>
      </div>
      <div style="font-size:16px;color:#9ca3af;font-weight:700">VS</div>
      <div style="text-align:center">
        <div style="font-size:28px">${vF}</div>
        <div style="font-size:12px;color:#9ca3af;margin-top:3px">${vN}</div>
      </div>
    </div>
    <div style="font-size:12px;color:#9ca3af;margin-bottom:6px">📅 ${fechaStr}</div>
    <div id="nl-countdown" data-fecha="${nextMatch.fecha||''}" style="font-size:20px;font-weight:700;color:#60a5fa">${cdTxt}</div>
    <div style="font-size:11px;color:#8b9bb4;margin-top:8px">Se actualiza automáticamente</div>
  `;
  // Arrancar countdown si existe fecha
  if (nextMatch.fecha) startCountdown(nextMatch.fecha);
}

// ── LIVE CONTENT (betting-site style) ────────────────────────────
function renderLiveContent() {
  const p  = _liveData?.partido;
  const nc = document.getElementById('no-live');
  const lc = document.getElementById('live-content');
  if (!p) { nc.style.display='block'; lc.style.display='none'; renderNoLive(); return; }
  nc.style.display='none'; lc.style.display='block';

  // Stats row: amarillas / rojas / VAR / penales partido
  const statRow = document.getElementById('lv-stat-row');
  const hasStats = p.amarillas!=null || p.rojas!=null || p.decisiones_var!=null || p.penales_partido!=null;
  if (statRow) {
    statRow.style.display = hasStats ? 'flex' : 'none';
    document.getElementById('ev-amar').textContent  = p.amarillas??'—';
    document.getElementById('ev-rojas').textContent = p.rojas??'—';
    document.getElementById('ev-var').textContent   = p.decisiones_var??'—';
    document.getElementById('ev-pen-jg').textContent= p.penales_partido??'—';
  }

  // Admin: panel finalizar (solo en_juego y admin)
  const fpWrap = document.getElementById('admin-fp-wrap');
  if (fpWrap) fpWrap.style.display = (_isAdmin && p.estado==='en_juego') ? 'block' : 'none';

  renderLiveTotals(p);
  renderTimeline(p);
  renderRanking();
}

async function adminFinalizar(btn) {
  const p = _liveData?.partido;
  if (!p || !_isAdmin) return;
  const gl = document.getElementById('fp-gl').value.trim();
  const gv = document.getElementById('fp-gv').value.trim();
  const msg = document.getElementById('fp-msg');
  if (gl===''||gv==='') { msg.textContent='Ingresá ambos marcadores'; return; }
  if (btn) btn.disabled = true;
  msg.textContent = 'Finalizando…';
  try {
    const r = await api(`/api/v1/bets/finalizar-partido/${p.id}?goles_local=${gl}&goles_visitante=${gv}`, {method:'POST'});
    const d = await r.json();
    if (d.estado==='ok'||d.ok) {
      msg.textContent = '✓ Finalizado. Recargando…';
      msg.style.color = '#6ee7b7';
      await Promise.all([loadBracket(), loadLive()]);
      showToast('Partido finalizado ✓');
    } else {
      msg.textContent = JSON.stringify(d).slice(0,100);
    }
  } catch(e) {
    msg.textContent = 'Error: '+e.message;
  } finally {
    if (btn) btn.disabled = false;
  }
}

function renderLiveTotals(p) {
  const card = document.getElementById('lv-bet-card');
  if (!card) return;
  if (!_viewAsId) { card.style.display='none'; return; }

  const apos = _liveData?.apostadores||[];
  const me   = apos.find(a=>a.apostador_id===_viewAsId);
  if (!me) { card.style.display='none'; return; }
  card.style.display = 'block';

  document.getElementById('lv-bc-user').textContent = _viewAsName||'?';

  const tipo = p.fase_tipo||'';
  const cfg  = FASE_PTS[tipo]||{h:4,i:8};
  const gl=p.goles_local??null, gv=p.goles_visitante??null;
  const mult = isPyMatch(p.local_nombre||'',p.visita_nombre||'') ? 2 : 1;

  const hitH = gl!==null&&gv!==null&&me.pred_local!==null&&sign(gl-gv)===sign(me.pred_local-me.pred_visitante);
  const hitI = gl!==null&&gv!==null&&me.pred_local===gl&&me.pred_visitante===gv;
  const hitJ = p.amarillas!=null&&me.pred_amarillas!=null&&p.amarillas===me.pred_amarillas;
  const hitK = p.rojas!=null&&me.pred_rojas!=null&&p.rojas===me.pred_rojas;
  const hitL = p.decisiones_var!=null&&me.pred_var!=null&&p.decisiones_var===me.pred_var;
  const hitM = p.penales_partido!=null&&me.pred_penales_partido!=null&&p.penales_partido===me.pred_penales_partido;
  const hitOl= p.penales_tanda_local!=null&&me.pred_penales_local_tanda!=null&&p.penales_tanda_local===me.pred_penales_local_tanda;
  const hitOv= p.penales_tanda_visitante!=null&&me.pred_penales_visitante_tanda!=null&&p.penales_tanda_visitante===me.pred_penales_visitante_tanda;

  // Minuto gol N: 1 pt al más cercano (no podemos calcular eso en cliente sin todos los preds)
  // Mostramos la predicción solo informativa
  const nPredVal = me.pred_minuto_gol;
  const nRealVal = p.minuto_primer_gol;

  const items = [
    {ico:'⚽',lbl:'H', desc:'Resultado',     pred:me.pred_local!=null?`${me.pred_local}–${me.pred_visitante}`:null, real:gl!=null?`${gl}–${gv}`:null, pts:(hitH?cfg.h:0)*mult, hit:hitH, pend:gl===null},
    {ico:'🎯',lbl:'I', desc:'Marcador exacto',pred:me.pred_local!=null?`${me.pred_local}–${me.pred_visitante}`:null, real:gl!=null?`${gl}–${gv}`:null, pts:(hitI?cfg.i:0)*mult, hit:hitI, pend:gl===null},
    {ico:'🟨',lbl:'J', desc:'Amarillas',     pred:me.pred_amarillas, real:p.amarillas,        pts:(hitJ?1:0)*mult, hit:hitJ, pend:p.amarillas==null},
    {ico:'🟥',lbl:'K', desc:'Rojas',         pred:me.pred_rojas,     real:p.rojas,            pts:(hitK?1:0)*mult, hit:hitK, pend:p.rojas==null},
    {ico:'📺',lbl:'L', desc:'VAR',           pred:me.pred_var,       real:p.decisiones_var,   pts:(hitL?1:0)*mult, hit:hitL, pend:p.decisiones_var==null},
    {ico:'🥅',lbl:'M', desc:'Pen.juego',     pred:me.pred_penales_partido, real:p.penales_partido, pts:(hitM?1:0)*mult, hit:hitM, pend:p.penales_partido==null},
    {ico:'⏱',lbl:'N', desc:'1er gol (min)', pred:nPredVal, real:nRealVal,                    pts:0, hit:false, pend:true},
    {sep:true,label:'⚽ Definición por penales'},
    {ico:'⚡',lbl:'Ol',desc:'Tanda local',   pred:me.pred_penales_local_tanda, real:p.penales_tanda_local,    pts:(hitOl?2:0)*mult, hit:hitOl, pend:p.penales_tanda_local==null},
    {ico:'⚡',lbl:'Ov',desc:'Tanda visit.',  pred:me.pred_penales_visitante_tanda,real:p.penales_tanda_visitante,pts:(hitOv?2:0)*mult,hit:hitOv,pend:p.penales_tanda_visitante==null},
  ];
  // P – Equipo clasifica (añadir solo si hay dato)
  const liveMatchLv = (_bracket||[]).find(b => b.num === p.numero_fifa);
  const realEcLv   = p.equipo_clasificado_id ?? null;
  const predEcLv   = me.pred_equipo_clasifica ?? null;
  const locIdLv    = liveMatchLv?.local?.id    ?? null;
  const visIdLv    = liveMatchLv?.visitante?.id ?? null;
  const lNameLv    = p.local_nombre||p.equipo_local||'Local';
  const vNameLv    = p.visita_nombre||p.equipo_visitante||'Visit.';
  if (realEcLv !== null || predEcLv !== null) {
    const hitOl_ = p.penales_tanda_local!=null&&me.pred_penales_local_tanda!=null&&p.penales_tanda_local===me.pred_penales_local_tanda; // reuse variable shadowing OK
    const realNmLv = realEcLv ? (realEcLv===locIdLv ? lNameLv.split(' ')[0] : (realEcLv===visIdLv ? vNameLv.split(' ')[0] : '?')) : null;
    const predNmLv = predEcLv ? (predEcLv===locIdLv ? lNameLv.split(' ')[0] : (predEcLv===visIdLv ? vNameLv.split(' ')[0] : '?')) : null;
    const hitP_lv  = realEcLv !== null && predEcLv !== null && realEcLv === predEcLv;
    const FASE_P2  = {grupo:1,ronda32:2,ronda16:4,cuartos:6,semis:8,tercer_puesto:10,tercero:10,final:12};
    const ptsP_lv  = (hitP_lv ? (FASE_P2[tipo]||1)*mult : 0);
    const pendP_lv = realEcLv === null;
    items.push({ico:'<b class="ib ib-ko">KO</b>',lbl:'P',desc:'Clasifica KO', pred:predNmLv, real:realNmLv, pts:ptsP_lv, hit:hitP_lv, pend:pendP_lv});
  }

  let total = 0;
  items.forEach(it => { if (!it.sep) total += (it.pts ?? 0); });

  // Pts badge
  const badge = document.getElementById('lv-bc-badge');
  if (badge) {
    badge.textContent = (total>0?'+':'')+total;
    const hit = total>0;
    badge.style.color = hit ? '#22c55e' : '#6b7280';
    badge.style.borderColor = hit ? 'rgba(34,197,94,.3)' : '#1f2937';
    badge.style.background  = hit ? 'rgba(34,197,94,.08)' : 'transparent';
  }

  // Pred vs real score row
  const predRow = document.getElementById('lv-pred-row');
  if (predRow) {
    if (gl !== null) {
      const lN = p.local_nombre||p.equipo_local||'Local';
      const vN = p.visita_nombre||p.equipo_visitante||'Visit.';
      const pL = me.pred_local??'?', pV = me.pred_visitante??'?';
      const resH = hitH ? ' lv-pred-hit' : '';
      predRow.innerHTML = `
        <div class="lv-pred-team">
          <span class="lv-pred-flag">${flagFor(lN)}</span>
          <span class="lv-pred-name">${lN.length>10?lN.slice(0,9)+'…':lN}</span>
        </div>
        <div class="lv-pred-scores${resH}">
          <div class="lv-pred-num">${pL}–${pV}</div>
          <div class="lv-pred-sep">tu apuesta · live</div>
          <div class="lv-real-num">${gl}–${gv}</div>
        </div>
        <div class="lv-pred-team">
          <span class="lv-pred-flag">${flagFor(vN)}</span>
          <span class="lv-pred-name">${vN.length>10?vN.slice(0,9)+'…':vN}</span>
        </div>`;
    } else {
      const pL=me.pred_local??'?', pV=me.pred_visitante??'?';
      predRow.innerHTML=`<div class="lv-pred-pending">Tu pronóstico: <b style="color:#60a5fa">${pL}–${pV}</b> · partido pendiente</div>`;
    }
  }

  // Items table (solo los que tienen pred o real)
  const itemsEl = document.getElementById('lv-bc-items');
  if (!itemsEl) return;
  // Filtrar: sep items solo si habrá tanda; Ol/Ov solo si hay tanda o pred
  const _hasTandaLv = p.penales_tanda_local!=null || me.pred_penales_local_tanda!=null || me.pred_penales_visitante_tanda!=null;
  const visible = items.filter(it=>{
    if (it.sep) return _hasTandaLv;
    if (it.lbl==='Ol'||it.lbl==='Ov') return _hasTandaLv;
    return true;
  });
  itemsEl.innerHTML = '<table class="lv-items-tbl"><tbody>' +
    visible.map(it => {
      if (it.sep) return `<tr><td colspan="5" style="font-size:10px;font-weight:700;color:#60a5fa;text-transform:uppercase;letter-spacing:.8px;padding:5px 10px 3px;background:#060c18;border-top:1px solid #0f1225">${it.label}</td></tr>`;
      const cls  = it.pend ? 'pend' : (it.hit ? 'hit' : 'miss');
      const ptsS = it.pts>0 ? `+${it.pts}` : (it.pend ? '–' : (it.hit&&it.pts===0?'0':'✗'));
      // Para H e I, pred/real son el marcador ya mostrado arriba — simplificar fila
      const predS = (it.lbl==='I') ? '' : (it.pred!=null ? String(it.pred) : '—');
      const realS = (it.lbl==='I') ? '' : (it.real!=null ? String(it.real) : '—');
      const descS = it.lbl==='I' ? 'Exacto' : it.desc;
      return `<tr class="lv-itr lv-itr-${cls}">
        <td class="lv-it-lbl"><span class="lv-it-ico">${it.ico}</span><span class="lv-it-key">${it.lbl}</span></td>
        <td class="lv-it-desc">${descS}</td>
        <td class="lv-it-pred">${predS}</td>
        <td class="lv-it-real">${realS}</td>
        <td class="lv-it-pts"><span class="lv-pts-chip lv-pts-${cls}">${ptsS}</span></td>
      </tr>`;
    }).join('') +
  '</tbody></table>';
}

function renderLiveItemsPanel(items, total) {
  // No-op: panel merged into bet card (renderLiveTotals)
}

function renderTimeline(p) {
  const tl=document.getElementById('ev-timeline');
  tl.innerHTML='';
  const estado=p.estado||'programado';
  const rows=[];
  if (estado==='en_juego') rows.push({type:'cur',min:(p.minuto_actual||'?')+"'"});

  // Determinar team IDs: usar api_team_id del partido (más robusto) con fallback a logo URL
  const _tidFromLogo = url => (url||'').match(/teams\/(\d+)/)?.[1] || null;
  const localApiId  = String(p.local_api_team_id || _tidFromLogo(p.logo_local) || '');
  const visitApiId  = String(p.visita_api_team_id || _tidFromLogo(p.logo_visitante) || '');

  // Intentar usar eventos individuales de API-Football si están disponibles
  const eventos = Array.isArray(p.eventos_api) ? p.eventos_api : [];
  if (eventos.length > 0) {
    // Ordenar por minuto
    const sorted = [...eventos].sort((a,b)=>(a.time?.elapsed||0)-(b.time?.elapsed||0));
    for (const ev of sorted) {
      const min = ev.time?.elapsed;
      const extra = ev.time?.extra;
      const minStr = min!=null ? (min+(extra?`+${extra}`:``)+`'`) : '–';
      const evType = ev.type||'';
      const detail = ev.detail||'';
      const dLow = detail.toLowerCase();
      const teamName = ev.team?.name||'';
      const playerName = ev.player?.name||'';
      const assistName = ev.assist?.name||'';
      const comments = ev.comments||'';
      const evApiId = String(ev.team?.id || _tidFromLogo(ev.team?.logo||'') || '');
      const isLocal = localApiId && evApiId ? evApiId===localApiId : (visitApiId && evApiId ? evApiId!==visitApiId : true);
      const _sh = s => s.length>20 ? s.slice(0,19)+'.' : s;

      if (evType==='Goal') {
        if (dLow.includes('miss') || dLow.includes('saved')) {
          // Penal fallado: mostrar del lado del equipo que falló
          const label=`❌ ${_sh(playerName||teamName)} <span style="font-size:.7em;opacity:.7">(pen. fallado)</span>`;
          rows.push({type:'ev', min:minStr, home:isLocal?label:'', away:isLocal?'':label, ec:'miss', teamName});
        } else {
          const isOG = dLow.includes('own goal');
          const isPen = dLow.includes('penalty');
          let label = `⚽ ${_sh(playerName||teamName)}`;
          if (isOG)  label += ` <span style="font-size:.7em;opacity:.7">(propia)</span>`;
          if (isPen) label += ` <span style="font-size:.7em;opacity:.7">(pen.)</span>`;
          if (!isOG && !isPen && assistName) label += ` <span style="font-size:.7em;opacity:.7">· ${_sh(assistName)}</span>`;
          // Gol en propia va al lado contrario
          rows.push({type:'ev', min:minStr,
            home: (isLocal&&!isOG)||(!isLocal&&isOG) ? label : '',
            away: (isLocal&&!isOG)||(!isLocal&&isOG) ? '' : label,
            ec:'goal', teamName});
        }
      } else if (evType==='Miss') {
        const label=`❌ ${_sh(playerName||teamName)} <span style="font-size:.7em;opacity:.7">(pen. fallado)</span>`;
        rows.push({type:'ev', min:minStr, home:isLocal?label:'', away:isLocal?'':label, ec:'miss', teamName});
      } else if (evType==='Card') {
        const isRed = dLow.includes('red card');
        const is2Y  = dLow.includes('second yellow') || dLow.includes('yellow red');
        if (isRed || is2Y) {
          const sub = is2Y ? ' <span style="font-size:.7em;opacity:.7">(2ª amar.)</span>' : '';
          const label=`🟥 ${_sh(playerName||teamName)}${sub}`;
          rows.push({type:'ev', min:minStr, home:isLocal?label:'', away:isLocal?'':label, ec:'red', teamName});
        } else {
          const reason = comments ? ` <span style="font-size:.7em;opacity:.7">${_sh(comments)}</span>` : '';
          const label=`🟨 ${_sh(playerName||teamName)}${reason}`;
          rows.push({type:'ev', min:minStr, home:isLocal?label:'', away:isLocal?'':label, ec:'yellow', teamName});
        }
      } else if (evType==='Var') {
        const varLabel = dLow.includes('goal') ? (dLow.includes('cancel')||dLow.includes('disallow')?'Gol anulado':'Gol confirmado') : (_sh(detail)||'VAR');
        const varSub = comments ? ` <span style="font-size:.7em;opacity:.7">· ${_sh(comments)}</span>` : '';
        const label=`📺 ${varLabel}${varSub}`;
        rows.push({type:'ev', min:minStr, home:isLocal?label:'', away:isLocal?'':label, ec:'var', teamName});
      } else if (evType==='subst') {
        const label=`🔄 ↑ ${_sh(assistName||'?')} / ↓ ${_sh(playerName||'?')}`;
        rows.push({type:'ev', min:minStr, home:isLocal?label:'', away:isLocal?'':label, ec:'subst', teamName});
      }
    }
    // Mostrar tanda si existe
    const penL=p.penales_tanda_local??p.penales_local;
    const penV=p.penales_tanda_visitante??p.penales_visitante;
    if (penL!=null) {
      rows.push({type:'sep', text:'Tanda de penales'});
      rows.push({type:'ev', min:'⚽', home:`${penL}`, away:`${penV}`, ec:'pen'});
    }
    if (!rows.length || (rows.length===1&&rows[0].type==='cur')) {
      rows.push({type:'sep', text:'Sin eventos registrados aún'});
    }
  } else {
    // Fallback: vista agregada (datos del partido sin eventos individuales)
    const gl=p.goles_local??0, gv=p.goles_visitante??0;
    const amar=p.amarillas??0, rojas=p.rojas??0, varD=p.decisiones_var??0;
    const penP=p.penales_partido??0, minG=p.minuto_primer_gol;
    const penL=p.penales_tanda_local??p.penales_local;
    const penV=p.penales_tanda_visitante??p.penales_visitante;
    if (gl>0&&minG) rows.push({type:'ev',min:minG+"'",home:`⚽ Gol (${minG}')`,away:'',ec:'goal'});
    else if (gl>0) rows.push({type:'ev',min:'–',home:`⚽ ${gl} gol${gl>1?'es':''}`,away:'',ec:'goal'});
    if (gv>0) rows.push({type:'ev',min:'–',home:'',away:`⚽ ${gv} gol${gv>1?'es':''}`,ec:'goal'});
    if (estado!=='programado') rows.push({type:'sep',text:'Datos acumulados'});
    if (amar>0) rows.push({type:'ev',min:'🟨',home:`${amar}`,away:'',ec:'yellow'});
    if (rojas>0) rows.push({type:'ev',min:'🟥',home:`${rojas}`,away:'',ec:'red'});
    if (varD>0) rows.push({type:'ev',min:'📺',home:`${varD} dec.`,away:'',ec:'var'});
    if (penP>0) rows.push({type:'ev',min:'🥅',home:`${penP} pen.`,away:'',ec:'pen'});
    if (penL!=null) { rows.push({type:'sep',text:'Tanda de penales'}); rows.push({type:'ev',min:'⚽',home:`${penL}`,away:`${penV}`,ec:'pen'}); }
  }

  if (estado==='programado') rows.push({type:'sep',text:'Partido pendiente'});
  if (!rows.length) rows.push({type:'sep',text:'Sin datos aún'});
  // Nota de demora para partidos en vivo (API-Football free plan)
  if (estado === 'en_juego') {
    rows.push({type:'sep',text:'⏳ Datos en vivo con posible demora · VAR y tarjetas completos al finalizar'});
  }

  for (const r of rows) {
    if (r.type==='sep') {
      const d=document.createElement('div');
      d.className='ev-separator';
      d.innerHTML=`<div class="ev-sep-inner">${r.text}</div>`;
      tl.appendChild(d);
    } else if (r.type==='cur') {
      const d=document.createElement('div');
      d.className='ev-cur-min';
      d.innerHTML=`<div class="live-dot"></div>Minuto ${r.min}`;
      tl.appendChild(d);
    } else {
      const d=document.createElement('div');
      d.className='ev-row';
      d.innerHTML=`<div class="ev-home">${r.home?`<span class="ev-chip ev-${r.ec}">${r.home}</span>`:''}</div><div class="ev-min">${r.min}</div><div class="ev-away">${r.away?`<span class="ev-chip ev-${r.ec}">${r.away}</span>`:''}</div>`;
      tl.appendChild(d);
    }
  }
}


// ===== EDITOR DE APUESTAS (Mi Prono) — cargar/modificar partidos no jugados =====
let _blockedFases = null;   // Set de tipos de fase bloqueada

async function _loadBlockedFases(){
  try{
    const r = await api('/api/v1/bets/fases-bloqueo/'+_torneoId);
    const d = await r.json();
    const arr = Array.isArray(d) ? d : (d.fases||[]);
    _blockedFases = new Set(arr.filter(function(f){return f.bloqueada;}).map(function(f){return f.tipo;}));
  }catch(e){ _blockedFases = new Set(); }
  if(_activeTab==='miprono') renderMiPronoEditor();
}

function _mpEditable(m){
  if(m.finalizado) return false;
  if(m.en_vivo || m.estado==='en_juego') return false;
  if(_blockedFases && _blockedFases.has(m.tipo)) return false;
  if(!m.local || !m.visitante || !m.local.id || !m.visitante.id) return false;
  return true;
}

function _scrollToMpCard(num){
  const c = document.getElementById('mp-card-'+num);
  if(!c) return;
  c.scrollIntoView({behavior:'smooth', block:'center'});
  c.style.transition='box-shadow .3s';
  c.style.boxShadow='0 0 0 2px #f59e0b';
  setTimeout(function(){ c.style.boxShadow=''; }, 1600);
}

function _mpNumInput(id, val, ph, mn, mx){
  const v = (val!==null && val!==undefined && val!=='') ? val : '';
  return '<input id="'+id+'" type="number" inputmode="numeric"'
    + (mn!=null?' min="'+mn+'"':'') + (mx!=null?' max="'+mx+'"':'')
    + ' value="'+v+'" placeholder="'+(ph||'')+'"'
    + ' style="width:54px;background:#0b1120;border:1px solid #334155;color:#e2e8f0;border-radius:6px;padding:5px 6px;text-align:center;font-size:14px">';
}

function _mpEdRow(letter, icon, label, inputHtml){
  return '<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid #0f1225">'
    + '<span style="width:26px;color:#64748b;font-weight:700;font-size:12px">'+letter+'</span>'
    + '<span style="width:22px;font-size:16px">'+icon+'</span>'
    + '<span style="flex:1;color:#cbd5e1;font-size:13px">'+label+'</span>'
    + '<span>'+inputHtml+'</span></div>';
}

function _mpEditorCard(m){
  const num=m.num;
  const p=_userPreds[num]||{};
  const localN=(m.local&&m.local.nombre)||'TBD', visitN=(m.visitante&&m.visitante.nombre)||'TBD';
  const flagL=teamFlag(localN,(m.local&&m.local.iso)||''), flagV=teamFlag(visitN,(m.visitante&&m.visitante.iso)||'');
  const faseLabel=_apuestasFaseLabel(m.tipo||'');
  const fechaStr=m.fecha?fmtFechaCorta(m.fecha):'';
  const locS=localN.split(' ')[0], visS=visitN.split(' ')[0];
  const locId=(m.local&&m.local.id)||'', visId=(m.visitante&&m.visitante.id)||'';
  const pec=(p.pred_equipo_clasifica!=null)?p.pred_equipo_clasifica:null;
  const mult=isPyMatch(localN,visitN)?2:1;
  let h='<div class="ap-match-card" id="mp-card-'+num+'" data-num="'+num+'" data-edit="1">';
  h+='<div class="ap-match-hdr"><span class="ap-match-num">P'+num+'</span>'
    +'<span class="ap-match-teams">'+flagL+' '+localN+' <small style="color:#475569;font-size:10px">vs</small> '+visitN+' '+flagV+'</span>'
    +'<span class="ap-match-fase">'+faseLabel+(mult>1?' ×2🇵🇾':'')+'</span></div>';
  h+='<div style="display:flex;align-items:center;justify-content:center;gap:10px;padding:11px 6px;background:#060c18">'
    +'<span style="font-size:12px;color:#94a3b8;flex:1;text-align:right;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+locS+'</span>'
    +_mpNumInput('mpe-'+num+'-pl', p.pred_local, '', 0, 99)
    +'<span style="color:#475569">–</span>'
    +_mpNumInput('mpe-'+num+'-pv', p.pred_visitante, '', 0, 99)
    +'<span style="font-size:12px;color:#94a3b8;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+visS+'</span>'
    +'</div>';
  h+='<div class="ai-items-wrap">';
  h+=_mpEdRow('J','🟨','Amarillas',       _mpNumInput('mpe-'+num+'-j', p.pred_amarillas,'0',0,60));
  h+=_mpEdRow('K','🟥','Rojas',           _mpNumInput('mpe-'+num+'-k', p.pred_rojas,'0',0,20));
  h+=_mpEdRow('L','📺','VAR',             _mpNumInput('mpe-'+num+'-l', p.pred_var,'0',0,20));
  h+=_mpEdRow('M','🥅','Penales (juego)', _mpNumInput('mpe-'+num+'-m', p.pred_penales_partido,'0',0,10));
  h+=_mpEdRow('N','⏱','Minuto 1er gol',        _mpNumInput('mpe-'+num+'-n', p.pred_minuto_gol,'min',1,130));
  h+='<div class="ai-section-lbl">⚡ Definición por penales</div>';
  h+=_mpEdRow('Ol','⚡','Tanda '+locS, _mpNumInput('mpe-'+num+'-ol', p.pred_penales_local_tanda,'0',0,30));
  h+=_mpEdRow('Ov','⚡','Tanda '+visS, _mpNumInput('mpe-'+num+'-ov', p.pred_penales_visitante_tanda,'0',0,30));
  const sel='<select id="mpe-'+num+'-p" style="background:#0b1120;border:1px solid #334155;color:#e2e8f0;border-radius:6px;padding:5px 6px;font-size:13px">'
    +'<option value="">—</option>'
    +'<option value="'+locId+'"'+(pec===locId?' selected':'')+'>'+locS+'</option>'
    +'<option value="'+visId+'"'+(pec===visId?' selected':'')+'>'+visS+'</option></select>';
  h+=_mpEdRow('P','🏅','Clasifica', sel);
  h+='</div>';
  if(fechaStr) h+='<div class="ap-match-fecha">📅 '+fechaStr+'</div>';
  h+='</div>';
  return h;
}

function _miItemRow(letter, icon, label, realVal, predVal, ptsVal){
  const realStr=(realVal!==null&&realVal!==undefined)?String(realVal):'–';
  const predStr=(predVal!==null&&predVal!==undefined)?String(predVal):'–';
  const rowCls=(ptsVal>0)?'ai-row ai-hit':'ai-row';
  let ptsFrag;
  if(ptsVal===null||ptsVal===undefined) ptsFrag='<span style="color:#334">–</span>';
  else if(ptsVal>0) ptsFrag='<span style="color:#22c55e;font-weight:800">+'+ptsVal+'</span>';
  else ptsFrag='<span style="color:#475569">0</span>';
  return '<div class="'+rowCls+'"><span class="ai-letter">'+letter+'</span><span class="ai-icon">'+icon+'</span><span class="ai-label">'+label+'</span><span class="ai-pred">'+predStr+'</span><span class="ai-real">'+realStr+'</span><span class="ai-pts">'+ptsFrag+'</span></div>';
}

function _mpCotejoCard(m){
  const num=m.num;
  const pred=_userPreds[num]||null;
  const hasPred=pred!==null && pred.pred_local!==null && pred.pred_local!==undefined;
  const localN=(m.local&&m.local.nombre)||'TBD', visitN=(m.visitante&&m.visitante.nombre)||'TBD';
  const flagL=teamFlag(localN,(m.local&&m.local.iso)||''), flagV=teamFlag(visitN,(m.visitante&&m.visitante.iso)||'');
  const faseLabel=_apuestasFaseLabel(m.tipo||'');
  const mult=isPyMatch(localN,visitN)?2:1;
  const done=m.finalizado, live=m.en_vivo||m.estado==='en_juego';
  const gl=(m.gl!=null)?m.gl:null, gv=(m.gv!=null)?m.gv:null;
  const penL=(m.pen_l!=null)?m.pen_l:null, penV=(m.pen_v!=null)?m.pen_v:null;
  const pl=pred?(pred.pred_local!=null?pred.pred_local:null):null;
  const pv=pred?(pred.pred_visitante!=null?pred.pred_visitante:null):null;
  const cls=_apuestasCls(pl,pv,gl,gv);
  const clsIcon=cls==='ap-pleno'?'✅':cls==='ap-res'?'🟡':cls==='ap-miss'?'❌':'⏳';
  const clsColor=cls==='ap-pleno'?'#22c55e':cls==='ap-res'?'#eab308':cls==='ap-miss'?'#ef4444':'#475569';
  const scoreReal=(gl!=null)?(gl+'–'+gv):'–';
  const scorePred=hasPred?(pl+'–'+pv):'Sin prono';
  let items='';
  const rH=(gl!=null)?(gl>gv?'L':gl<gv?'V':'E'):null;
  const pH=hasPred?(pl>pv?'L':pl<pv?'V':'E'):null;
  items+=_miItemRow('H','⚽','Resultado',rH,pH, done?(pred?pred.pts_resultado:null):null);
  items+=_miItemRow('I','🎯','Marcador exacto',(gl!=null)?(gl+'-'+gv):null,hasPred?(pl+'-'+pv):null, done?(pred?pred.pts_marcador:null):null);
  if(pred&&(pred.pred_amarillas!=null||pred.amarillas!=null))
    items+=_miItemRow('J','🟨','Amarillas',(done||live)?pred.amarillas:null,pred.pred_amarillas, done?pred.pts_amarillas:null);
  if(pred&&(pred.pred_rojas!=null||pred.rojas!=null))
    items+=_miItemRow('K','🟥','Rojas',(done||live)?pred.rojas:null,pred.pred_rojas, done?pred.pts_rojas:null);
  if(pred&&(pred.pred_var!=null||pred.decisiones_var!=null))
    items+=_miItemRow('L','📺','VAR',(done||live)?pred.decisiones_var:null,pred.pred_var, done?pred.pts_var:null);
  if(pred&&(pred.pred_penales_partido!=null||pred.penales_partido!=null))
    items+=_miItemRow('M','🥅','Penales (juego)',(done||live)?pred.penales_partido:null,pred.pred_penales_partido, done?pred.pts_penales_partido:null);
  if(pred&&(pred.pred_minuto_gol!=null||pred.minuto_primer_gol!=null))
    items+=_miItemRow('N','⏱','Minuto gol',(done||live)?pred.minuto_primer_gol:null,pred.pred_minuto_gol, done?pred.pts_minuto:null);
  const pOl=pred?(pred.pred_penales_local_tanda!=null?pred.pred_penales_local_tanda:null):null;
  const pOv=pred?(pred.pred_penales_visitante_tanda!=null?pred.pred_penales_visitante_tanda:null):null;
  if(penL!==null||pOl!==null||pOv!==null){
    const locS=localN.split(' ')[0], visS=visitN.split(' ')[0];
    items+='<div class="ai-section-lbl">⚡ Definición por penales</div>';
    const hitOl=done&&pOl!==null&&penL!==null&&pOl===penL, hitOv=done&&pOv!==null&&penV!==null&&pOv===penV;
    items+=_miItemRow('Ol','⚡','Tanda '+locS,penL,pOl, done&&penL!==null?(hitOl?2*mult:0):null);
    items+=_miItemRow('Ov','⚡','Tanda '+visS,penV,pOv, done&&penV!==null?(hitOv?2*mult:0):null);
  }
  const predPId=pred?(pred.pred_equipo_clasifica!=null?pred.pred_equipo_clasifica:null):null;
  const realEcId=pred?(pred.equipo_clasificado_id!=null?pred.equipo_clasificado_id:null):null;
  const locId=(m.local&&m.local.id)||null, visId=(m.visitante&&m.visitante.id)||null;
  const realEcNom=realEcId?(realEcId===locId?localN.split(' ')[0]:(realEcId===visId?visitN.split(' ')[0]:'?')):null;
  const predEcNom=predPId?(predPId===locId?localN.split(' ')[0]:(predPId===visId?visitN.split(' ')[0]:'?')):null;
  if(predPId!==null||realEcId!==null)
    items+=_miItemRow('P','🏅','Clasifica',realEcNom,predEcNom, done?(pred?pred.pts_equipo:null):null);
  const totalPts=done?(pred?(pred.pts_total!=null?pred.pts_total:0):0):null;
  const totalRow=(done&&hasPred)?'<div class="ai-total">Total partido: <strong style="color:#f59e0b">'+(totalPts||0)+' pts'+(mult>1?' ×2🇵🇾':'')+'</strong></div>':'';
  const itemsBlock='<div class="ai-items-wrap"><div class="ai-hdr"><span></span><span></span><span></span><span style="text-align:right">Prono</span><span style="text-align:right">Real</span><span style="text-align:right">Pts</span></div>'+items+totalRow+'</div>';
  return '<div class="ap-match-card" id="mp-card-'+num+'" data-num="'+num+'">'
    +'<div class="ap-match-hdr"><span class="ap-match-num">P'+num+'</span>'
    +'<span class="ap-match-teams">'+flagL+' '+localN+' <small style="color:#475569;font-size:10px">vs</small> '+visitN+' '+flagV+'</span>'
    +'<span class="ap-match-fase">'+faseLabel+'</span>'+(live?'<span class="ap-live-badge">EN VIVO</span>':'')+'</div>'
    +'<div class="ai-score-row"><div class="ai-score-col"><div class="ai-score-lbl">REAL</div><div class="ai-score-val" style="color:'+((done||live)?'#e2e8f0':'#475569')+'">'+scoreReal+'</div></div>'
    +'<div style="font-size:24px">'+clsIcon+'</div>'
    +'<div class="ai-score-col"><div class="ai-score-lbl">TU PRONO</div><div class="ai-score-val" style="color:'+(hasPred?clsColor:'#475569')+'">'+scorePred+'</div></div></div>'
    +itemsBlock+'</div>';
}

function renderMiPronoEditor(){
  const el=document.getElementById('mp-content');
  if(!el) return;
  if(!_viewAsId){
    el.innerHTML='<div class="ap-empty" style="padding:24px;text-align:center;color:#6b7280">Seleccioná tu nombre en la barra superior para cargar o ver tus apuestas</div>';
    return;
  }
  if(_blockedFases===null){ _blockedFases=new Set(); _loadBlockedFases(); }
  const ko=(_bracket||[]).filter(function(m){return m.num>=73;}).sort(function(a,b){return a.num-b.num;});
  const editables=ko.filter(_mpEditable);
  const cotejo=ko.filter(function(m){return m.finalizado||m.en_vivo||m.estado==='en_juego';});
  let html='';
  html+='<div class="mpe-sec-hdr" style="padding:12px 12px 6px;font-size:14px;font-weight:800;color:#e2e8f0">📝 Cargar / modificar apuestas <small style="color:#6b7280;font-weight:500">(partidos no jugados)</small></div>';
  if(!editables.length){
    html+='<div class="ap-empty" style="padding:14px;text-align:center;color:#6b7280">No hay partidos abiertos para cargar apuestas ahora.</div>';
  }else{
    editables.forEach(function(m){ html+=_mpEditorCard(m); });
    html+='<div style="padding:14px 10px 6px;text-align:center">'
      +'<button onclick="_mpGuardarClick()" style="background:#16a34a;color:#fff;border:none;border-radius:10px;padding:12px 30px;font-size:15px;font-weight:800;cursor:pointer">💾 Guardar apuestas</button>'
      +'<div style="font-size:11px;color:#6b7280;margin-top:6px">Se te pedirá un PIN (tu primer nombre) para confirmar.</div>'
      +'<div id="mpe-save-result" style="margin-top:10px"></div></div>';
  }
  // Mi Prono muestra SOLO partidos pendientes: seccion de cotejo (finalizados) oculta.
  el.innerHTML=html;
  if(typeof twemoji!=='undefined'){ twemoji.parse(el,{folder:'svg',ext:'.svg',base:'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/'}); }
}

function _mpCollectApuestas(){
  const cards=document.querySelectorAll('#mp-content .ap-match-card[data-edit="1"]');
  const out=[];
  cards.forEach(function(card){
    const num=+card.getAttribute('data-num');
    const g=function(id){ const e=document.getElementById('mpe-'+num+'-'+id); return e?e.value.trim():''; };
    const pl=g('pl'), pv=g('pv');
    if(pl===''||pv==='') return;
    const nn=function(v){ return v===''?null:parseInt(v,10); };
    out.push({
      numero_fifa:num,
      pred_local:parseInt(pl,10),
      pred_visitante:parseInt(pv,10),
      pred_amarillas:nn(g('j')),
      pred_rojas:nn(g('k')),
      pred_var:nn(g('l')),
      pred_penales_partido:nn(g('m')),
      pred_minuto_gol:nn(g('n')),
      pred_penales_local_tanda:nn(g('ol')),
      pred_penales_visitante_tanda:nn(g('ov')),
      pred_equipo_clasifica:nn(g('p'))
    });
  });
  return out;
}

function _mpGuardarClick(){
  const ap=_mpCollectApuestas();
  const rEl=document.getElementById('mpe-save-result');
  if(!ap.length){ if(rEl) rEl.innerHTML='<span style="color:#f59e0b">Cargá al menos el marcador (local–visitante) de un partido.</span>'; return; }
  _mpShowPinModal(ap.length);
}

function _mpClosePin(){ const o=document.getElementById('mpe-pin-ov'); if(o) o.remove(); }

function _mpShowPinModal(n){
  _mpClosePin();
  const html='<div id="mpe-pin-ov" style="position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:99999;display:flex;align-items:center;justify-content:center">'
    +'<div style="background:#0f172a;border:1px solid #334155;border-radius:14px;padding:22px;width:300px;max-width:90vw;text-align:center">'
    +'<div style="font-size:16px;font-weight:800;color:#e2e8f0;margin-bottom:6px">🔒 Confirmar apuestas</div>'
    +'<div style="font-size:12px;color:#94a3b8;margin-bottom:12px">Ingresá tu PIN (tu primer nombre) para guardar '+n+' partido(s).</div>'
    +'<input id="mpe-pin-inp" type="text" autocomplete="off" placeholder="PIN = tu primer nombre" style="width:100%;box-sizing:border-box;background:#0b1120;border:1px solid #334155;color:#e2e8f0;border-radius:8px;padding:10px;font-size:15px;text-align:center;margin-bottom:12px">'
    +'<div id="mpe-pin-msg" style="font-size:12px;min-height:16px;margin-bottom:8px"></div>'
    +'<div style="display:flex;gap:8px">'
    +'<button onclick="_mpClosePin()" style="flex:1;background:#334155;color:#e2e8f0;border:none;border-radius:8px;padding:10px;cursor:pointer">Cancelar</button>'
    +'<button id="mpe-pin-ok" onclick="_mpDoSave()" style="flex:1;background:#16a34a;color:#fff;border:none;border-radius:8px;padding:10px;font-weight:700;cursor:pointer">Guardar</button>'
    +'</div></div></div>';
  document.body.insertAdjacentHTML('beforeend', html);
  const inp=document.getElementById('mpe-pin-inp');
  if(inp){ inp.focus(); inp.addEventListener('keydown',function(e){ if(e.key==='Enter') _mpDoSave(); }); }
}

async function _mpDoSave(){
  const inp=document.getElementById('mpe-pin-inp');
  const msg=document.getElementById('mpe-pin-msg');
  const okb=document.getElementById('mpe-pin-ok');
  const pin=inp?inp.value.trim():'';
  if(!pin){ if(msg){ msg.style.color='#f59e0b'; msg.textContent='Ingresá tu PIN.'; } return; }
  const ap=_mpCollectApuestas();
  if(!ap.length){ if(msg){ msg.style.color='#f59e0b'; msg.textContent='No hay apuestas para guardar.'; } return; }
  if(okb){ okb.disabled=true; okb.textContent='Guardando…'; }
  try{
    const r=await api('/api/v1/bets/live-guardar-apuestas/'+_torneoId,{
      method:'POST', body:JSON.stringify({apostador_id:_viewAsId, pin:pin, apuestas:ap})
    });
    const d=await r.json();
    if(!d.ok && d.error){
      if(msg){ msg.style.color='#f87171'; msg.textContent=d.error; }
      if(okb){ okb.disabled=false; okb.textContent='Guardar'; }
      return;
    }
    _mpClosePin();
    const okN=(d.resultados||[]).filter(function(x){return x.ok;}).length;
    const errs=(d.resultados||[]).filter(function(x){return !x.ok;});
    await loadUserPredictions(_viewAsId);
    renderMiPronoEditor();
    let out='<div style="color:#22c55e;font-weight:700">✅ '+okN+' apuesta(s) guardada(s).</div>';
    if(errs.length) out+='<div style="color:#f59e0b;font-size:11px;margin-top:4px">'+errs.map(function(e){return 'P'+e.numero_fifa+': '+e.msg;}).join('<br>')+'</div>';
    const rEl=document.getElementById('mpe-save-result'); if(rEl) rEl.innerHTML=out;
    showToast('Guardado ✓ ('+okN+')');
  }catch(e){
    if(msg){ msg.style.color='#f87171'; msg.textContent='Error: '+(e&&e.message?e.message:e); }
    if(okb){ okb.disabled=false; okb.textContent='Guardar'; }
  }
}
// ===== FIN EDITOR DE APUESTAS =====

function renderMiProno(p){ return renderMiPronoEditor(); }

function _renderMiProno_OLD(p) {
  const el = document.getElementById('mp-content');
  if (!el) return;
  if (!p) {
    el.innerHTML='<div class="mp-empty" style="padding:24px;text-align:center;color:#6b7280">Sin partido activo</div>';
    return;
  }

  const cfg    = FASE_PTS[p.fase_tipo||'']||{h:6,i:12};
  const lName  = p.local_nombre||p.equipo_local||'?';
  const vName  = p.visita_nombre||p.equipo_visitante||'?';
  const gl     = p.goles_local??null;
  const gv     = p.goles_visitante??null;
  const done   = p.estado==='finalizado';
  const live   = p.estado==='en_juego';
  const started = done||live;
  const mult   = isPyMatch(lName,vName) ? 2 : 1;

  const meAp = (_liveData?.apostadores||[]).find(a=>a.apostador_id===_viewAsId);
  if (!meAp) {
    el.innerHTML='<div class="mp-empty" style="padding:24px;text-align:center;color:#6b7280">Seleccioná un apostador en Puntajes 📊</div>';
    return;
  }

  const pl=meAp.pred_local??null, pv=meAp.pred_visitante??null;
  const rAmar=p.amarillas??null, rRojas=p.rojas??null, rVar=p.decisiones_var??null;
  const rPP=p.penales_partido??null, rMinG=p.minuto_primer_gol??null;
  const rPenL=p.penales_tanda_local??null, rPenV=p.penales_tanda_visitante??null;

  const hitH  = started&&gl!==null&&gv!==null&&pl!==null&&pv!==null&&sign(gl-gv)===sign(pl-pv);
  const hitI  = started&&gl!==null&&gv!==null&&pl===gl&&pv===gv;
  const hitJ  = started&&rAmar!==null&&meAp.pred_amarillas!=null&&rAmar===meAp.pred_amarillas;
  const hitK  = started&&rRojas!==null&&meAp.pred_rojas!=null&&rRojas===meAp.pred_rojas;
  const hitL  = started&&rVar!==null&&meAp.pred_var!=null&&rVar===meAp.pred_var;
  const hitM  = started&&rPP!==null&&meAp.pred_penales_partido!=null&&rPP===meAp.pred_penales_partido;
  const hitN  = started&&rMinG!==null&&meAp.pred_minuto_gol!=null&&rMinG===meAp.pred_minuto_gol;
  const hitOl = started&&rPenL!==null&&meAp.pred_penales_local_tanda!=null&&rPenL===meAp.pred_penales_local_tanda;
  const hitOv = started&&rPenV!==null&&meAp.pred_penales_visitante_tanda!=null&&rPenV===meAp.pred_penales_visitante_tanda;

  const totalPts = ((hitH?cfg.h:0)+(hitI?cfg.i:0)+(hitJ?1:0)+(hitK?1:0)+(hitL?1:0)+(hitM?1:0)+(hitN?1:0)+(hitOl?2:0)+(hitOv?2:0))*mult;
  const maxPts   = (cfg.h+cfg.i+1+1+1+1+1+(rPenL!==null?2:0)+(rPenV!==null?2:0))*mult;

  const statusLbl = done ? 'Final' : (live ? `⏺ ${p.minuto_actual||'?'}'` : '⏰ Pendiente');

  // ── Render helper: una fila de ítem ──
  function mpRow(ico, lbl, realVal, predVal, hit, pend, pts) {
    const realStr = pend ? '—' : (realVal!=null ? String(realVal) : '—');
    const predStr = predVal!=null ? String(predVal) : '?';
    const cls   = pend ? '' : (hit ? 'mpr-hit' : 'mpr-miss');
    const badge = pend ? '<span class="mpr-badge mpr-pend">—</span>'
      : (hit ? `<span class="mpr-badge mpr-hit-b">+${pts}</span>`
             : `<span class="mpr-badge mpr-miss-b">✗</span>`);
    const predHtml = pend
      ? `<span class="mpr-pred mpr-pred-pend">${predStr}</span>`
      : (hit
          ? `<span class="mpr-pred mpr-pred-hit">✓ ${predStr}</span>`
          : `<span class="mpr-pred mpr-pred-miss"><s>${predStr}</s></span>`);
    return `<div class="mpr-row ${cls}">
      <div class="mpr-ico-lbl">
        <span class="mpr-ico">${ico}</span>
        <span class="mpr-lbl-key">${lbl}</span>
      </div>
      <div class="mpr-vals">
        <div class="mpr-real">${realStr}</div>
        <div class="mpr-vs">vs</div>
        ${predHtml}
      </div>
      <div class="mpr-pts">${badge}</div>
    </div>`;
  }

  // Ítems regulares H–N
  const regularRows = [
    mpRow('⚽','H — Resultado',
      started&&gl!==null ? resStr(gl,gv) : null,
      pl!==null ? resStr(pl,pv) : null,
      hitH, !started||gl===null, hitH?cfg.h*mult:0),
    mpRow('🎯','I — Marcador',
      started&&gl!==null ? `${gl}–${gv}` : null,
      pl!==null ? `${pl}–${pv}` : null,
      hitI, !started||gl===null, hitI?cfg.i*mult:0),
    mpRow('🟨','J — Amarillas', rAmar, meAp.pred_amarillas, hitJ, !started||rAmar===null, hitJ?mult:0),
    mpRow('🟥','K — Rojas',     rRojas,meAp.pred_rojas,     hitK, !started||rRojas===null,hitK?mult:0),
    mpRow('📺','L — VAR',       rVar,  meAp.pred_var,        hitL, !started||rVar===null,  hitL?mult:0),
    mpRow('🥅','M — Pen.juego', rPP,   meAp.pred_penales_partido, hitM, !started||rPP===null, hitM?mult:0),
    mpRow('⏱','N — Min. gol',
      rMinG!=null ? rMinG+"'" : null,
      meAp.pred_minuto_gol!=null ? meAp.pred_minuto_gol+"'" : null,
      hitN, !started||rMinG===null, hitN?mult:0),
  ].join('');

  // N – Winner: quién estuvo más cerca del minuto del gol
  let nWinnerHtml = '';
  if (started && rMinG !== null && meAp.pred_minuto_gol != null) {
    const myDiff = Math.abs(meAp.pred_minuto_gol - rMinG);
    if (_allBets) {
      const matchBets = (_allBets.partidos||[]).find(x => x.num === p.numero_fifa);
      if (matchBets) {
        const allPmg = Object.entries(matchBets.apuestas||{})
          .filter(([,b]) => b.pmg != null)
          .map(([aid,b]) => ({aid: +aid, pmg: b.pmg, diff: Math.abs(b.pmg - rMinG)}));
        if (allPmg.length > 0) {
          const minDiff = Math.min(...allPmg.map(x => x.diff));
          const wins = allPmg.filter(x => x.diff === minDiff);
          const aliasOf = aid => {
            const r = (_rankingData||[]).find(x => +x.apostador_id === +aid);
            return r ? (r.apostador || r.username || `#${aid}`) : `#${aid}`;
          };
          const names = wins.map(x => aliasOf(x.aid)).join(', ');
          const isW = myDiff === minDiff;
          const diffStr = minDiff===0 ? 'exacto' : `${minDiff} min off`;
          nWinnerHtml = `<div style="font-size:10px;padding:3px 14px 6px;color:#9ca3af;background:#060c18;border-bottom:1px solid #0f1225">⏱ Más cercano: <strong style="color:${isW?'#22c55e':'#60a5fa'}">${names}</strong> · pronosticó ${wins[0].pmg}' (${diffStr})${!isW?` · tú: ${myDiff} min off`:''}`;
        }
      }
    } else if (!_allBets) {
      // Cargar allBets en segundo plano y re-renderizar
      loadAllBets().then(() => renderMiProno(p));
      nWinnerHtml = `<div style="font-size:10px;padding:3px 14px 6px;color:#6b7280">⏱ Gol en min ${rMinG}' · tu pred: ${meAp.pred_minuto_gol}' · cargando ganador…</div>`;
    }
    if (!nWinnerHtml) {
      nWinnerHtml = `<div style="font-size:10px;padding:3px 14px 6px;color:#9ca3af">⏱ Gol en min ${rMinG}' · tu predicción: ${meAp.pred_minuto_gol}' (diff ${myDiff} min)</div>`;
    }
  }
  // Sección penales en tanda (Ol + Ov) — solo si hay tanda real o predicción
  const hasTanda = rPenL!==null || rPenV!==null
    || meAp.pred_penales_local_tanda!=null || meAp.pred_penales_visitante_tanda!=null;

  const tandaSection = hasTanda ? `
    <div class="mpr-section-lbl">⚽ Definición por penales</div>
    ${mpRow('⚡',`Ol — Tanda ${lName.split(' ')[0]}`, rPenL, meAp.pred_penales_local_tanda,  hitOl, rPenL===null, hitOl?2*mult:0)}
    ${mpRow('⚡',`Ov — Tanda ${vName.split(' ')[0]}`, rPenV, meAp.pred_penales_visitante_tanda, hitOv, rPenV===null, hitOv?2*mult:0)}
  ` : '';

  // P – Equipo clasifica
  const liveMatchP = (_bracket||[]).find(b => b.num === p.numero_fifa);
  const realEcIdP  = p.equipo_clasificado_id ?? null;
  const predEcIdP  = meAp.pred_equipo_clasifica ?? null;
  const locIdP     = liveMatchP?.local?.id    ?? null;
  const visIdP     = liveMatchP?.visitante?.id ?? null;
  const realEcNomP = realEcIdP ? (realEcIdP===locIdP ? lName.split(' ')[0] : (realEcIdP===visIdP ? vName.split(' ')[0] : '?')) : null;
  const predEcNomP = predEcIdP ? (predEcIdP===locIdP ? lName.split(' ')[0] : (predEcIdP===visIdP ? vName.split(' ')[0] : '?')) : null;
  const hitP  = done && realEcIdP !== null && predEcIdP !== null && realEcIdP === predEcIdP;
  const FASE_P_PTS = {grupo:1,ronda32:2,ronda16:4,cuartos:6,semis:8,tercer_puesto:10,tercero:10,final:12};
  const ptsP  = hitP ? (FASE_P_PTS[p.fase_tipo||'']||1)*mult : 0;
  const hasP  = realEcIdP !== null || predEcIdP !== null;
  const pSection = hasP ? mpRow('<b class="ib ib-ko">KO</b>','P — Clasifica KO', realEcNomP, predEcNomP, hitP, !done||realEcIdP===null, hitP?ptsP:0) : '';

  el.innerHTML = `
    <div class="mpr-header">
      <div class="mpr-match-info">
        <span style="color:#9ca3af;font-size:11px">${flagFor(lName)} ${lName} vs ${vName} ${flagFor(vName)}</span>
        <span class="mpr-status">${statusLbl}</span>
        ${mult>1?'<span style="color:#fbbf24;font-size:11px;font-weight:700">🇵🇾 ×2</span>':''}
      </div>
      <div class="mpr-total-badge">
        <span class="mpr-total-val" style="color:${totalPts>0?'#22c55e':'#6b7280'}">${totalPts>0?'+':''}${totalPts}</span>
        <span class="mpr-total-max">/ ~${maxPts} posibles</span>
      </div>
    </div>
    <div class="mpr-cols-hdr">
      <div></div>
      <div style="display:flex;justify-content:space-between;font-size:9px;color:#374151;text-transform:uppercase;letter-spacing:.5px;flex:1;margin:0 6px">
        <span>Real</span><span style="margin-right:16px">Tu apuesta</span>
      </div>
    </div>
    ${regularRows}
    ${nWinnerHtml}
    ${tandaSection}
    ${pSection}
    <div class="mpr-footer">
      <span>Total este partido</span>
      <span style="font-size:22px;font-weight:800;color:${totalPts>0?'#22c55e':'#6b7280'}">${totalPts>0?'+':''}${totalPts}</span>
    </div>`;
}

function renderPredictions(p) {
  const apos=_liveData?.apostadores||[];
  const tipo=p.fase_tipo||'';
  const cfg=FASE_PTS[tipo]||{h:4,i:8};
  const gl=p.goles_local??null, gv=p.goles_visitante??null;
  const bar=document.getElementById('pred-real-bar');
  bar.innerHTML=`
    <div class="pred-real-item"><div class="pred-real-lbl">Marcador</div><div class="pred-real-val">${gl??'?'}–${gv??'?'}</div></div>
    <div class="pred-real-item"><div class="pred-real-lbl">🟨 Amar.</div><div class="pred-real-val">${p.amarillas??'?'}</div></div>
    <div class="pred-real-item"><div class="pred-real-lbl">🟥 Rojas</div><div class="pred-real-val">${p.rojas??'?'}</div></div>
    <div class="pred-real-item"><div class="pred-real-lbl">📺 VAR</div><div class="pred-real-val">${p.decisiones_var??'?'}</div></div>`;
  const list=document.getElementById('pred-list');
  list.innerHTML='';
  if (!apos.length){list.innerHTML='<div class="empty-state">Sin predicciones</div>';return;}
  for (const a of apos) {
    const isMe=a.apostador_id===_viewAsId;
    const pgl=a.pred_local,pgv=a.pred_visitante;
    const hitH=gl!==null&&gv!==null&&pgl!==null&&sign(gl-gv)===sign(pgl-pgv);
    const hitI=gl!==null&&gv!==null&&pgl===gl&&pgv===gv;
    const hitJ=p.amarillas!==null&&a.pred_amarillas!==null&&p.amarillas===a.pred_amarillas;
    const hitK=p.rojas!==null&&a.pred_rojas!==null&&p.rojas===a.pred_rojas;
    const hitL=p.decisiones_var!==null&&a.pred_var!==null&&p.decisiones_var===a.pred_var;
    const hitM=p.penales_partido!==null&&a.pred_penales_partido!==null&&p.penales_partido===a.pred_penales_partido;
    const hitOl=p.penales_tanda_local!==null&&a.pred_penales_local_tanda!==null&&p.penales_tanda_local===a.pred_penales_local_tanda;
    const hitOv=p.penales_tanda_visitante!==null&&a.pred_penales_visitante_tanda!==null&&p.penales_tanda_visitante===a.pred_penales_visitante_tanda;
    const pts=(hitH?cfg.h:0)+(hitI?cfg.i:0)+(hitJ?1:0)+(hitK?1:0)+(hitL?1:0)+(hitM?1:0)+(hitOl?2:0)+(hitOv?2:0);
    const div=document.createElement('div');
    div.className='pred-row'+(isMe?' pred-me':'');
    div.innerHTML=`
      <div class="pred-row-head">
        <div class="pred-name">${a.username||a.apostador||a.nombre||'?'}${isMe?' <span style="font-size:11px;color:#60a5fa">tú</span>':''}</div>
        <div class="pred-total">+${pts} pts</div>
      </div>
      <div class="pred-items">
        ${pitem('H',pgl!=null&&pgv!=null?pgl+'-'+pgv:'?',hitH&&gl!==null,gl===null)}
        ${pitem('I',pgl!=null&&pgv!=null?pgl+'-'+pgv:'?',hitI&&gl!==null,gl===null)}
        ${pitem('J',a.pred_amarillas??'?',hitJ&&p.amarillas!==null,p.amarillas===null)}
        ${pitem('K',a.pred_rojas??'?',hitK&&p.rojas!==null,p.rojas===null)}
        ${pitem('L',a.pred_var??'?',hitL&&p.decisiones_var!==null,p.decisiones_var===null)}
        ${pitem('M',a.pred_penales_partido??'?',hitM&&p.penales_partido!==null,p.penales_partido===null)}
        ${pitem('N',a.pred_minuto_gol??'?',false,true)}
        ${pitem('O',a.pred_penales_local_tanda!=null?a.pred_penales_local_tanda+'-'+a.pred_penales_visitante_tanda:'?',(hitOl||hitOv)&&p.penales_local!==null,p.penales_local===null)}
      </div>`;
    list.appendChild(div);
  }
}

function pitem(lbl,val,hit,pend){
  const cls=hit?'hit':(pend?'pending':'miss');
  return `<div class="pred-item ${cls}"><div class="pred-item-lbl">${lbl}</div><div class="pred-item-val">${hit?'✓':''} ${val}</div></div>`;
}

function renderRanking() {
  const ranking=_liveData?.ranking_vista||[];
  const list=document.getElementById('rank-list');
  if (!list) return;  // element not present in this view
  list.innerHTML='';
  if (!ranking.length){list.innerHTML='<div class="empty-state">Sin datos de ranking</div>';return;}
  ranking.slice(0,15).forEach((r,i)=>{
    const isMe=r.apostador_id===_viewAsId;
    const div=document.createElement('div');
    div.className='rank-row'+(isMe?' rank-me':'');
    const delta = r.vs_prev ? (r.vs_prev > 0 ? '+'+r.vs_prev : r.vs_prev) : '';
    div.innerHTML=`
      <div class="rank-pos">${i+1}</div>
      <div class="rank-name">${r.apostador||r.username||'?'}${isMe?' <span style="font-size:10px;color:#60a5fa">tú</span>':''}<div class="rank-delta">${delta}</div></div>
      <div class="rank-total" style="color:${i===0?'#fbbf24':(i===1?'#888':(i===2?'#a07040':'#22c55e'))}">${(r.puntos_antes||0)+(r.grupos_p?.pts||0)}</div>`;
    list.appendChild(div);
  });
}

// ── UTILITIES ────────────────────────────────────────────────────

function sign(n){ return n>0?1:(n<0?-1:0); }

function isPyMatch(l,v){
  const py=['paraguay','Paraguay','PARAGUAY'];
  return py.some(p=>l?.includes(p)||v?.includes(p));
}

const ISO_MAP = {
  'Argentina':'AR','Australia':'AU','Belgium':'BE','Brazil':'BR','Cameroon':'CM',
  'Canada':'CA','Chile':'CL','China':'CN','Colombia':'CO','Costa Rica':'CR',
  'Croatia':'HR','Czech Republic':'CZ','Denmark':'DK','Ecuador':'EC','Egypt':'EG',
  'England':'GB-ENG','France':'FR','Germany':'DE','Ghana':'GH','Greece':'GR',
  'Honduras':'HN','Hungary':'HU','Iran':'IR','Italy':'IT','Japan':'JP',
  'Mexico':'MX','Morocco':'MA','Netherlands':'NL','New Zealand':'NZ','Nigeria':'NG',
  'Panama':'PA','Paraguay':'PY','Peru':'PE','Poland':'PL','Portugal':'PT',
  'Romania':'RO','Saudi Arabia':'SA','Senegal':'SN','Serbia':'RS','Slovakia':'SK',
  'South Korea':'KR','Spain':'ES','Sweden':'SE','Switzerland':'CH','Tunisia':'TN',
  'Turkey':'TR','Ukraine':'UA','United States':'US','Uruguay':'UY','Venezuela':'VE',
  'Wales':'GB-WLS','Scotland':'GB-SCT','Algeria':'DZ','Austria':'AT',
  'Bolivia':'BO','Bosnia and Herzegovina':'BA','Bosnia y Herzegovina':'BA',
  'Burkina Faso':'BF','Congo':'CG','Costa de Marfil':'CI','Ivory Coast':'CI',
  "Côte d'Ivoire":'CI','Congo DR':'CD','Democratic Republic of the Congo':'CD',
  'South Africa':'ZA','Norway':'NO','Noruega':'NO','Suecia':'SE',
  'Dinamarca':'DK','Polonia':'PL','Alemania':'DE','España':'ES','Francia':'FR',
  'Italia':'IT','Holanda':'NL','Países Bajos':'NL','Suiza':'CH','Bélgica':'BE',
  'Croacia':'HR','Turquía':'TR','Marruecos':'MA','Argelia':'DZ','Camerún':'CM',
  'Sudáfrica':'ZA','Egipto':'EG','Japón':'JP','Corea del Sur':'KR',
  'Nueva Zelanda':'NZ','México':'MX','Hungría':'HU','República Checa':'CZ',
  'Eslovaquia':'SK','Rumanía':'RO','Georgia':'GE','Albania':'AL',
  'Escocia':'GB-SCT','Cape Verde':'CV','Cape Verde Islands':'CV','Cabo Verde':'CV',
  'Bosnia Herzegovina':'BA','USA':'US','EEUU':'US','Kenya':'KE',
  'Indonesia':'ID','Qatar':'QA','UAE':'AE','Iraq':'IQ','Kuwait':'KW',
  'Cape Verde Islands':'CV','Burkina Faso':'BF','Inglaterra':'GB-ENG','INGLATERRA':'GB-ENG',
};

function flagEmoji(iso){
  if (!iso) return '🌍';
  if (iso.startsWith('GB-')) {
    const map={'GB-ENG':'🏴󠁧󠁢󠁥󠁮󠁧󠁿','GB-SCT':'🏴󠁧󠁢󠁳󠁣󠁴󠁿','GB-WLS':'🏴󠁧󠁢󠁷󠁬󠁳󠁿'};
    return map[iso]||'🇬🇧';
  }
  if (iso.length!==2) return '🌍';
  const A=0x1F1E6-65;
  return String.fromCodePoint(A+iso.charCodeAt(0))+String.fromCodePoint(A+iso.charCodeAt(1));
}

function flagFor(name){
  if (!name) return '🌍';
  const iso=ISO_MAP[name];
  if (iso) return flagEmoji(iso);
  const low=name.toLowerCase();
  for (const [k,v] of Object.entries(ISO_MAP)) {
    const kl=k.toLowerCase();
    if (low.includes(kl)||kl.includes(low)) return flagEmoji(v);
  }
  return '🌍';
}

function teamFlag(name, iso) {
  const byN = flagFor(name);
  return byN !== '🌍' ? byN : (iso ? flagEmoji(iso) : '🏳');
}
function showToast(msg) {
  const t=document.getElementById('toast');
  if(!t) return;
  t.textContent=msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer=setTimeout(()=>t.classList.remove('show'),2200);
}

// ── SCORES SUB-TABS ─────────────────────────────────────────────────────────
let _scoresSubTab = 'ranking';
let _scoresMode = 'fase';
let _goleadoresData = null;

function setScoresMode(mode) {
  _scoresMode = mode;
  ['fase','items'].forEach(function(m) {
    const btn = document.getElementById('scmb-' + m);
    if (btn) btn.classList.toggle('active', m === mode);
  });
  renderScoresMatrix();
}

function setScoresSubTab(name) {
  _scoresSubTab = name;
  ['ranking','goleadores'].forEach(n => {
    const btn = document.getElementById('sct-' + n);
    const pane = document.getElementById('scp-' + n);
    if (btn) btn.classList.toggle('active', n === name);
    if (pane) pane.style.display = n === name ? 'block' : 'none';
  });
  if (name === 'goleadores' && !_goleadoresData) loadGoleadores();
}

async function loadGoleadores(force) {
  if (_goleadoresData && !force) { renderGoleadores(); return; }
  const el = document.getElementById('gl-content');
  if (el) el.innerHTML = '<div class="sc-loading">Cargando goleadores...</div>';
  try {
    const r = await api('/api/v1/bets/goleadores/' + _torneoId);
    const d = await r.json();
    _goleadoresData = d;
    renderGoleadores();
  } catch(e) {
    if (el) el.innerHTML = '<div class="sc-loading" style="color:#f87171">Error: ' + e.message + '</div>';
  }
}

function renderGoleadores() {
  const el = document.getElementById('gl-content');
  const mp = document.getElementById('gl-my-pred');
  if (!el || !_goleadoresData) return;
  const d = _goleadoresData;

  // Si hay un apostador seleccionado (_viewAsId), buscar SU predicción en d.predicciones
  // d.predicciones = { "nombre_pred_lower": [{apostador_id, alias, pred}, ...] }
  let viewPred = '';
  let viewAlias = _viewAsName || '';
  if (_viewAsId) {
    for (const [key, entries] of Object.entries(d.predicciones || {})) {
      const match = entries.find(function(e){ return e.apostador_id === _viewAsId; });
      if (match) { viewPred = match.pred; viewAlias = match.alias || viewAlias; break; }
    }
  }
  // Fallback: my_pred del usuario logueado (cuando no hay apostador seleccionado)
  const myPred    = (viewPred || d.my_pred || '').trim();
  const myPredLow = myPred.toLowerCase();
  const ganador   = (d.resultado_goleador || '').trim().toLowerCase();
  const labelWho  = (_viewAsId && viewAlias) ? viewAlias : 'Tu';

  if (mp) {
    if (myPred) {
      const pts = d.resultado_goleador
        ? (myPredLow === ganador
            ? '<span style="color:#4ade80">+20 pts ✅</span>'
            : '<span style="color:#f87171">0 pts ❌</span>')
        : '<span style="color:#fbbf24">pendiente</span>';
      mp.innerHTML = '🎯 ' + labelWho + ': <strong style="color:#e2e8f0">' + myPred + '</strong> — ' + pts;
      mp.className = 'gl-my-pred';
    } else {
      mp.innerHTML = '🎯 ' + labelWho + ' no registró predicción para el Goleador (ítem C)';
      mp.className = 'gl-my-pred no-pred';
    }
  }
  if (!d.scorers || !d.scorers.length) {
    el.innerHTML = '<div class="sc-loading">' + (d.error || 'Sin datos de API-Football') + '</div>';
    return;
  }
  let html = '<div style="overflow-x:auto"><table class="gl-tbl"><thead>'
    + '<tr><th class="gl-th">#</th><th class="gl-th">Jugador</th>'
    + '<th class="gl-th">Equipo</th>'
    + '<th class="gl-th" title="Goles">⚽</th>'
    + '<th class="gl-th" style="min-width:120px">👥 Apostadores</th></tr></thead><tbody>';
  d.scorers.forEach(function(s, i) {
    var nameLow = (s.name || '').toLowerCase();
    var isMe = myPred && (myPredLow.includes(nameLow) || nameLow.includes(myPredLow)
      || myPredLow.split(' ').some(function(p){ return p.length > 3 && nameLow.includes(p); }));
    var isGanador = ganador && (ganador.includes(nameLow) || nameLow.includes(ganador));
    var rowCls = isGanador ? 'gl-tr-winner' : (isMe ? 'gl-tr-me' : '');
    var apList = s.apostadores_pred || [];
    var apCount = apList.length;
    var apChips = apList.map(function(a) {
      var isSel = (_viewAsId && a.apostador_id === _viewAsId);
      var cls = isSel ? 'gl-pred-badge me' : 'gl-pred-badge';
      return '<span class="' + cls + '">' + (a.alias || '?') + '</span>';
    }).join(' ');
    var apCell = apCount
      ? apChips + ' <small style="color:#4b5563">(' + apCount + ')</small>'
      : '<span style="color:#374151">&#8212;</span>';
    var foto = s.photo
      ? ('<img src="' + s.photo + '" class="gl-foto" onerror="this.style.display=\'none\'">')
      : '';
    var rankDisplay = isGanador ? '🏆' : (i + 1);
    html += '<tr class="' + rowCls + '">'
      + '<td class="gl-td gl-rank">' + rankDisplay + '</td>'
      + '<td class="gl-td gl-td-player">' + foto + s.name + '</td>'
      + '<td class="gl-td gl-team">' + (s.team || '') + '</td>'
      + '<td class="gl-td gl-goals">' + (s.goals || 0) + '</td>'
      + '<td class="gl-td" style="max-width:180px;line-height:1.8;text-align:left;padding-left:6px">' + apCell + '</td>'
      + '</tr>';
  });
  html += '</tbody></table></div>';
  html += '<div style="font-size:10px;color:#4b5563;padding:8px;margin-top:4px;display:flex;gap:12px;flex-wrap:wrap">'
    + '<span style="color:#fbbf24">🏆 Goleador oficial</span>'
    + '<span style="color:#4ade80">■ Prediccion del apostador seleccionado</span>'
    + '</div>';
  el.innerHTML = html;
}

function setTab(t) {
  _activeTab = t;
  ['bracket','live','miprono','scores','apuestas','globales'].forEach(n=>{
    const tab=document.getElementById('tab-'+n);
    const bn=document.getElementById('bn-'+n);
    if(tab) tab.classList.toggle('active',n===t);
    if(bn) bn.classList.toggle('active',n===t);
  });
  // Score header solo visible en tab En Vivo
  const hdr = document.getElementById('score-hdr');
  if (hdr) hdr.style.display = (t === 'live' && _liveData?.partido) ? 'block' : 'none';
  if (t==='miprono') renderMiProno(_liveData?.partido);
  if (t==='apuestas') renderApuestasTab();
  if (t==='scores') renderScoresTab();
  if (t==='globales') loadGlobalesTab();
  if (t==='live') { renderLiveContent(); renderLiveHeader(); }
}

// ── GLOBALES TAB ────────────────────────────────────────────────────────────
let _globalesData = null;

async function loadGlobalesTab(force) {
  if (_globalesData && !force) { renderGlobales(); return; }
  const el = document.getElementById('gb-content');
  if (el) el.innerHTML = '<div class="gb-loading">Cargando pronósticos globales…</div>';
  if (!_viewAsId) {
    if (el) el.innerHTML = '<div class="gb-loading" style="color:#6b7280">Seleccioná un apostador para ver sus globales.</div>';
    return;
  }
  try {
    const r = await api('/api/v1/bets/apuestas-globales/' + _torneoId + '?for_apostador_id=' + _viewAsId);
    _globalesData = await r.json();
    if (!_globalesData.ganadores) _globalesData.ganadores = {};
    renderGlobales();
  } catch(e) {
    if (el) el.innerHTML = '<div class="gb-loading" style="color:#f87171">Error: ' + e.message + '</div>';
  }
}

function renderGlobales() {
  const el = document.getElementById('gb-content');
  if (!el) return;
  if (!_globalesData) { loadGlobalesTab(); return; }

  const ag  = _globalesData.apuesta_global  || {};
  const pg  = _globalesData.puntaje_global  || {};
  const nom = _globalesData.nombres_equipos || {};
  const res = _globalesData.resultados      || {};
  const gan = _globalesData.ganadores       || {};

  // Helpers
  const teamName = (id) => {
    if (!id) return null;
    if (nom[id]) return nom[id];
    // Fallback: buscar en resultados
    if (id === res.campeon_id) return res.campeon_nombre;
    if (id === res.finalista1_id) return res.finalista1_nombre;
    if (id === res.finalista2_id) return res.finalista2_nombre;
    if (id === res.peor_equipo_id) return res.peor_equipo_nombre;
    return '?';
  };
  const ptVal = (key) => (pg[key] !== undefined && pg[key] !== null) ? pg[key] : null;
  const pBadge = (pt) => {
    if (pt === null) return '<span class="gb-pts-badge gb-pts-none">—</span>';
    if (pt  >  0)   return `<span class="gb-pts-badge gb-pts-pos">+${pt}</span>`;
    return               `<span class="gb-pts-badge gb-pts-zero">0</span>`;
  };
  const resVal = (v, awarded, pt) => {
    if (!v) return `<span class="gb-val-result gb-pending">a definir</span>`;
    if (awarded && pt > 0) return `<span class="gb-val-result gb-res-win">🏆 ${v}</span>`;
    return `<span class="gb-val-result gb-res-known">${v}</span>`;
  };
  const predVal = (v, awarded, pt) => {
    if (!v) return `<span class="gb-val-pred gb-pending">—</span>`;
    if (!awarded) return `<span class="gb-val-pred">${v}</span>`;
    if (pt > 0)  return `<span class="gb-val-pred gb-pred-hit">✓ ${v}</span>`;
    return             `<span class="gb-val-pred gb-pred-miss"><s>${v}</s></span>`;
  };

  const aliasName = _viewAsName || _myName || '?';

  // Goleada predicha
  const predGoleadaStr = (ag.pred_goleada_ganador != null && ag.pred_goleada_perdedor != null)
    ? `${ag.pred_goleada_ganador}–${ag.pred_goleada_perdedor}` : null;
  // Finalistas reales
  const resF1 = res.finalista1_nombre, resF2 = res.finalista2_nombre;
  const resFinalistasStr = (resF1 || resF2) ? [resF1, resF2].filter(Boolean).join(' + ') : null;
  // Finalistas predichos
  const predF1 = teamName(ag.pred_finalista1_id), predF2 = teamName(ag.pred_finalista2_id);
  const predFinalistasStr = (predF1 || predF2) ? [predF1, predF2].filter(Boolean).join(' + ') : null;
  // Etapa Paraguay (label legible)
  const ETAPA_LABEL = {'grupo':'Fase de grupos','ronda32':'Ronda de 32','ronda16':'Ronda de 16',
    'cuartos':'Cuartos de final','semis':'Semifinales','tercer_puesto':'3er puesto','final':'Final'};
  const predEtapaStr = ag.pred_etapa_paraguay ? (ETAPA_LABEL[ag.pred_etapa_paraguay] || ag.pred_etapa_paraguay) : null;

  const ITEMS = [
    { letter:'A', icon:'🏆', desc:'Campeón del mundo',
      resultado: res.campeon_nombre || null,
      prediccion: teamName(ag.pred_campeon_id),
      ptKey: 'pts_campeon', maxPts: 20 },
    { letter:'B', icon:'🥈', desc:'Finalistas (ambos)',
      resultado: resFinalistasStr,
      prediccion: predFinalistasStr,
      ptKey: 'pts_finalistas', maxPts: 20 },
    { letter:'C', icon:'⚽', desc:'Goleador del torneo',
      resultado: res.goleador || null,
      prediccion: ag.pred_goleador || null,
      ptKey: 'pts_goleador', maxPts: 20 },
    { letter:'D', icon:'😔', desc:'Peor equipo en grupos',
      resultado: res.peor_equipo_nombre || null,
      prediccion: teamName(ag.pred_peor_equipo_id),
      ptKey: 'pts_peor_equipo', maxPts: 20 },
    { letter:'E', icon:'💥', desc:'Mayor goleada (G–P)',
      resultado: res.goleada_str || null,
      prediccion: predGoleadaStr,
      ptKey: 'pts_mayor_goleada', maxPts: 20 },
    { letter:'F', icon:'🇵🇾', desc:'Etapa de Paraguay',
      resultado: res.etapa_paraguay || null,
      prediccion: predEtapaStr,
      ptKey: 'pts_etapa_paraguay', maxPts: 6 },
    { letter:'G', icon:'⚽', desc:'Goles de Paraguay (total)',
      resultado: res.goles_paraguay != null ? `${res.goles_paraguay} goles` : null,
      prediccion: ag.pred_goles_paraguay != null ? `${ag.pred_goles_paraguay} goles` : null,
      ptKey: 'pts_goles_paraguay', maxPts: 6 },
  ];

  let totalPts = 0;
  let anyNullPts = false;
  const itemsOtorgados = [];
  const itemsPendientes = [];

  const rows = ITEMS.map(item => {
    const pt = ptVal(item.ptKey);
    // "otorgado" solo si hay resultado conocido (no solo pts calculados en 0)
    const awarded = item.resultado !== null;
    if (!awarded) { anyNullPts = true; itemsPendientes.push(item.letter); }
    else { totalPts += pt; itemsOtorgados.push(item.letter); }
    // Ganadores del ítem
    const itemWinners = (gan[item.letter] || []);
    let winnersHtml = '';
    if (awarded && itemWinners.length > 0) {
      const chips = itemWinners.map(alias => {
        const isMe = alias === aliasName;
        return `<span class="gb-winner-chip${isMe?' gb-winner-me':''}">${alias}${isMe?' ★':''}</span>`;
      }).join('');
      winnersHtml = `<div class="gb-winners">${chips}</div>`;
    } else if (awarded && itemWinners.length === 0) {
      winnersHtml = `<div class="gb-no-winners">ningún apostador acertó</div>`;
    }
    const statusHtml = awarded
      ? `<span class="gb-status-ok">✅ otorgado</span>${winnersHtml}`
      : `<span class="gb-status-pend">⏳ pendiente</span>`;
    return `<tr>
      <td>
        <div class="gb-item-lbl">
          <span class="gb-item-ico">${item.icon}</span>
          <span class="gb-item-letter">${item.letter}</span>
        </div>
        <div class="gb-item-desc">${item.desc} <span style="color:#6b7280">(${item.maxPts} pts)</span></div>
      </td>
      <td>${resVal(item.resultado, awarded, pt)}</td>
      <td>${predVal(item.prediccion, awarded, pt)}</td>
      <td class="gb-pts-cell">${pBadge(pt)}<div style="margin-top:4px">${statusHtml}</div></td>
    </tr>`;
  }).join('');

  const totalBadge = anyNullPts
    ? `<span style="color:#fbbf24;font-size:16px">${totalPts}</span><span class="gb-max-pts">parcial · ítems ${itemsPendientes.join('/')} pendientes</span>`
    : `<span style="color:#fbbf24;font-size:16px">+${totalPts}</span><span class="gb-max-pts">todos los ítems otorgados ✅</span>`;

  // Nota al pie
  const notaOtorgados = itemsOtorgados.length
    ? `<b style="color:#34d399">✅ Ya otorgados: ${itemsOtorgados.join(', ')}</b>`
    : '';
  const notaPendientes = itemsPendientes.length
    ? `<span>⏳ Pendientes de otorgar al finalizar el torneo: <b>${itemsPendientes.join(', ')}</b></span>`
    : '';

  el.innerHTML = `
    <div style="font-size:11px;color:#6b7280;padding:4px 4px 8px;text-align:right">
      Apostador: <b style="color:#93c5fd">${aliasName}</b>
    </div>
    <table class="gb-table">
      <thead><tr>
        <th>Ítem</th>
        <th>Resultado oficial</th>
        <th>Tu apuesta</th>
        <th class="gb-col-pts">Pts / Estado</th>
      </tr></thead>
      <tbody>${rows}</tbody>
      <tfoot><tr class="gb-total-row">
        <td colspan="3" style="color:#d1d5db">Total globales</td>
        <td class="gb-total-pts">${totalBadge}</td>
      </tr></tfoot>
    </table>
    ${(notaOtorgados || notaPendientes) ? `<div class="gb-note-box">${notaOtorgados}${notaPendientes}</div>` : ''}
    <div style="font-size:10px;color:#374151;padding:6px 4px 4px;text-align:center">
      Máx: 20+20+20+20+20+6+6 = 112 pts
    </div>`;
}

function setSubTab(t) {
  _activeSubTab = t;
  // Sub-tabs removed from live tab — betting-style single scroll view
  if (t==='miprono') renderMiProno(_liveData?.partido);
}

init();
</script>
</body>
</html>